---
export interface Step {
  title: string
  description: string
}
export interface Card {
  icon: string
  title: string
  description: string
  extras?: { label: string }[]
}
export interface Props {
  eyebrow?: string
  title?: string
  subtitle?: string
  methodEyebrow?: string
  methodTitle?: string
  asideTitle?: string
  asideBody?: string
  asideRatio?: string
  asideRatioLabel?: string
  steps?: Step[]
  cards?: Card[]
}

const {
  eyebrow        = 'Why Choose Us',
  title          = 'Why Choose Our Cocoa Beach Surf School',
  subtitle       = 'At Cocoa Sol Surf School, we\'ve taught surf lessons in Cocoa Beach for more than 25 years — turning thousands of nervous first-timers into confident surfers. Here\'s what sets our school apart.',
  methodEyebrow  = 'Safety First',
  methodTitle    = 'Our Step-by-Step Method',
  asideTitle     = 'Why beginners feel safe here',
  asideBody      = 'Cocoa Beach\'s sandy bottom and consistent, beginner-friendly waves make it one of the safest places in Florida to learn. We keep groups small, so you\'re never left to figure it out alone.',
  asideRatio     = '3:1',
  asideRatioLabel = 'students to instructor — or fully private if you prefer',
  steps = [
    { title: 'Safety briefing on the sand',   description: 'Ocean awareness, how to fall safely, and what to expect from the day\'s conditions.' },
    { title: 'Paddling & positioning',         description: 'Getting comfortable on the board and learning to read incoming waves.' },
    { title: 'The pop-up',                     description: 'Practicing your stand-up on land first, then taking it into the water.' },
    { title: 'Your first ride',                description: 'Catching and riding a wave with your instructor right beside you.' },
  ],
  cards = [
    {
      icon: '🧭',
      title: 'Certified, Bilingual Local Instructors',
      description: 'Our instructors are certified, fluent in English and Spanish, and — most importantly — local. They read Cocoa Beach\'s conditions every single day and shape each session around the real ocean in front of you, not a one-size-fits-all script.',
    },
    {
      icon: '🛡️',
      title: 'Safety Built Into Everything',
      description: 'Every session starts with a beach safety briefing, and an instructor stays in the water with you the whole time. That local knowledge is the difference between a fun afternoon and actually learning to surf.',
    },
    {
      icon: '🎽',
      title: 'Premium Gear, Always Included',
      description: 'No rentals, no surprise fees. We match your board to your height, weight, and skill level — because the right equipment is half of learning fast.',
      extras: [
        { label: '✓ Premium board' },
        { label: '✓ Quality leash' },
        { label: '✓ UV rash guard' },
        { label: '✓ Surf wax' },
        { label: '✓ Reef-safe sunscreen' },
        { label: '✓ Safety briefing' },
      ],
    },
  ],
} = Astro.props
---

<section class="wcu-section">
  <div class="wcu-wrap">

    <!-- Header -->
    <div class="wcu-head">
      <span class="wcu-eyebrow">{eyebrow}</span>
      <h2 class="wcu-title">{title}</h2>
      <p class="wcu-subtitle">{subtitle}</p>
    </div>

    <!-- Method: steps + aside -->
    <div class="wcu-method">
      <div>
        <span class="wcu-eyebrow">{methodEyebrow}</span>
        <h2 class="wcu-method-title">{methodTitle}</h2>
        <ol class="wcu-steps">
          {steps.map(s => (
            <li>
              <strong>{s.title}</strong>
              <span>{s.description}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="wcu-aside">
        <h3>{asideTitle}</h3>
        <p>{asideBody}</p>
        <div class="wcu-ratio">
          <b>{asideRatio}</b>
          <span>{asideRatioLabel}</span>
        </div>
      </div>
    </div>

    <!-- Cards -->
    <div class="wcu-cards">
      {cards.map(c => (
        <div class="wcu-card">
          <div class="wcu-ico">{c.icon}</div>
          <h3>{c.title}</h3>
          <p>{c.description}</p>
          {c.extras && (
            <div class="wcu-gear">
              {c.extras.map(e => <div class="wcu-g">{e.label}</div>)}
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Variables ────────────────────────────────────────────────────── */
  .wcu-section {
    --deep:      #0A3A40;
    --teal:      #0E6E78;
    --aqua:      #16A5B5;
    --cream:     #FFFDF8;
    --sand-2:    #FCF8F0;
    --sun:       #F2A93B;
    --coral:     #FF6A4D;
    --line:      rgba(16,48,46,.12);
    --shadow-sm: 0 8px 22px -12px rgba(10,58,64,.28);
    --shadow:    0 18px 40px -18px rgba(10,58,64,.30);
    --radius:    18px;
    --maxw:      1180px;

    padding: 84px 0;
    background: var(--sand-2);
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    color: var(--deep);
    line-height: 1.65;
  }

  /* ── Layout ───────────────────────────────────────────────────────── */
  .wcu-wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }

  /* ── Eyebrow ──────────────────────────────────────────────────────── */
  .wcu-eyebrow {
    display: inline-block;
    font-family: 'Hanken Grotesk', sans-serif;
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: .74rem;
    font-weight: 700;
    color: var(--teal);
    margin-bottom: 14px;
  }

  /* ── Header ───────────────────────────────────────────────────────── */
  .wcu-head {
    max-width: 720px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .wcu-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.9rem, 4vw, 2.85rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -.01em;
    color: var(--deep);
    margin-bottom: 16px;
  }
  .wcu-subtitle {
    color: #3c5654;
    font-size: 1.08rem;
    margin: 0;
  }

  /* ── Method grid ──────────────────────────────────────────────────── */
  .wcu-method {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 54px;
    align-items: center;
    margin-bottom: 64px;
  }
  .wcu-method-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    font-weight: 600;
    line-height: 1.12;
    color: var(--deep);
    margin-bottom: 28px;
  }

  /* ── Steps ────────────────────────────────────────────────────────── */
  .wcu-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }
  .wcu-steps li {
    position: relative;
    padding: 0 0 28px 64px;
    counter-increment: step;
  }
  .wcu-steps li:last-child { padding-bottom: 0; }
  .wcu-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -2px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--sun), var(--coral));
    color: #fff;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.15rem;
    display: grid;
    place-items: center;
    box-shadow: 0 8px 16px -8px rgba(255,106,77,.6);
  }
  .wcu-steps li::after {
    content: '';
    position: absolute;
    left: 20px;
    top: 44px;
    bottom: 6px;
    width: 2px;
    background: var(--line);
  }
  .wcu-steps li:last-child::after { display: none; }
  .wcu-steps strong {
    display: block;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.08rem;
    color: var(--deep);
    margin-bottom: 4px;
  }
  .wcu-steps span { color: #3c5654; font-size: .96rem; }

  /* ── Aside ────────────────────────────────────────────────────────── */
  .wcu-aside {
    background: linear-gradient(160deg, var(--teal), var(--deep));
    color: #fff;
    border-radius: var(--radius);
    padding: 40px 36px;
    box-shadow: var(--shadow);
  }
  .wcu-aside h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
    color: #fff;
    margin-bottom: 14px;
  }
  .wcu-aside p { color: rgba(255,255,255,.9); font-size: 1rem; margin: 0; }
  .wcu-ratio {
    margin-top: 22px;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    background: rgba(255,255,255,.12);
    padding: 14px 22px;
    border-radius: 14px;
  }
  .wcu-ratio b {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2rem;
    color: #FFD79A;
    font-weight: 600;
  }
  .wcu-ratio span { color: rgba(255,255,255,.85); font-size: .95rem; }

  /* ── Cards ────────────────────────────────────────────────────────── */
  .wcu-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .wcu-card {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .wcu-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .wcu-ico {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    margin-bottom: 18px;
    background: linear-gradient(140deg, var(--aqua), var(--teal));
  }
  .wcu-card h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.22rem;
    line-height: 1.2;
    color: var(--deep);
    margin-bottom: 10px;
  }
  .wcu-card p { color: #3c5654; font-size: .97rem; margin: 0; }

  /* ── Gear extras ──────────────────────────────────────────────────── */
  .wcu-gear {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 18px;
  }
  .wcu-g {
    background: var(--sand-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 10px;
    font-weight: 600;
    font-size: .88rem;
    color: var(--deep);
    text-align: center;
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .wcu-method { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 820px) {
    .wcu-section { padding: 60px 0; }
    .wcu-cards { grid-template-columns: 1fr; }
    .wcu-gear { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .wcu-aside { padding: 30px 24px; }
  }
</style>
