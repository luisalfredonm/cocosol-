---
import { Icon } from 'astro-icon/components'
export interface Step {
  title: string
  description: string
}
export interface Card {
  icon: string
  title: string
  description: string
  extras?: { label: string }[]
}

// Phosphor names, resolved to inline SVG at build time. These used to be
// three hand-drawn SVG strings injected with set:html, each at a slightly
// different stroke weight.
const iconMap: Record<string, string> = {
  compass: 'ph:compass',
  shield:  'ph:shield-check',
  package: 'ph:package',
}
export interface Props {
  eyebrow?: string
  title?: string
  subtitle?: string
  methodTitle?: string
  asideTitle?: string
  asideBody?: string
  asideRatio?: string
  asideRatioLabel?: string
  steps?: Step[]
  cards?: Card[]
}

const {
  eyebrow        = 'Why Choose Us',
  title          = 'Why Choose Our Cocoa Beach Surf School',
  subtitle       = 'At Cocosol Surf Lessons, we\'ve taught surf lessons in Cocoa Beach for more than 25 years, turning thousands of nervous first-timers into confident surfers. Here\'s what sets our school apart.',
  methodTitle    = 'Our Step-by-Step Method',
  asideTitle     = 'Why beginners feel safe here',
  asideBody      = 'Cocoa Beach\'s sandy bottom and consistent, beginner-friendly waves make it one of the safest places in Florida to learn. We keep groups small, so you\'re never left to figure it out alone.',
  asideRatio     = '3:1',
  asideRatioLabel = 'students to instructor, or fully private if you prefer',
  steps = [
    { title: 'Safety briefing on the sand',   description: 'Ocean awareness, how to fall safely, and what to expect from the day\'s conditions.' },
    { title: 'Paddling & positioning',         description: 'Getting comfortable on the board and learning to read incoming waves.' },
    { title: 'The pop-up',                     description: 'Practicing your stand-up on land first, then taking it into the water.' },
    { title: 'Your first ride',                description: 'Catching and riding a wave with your instructor right beside you.' },
  ],
  cards = [
    {
      icon: 'compass',
      title: 'Certified, Bilingual Local Instructors',
      description: 'Our instructors are certified, fluent in English and Spanish, and, most importantly, local. They read Cocoa Beach\'s conditions every single day and shape each session around the real ocean in front of you, not a one-size-fits-all script.',
    },
    {
      icon: 'shield',
      title: 'Safety Built Into Everything',
      description: 'Every session starts with a beach safety briefing, and an instructor stays in the water with you the whole time. That local knowledge is the difference between a fun afternoon and actually learning to surf.',
    },
    {
      icon: 'package',
      title: 'Premium Gear, Always Included',
      description: 'No rentals, no surprise fees. We match your board to your height, weight, and skill level, because the right equipment is half of learning fast.',
      extras: [
        { label: '✓ Premium board' },
        { label: '✓ Quality leash' },
        { label: '✓ UV rash guard' },
        { label: '✓ Surf wax' },
        { label: '✓ Reef-safe sunscreen' },
        { label: '✓ Safety briefing' },
      ],
    },
  ],
} = Astro.props
---

<section class="wcu-section">
  <div class="wcu-wrap">

    <!-- Header -->
    <div class="wcu-head">
      <span class="wcu-eyebrow">{eyebrow}</span>
      <h2 class="wcu-title">{title}</h2>
      <p class="wcu-subtitle">{subtitle}</p>
    </div>

    <!-- Method: steps + aside -->
    <div class="wcu-method">
      <div>
        <!-- No eyebrow here on purpose. The section already carries one above;
             a label over every heading is what produces the templated rhythm. -->
        <h2 class="wcu-method-title">{methodTitle}</h2>
        <ol class="wcu-steps">
          {steps.map(s => (
            <li>
              <strong>{s.title}</strong>
              <span>{s.description}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="wcu-aside">
        <h3>{asideTitle}</h3>
        <p>{asideBody}</p>
        <div class="wcu-ratio">
          <b>{asideRatio}</b>
          <span>{asideRatioLabel}</span>
        </div>
      </div>
    </div>

    <!-- Cards -->
    <div class="wcu-cards">
      {cards.map(c => (
        <div class={`wcu-card${c.extras ? ' wcu-card--wide' : ''}`}>
          <div class="wcu-ico"><Icon name={iconMap[c.icon] ?? c.icon} class="wcu-ico-svg" aria-hidden="true"/></div>
          <h3>{c.title}</h3>
          <p>{c.description}</p>
          {c.extras && (
            <div class="wcu-gear">
              {c.extras.map(e => <div class="wcu-g">{e.label}</div>)}
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Variables ────────────────────────────────────────────────────── */
  .wcu-section {
    --deep:      var(--c-ink);
    --brand:     var(--teal-primary);
    --brand-dark:var(--teal-dark);
    --brand-text:var(--teal-text);
    --brand-strong:var(--teal-text-strong);   /* teal text on tinted bg — AA 7:1 */
    --aqua:      #26C6DA;
    --cream:     var(--c-cream-cool);
    --sand-2:    var(--c-paper-cool);
    --sun:       var(--c-gold);
    --coral:     var(--c-sunrise);
    --line:      rgba(0,188,212,.12);
    --shadow-sm: 0 8px 22px -12px rgba(0,188,212,.15);
    --shadow:    0 18px 40px -18px rgba(0,188,212,.20);
    --radius:    18px;
    --maxw:      1180px;

    padding: 84px 0;
    background: var(--sand-2);
    font-family: var(--font-body);
    color: var(--deep);
    line-height: 1.65;
  }

  /* ── Layout ───────────────────────────────────────────────────────── */
  .wcu-wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }

  /* ── Eyebrow ──────────────────────────────────────────────────────── */
  .wcu-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: .18em;
    font-size: .74rem;
    font-weight: 700;
    color: var(--brand-strong);
    margin-bottom: 14px;
  }

  /* ── Header ───────────────────────────────────────────────────────── */
  .wcu-head {
    max-width: 720px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .wcu-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.85rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -.01em;
    color: var(--deep);
    margin-bottom: 16px;
  }
  .wcu-subtitle {
    color: var(--c-muted-soft);
    font-size: 1.08rem;
    margin: 0;
  }

  /* ── Method grid ──────────────────────────────────────────────────── */
  .wcu-method {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 54px;
    align-items: center;
    margin-bottom: 64px;
  }
  .wcu-method-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    font-weight: 600;
    line-height: 1.12;
    color: var(--deep);
    margin-bottom: 28px;
  }

  /* ── Steps ────────────────────────────────────────────────────────── */
  .wcu-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: step;
  }
  .wcu-steps li {
    position: relative;
    padding: 0 0 28px 64px;
    counter-increment: step;
  }
  .wcu-steps li:last-child { padding-bottom: 0; }
  .wcu-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -2px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--brand), var(--brand-dark));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    display: grid;
    place-items: center;
    box-shadow: 0 8px 16px -8px rgba(0,188,212,.50);
  }
  .wcu-steps li::after {
    content: '';
    position: absolute;
    left: 20px;
    top: 44px;
    bottom: 6px;
    width: 2px;
    background: var(--line);
  }
  .wcu-steps li:last-child::after { display: none; }
  .wcu-steps strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    color: var(--deep);
    margin-bottom: 4px;
  }
  .wcu-steps span { color: var(--c-muted-soft); font-size: .96rem; }

  /* ── Aside ────────────────────────────────────────────────────────── */
  .wcu-aside {
    background: linear-gradient(160deg, var(--brand-dark), var(--deep));
    color: #fff;
    border-radius: var(--radius);
    padding: 40px 36px;
    box-shadow: var(--shadow);
  }
  .wcu-aside h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.2;
    color: #fff;
    margin-bottom: 14px;
  }
  .wcu-aside p { color: rgba(255,255,255,.9); font-size: 1rem; margin: 0; }
  .wcu-ratio {
    margin-top: 22px;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    background: rgba(255,255,255,.12);
    padding: 14px 22px;
    border-radius: var(--r-md);
  }
  .wcu-ratio b {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--c-price-on-dark);
    font-weight: 600;
  }
  .wcu-ratio span { color: rgba(255,255,255,.85); font-size: .95rem; }

  /* ── Cards ────────────────────────────────────────────────────────── */
  /* Two cells on the top row, the gear card spanning the full width below.
     Three items, three cells, no empty tile. Previously this was a third
     consecutive 3-column equal grid on the same page. */
  .wcu-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .wcu-card--wide { grid-column: 1 / -1; }
  .wcu-card {
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .wcu-card:hover { transform: translateY(-6px); box-shadow: var(--shadow); }
  .wcu-ico :global(.wcu-ico-svg) { width: 26px; height: 26px; }
  .wcu-ico {
    width: 52px;
    height: 52px;
    border-radius: var(--r-md);
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    background: linear-gradient(140deg, var(--brand), var(--brand-dark));
    color: #fff;
  }
  .wcu-card h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.22rem;
    line-height: 1.2;
    color: var(--deep);
    margin-bottom: 10px;
  }
  .wcu-card p { color: var(--c-muted-soft); font-size: .97rem; margin: 0; }

  /* ── Gear extras ──────────────────────────────────────────────────── */
  .wcu-gear {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 18px;
  }
  .wcu-g {
    background: var(--sand-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 12px 10px;
    font-weight: 600;
    font-size: .88rem;
    color: var(--deep);
    text-align: center;
  }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .wcu-method { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 820px) {
    .wcu-section { padding: 60px 0; }
    .wcu-cards { grid-template-columns: 1fr; }
    .wcu-gear { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .wcu-aside { padding: 30px 24px; }
  }
</style>
