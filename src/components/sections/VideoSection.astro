---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Props {
  title: string
  subtitle?: string
  bullets?: string[]
  videoId?: string
  bgImage?: ImageMetadata | string
  cta?: { label: string; href: string }
}
const { title, subtitle, bullets, videoId, bgImage = '/images/video-bg.jpg', cta } = Astro.props
const isLocalBg = typeof bgImage !== 'string'
---
<section class="relative overflow-hidden" style="height:637px">
  <div class="absolute inset-0 flex items-center justify-center">
    {isLocalBg ? (
      <Image src={bgImage as ImageMetadata} alt="Surf experience Tamarindo" class="w-full h-full object-cover object-[center_25%]" widths={[640, 1280, 1920]} formats={['avif', 'webp']} loading="lazy" decoding="async" sizes="100vw"/>
    ) : (
      <img src={bgImage as string} alt="Surf experience Tamarindo" class="w-full h-full object-cover object-[center_25%]" width="1920" height="700" loading="lazy" decoding="async"/>
    )}
    <div class="absolute inset-0 bg-black/60"></div>
  </div>
  <div class="relative z-10 container mx-auto px-4 h-full flex items-center">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="section-label text-teal-300 mb-2 block">Experience</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h2>
        {subtitle && <p class="text-white/80 leading-relaxed mb-4">{subtitle}</p>}
        {bullets && (
          <ul class="space-y-2 mb-6">
            {bullets.map(b => (
              <li class="flex items-center gap-2 text-white/90 text-sm">
                <svg class="w-4 h-4 text-teal-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {b}
              </li>
            ))}
          </ul>
        )}
        {cta && <a href={cta.href} class="btn-primary">{cta.label}</a>}
      </div>
      {videoId && (
        <div class="flex items-center justify-center">
          <a href={`https://www.youtube.com/watch?v=${videoId}`} target="_blank" rel="noopener" aria-label="Play surf video"
            class="w-20 h-20 bg-white/20 hover:bg-white/30 border-2 border-white rounded-full flex items-center justify-center transition-colors group">
            <svg class="w-8 h-8 text-white ml-1 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
