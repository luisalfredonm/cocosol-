---
export interface Testimonial {
  name: string
  role?: string
  country?: string
  text: string
  avatar?: string
}
export interface Props {
  title?: string
  // Cada página pasa su propio intro: el texto compartido salía idéntico en las
  // 8 páginas de servicio y era el bloque duplicado más grande del sitio.
  intro?: string
  items: Testimonial[]
  bg?: 'white' | 'gray'
}
const {
  title = 'What Our Surfers Say',
  intro = 'Many of our students say their first lesson in Cocoa Beach was the highlight of their trip. Some even return for more lessons or continue surfing long after they go home.',
  items,
  bg = 'white',
} = Astro.props
---
<section class={`py-20 defer-section ${bg === 'gray' ? 'bg-gray-50' : 'bg-white'}`}>
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="md:col-span-1 flex flex-col justify-center">
        <span class="section-label mb-2">Testimonials</span>
        <h2 class="text-3xl font-bold text-gray-900">{title}</h2>
        <p class="text-gray-600 mt-3 text-sm">{intro}</p>
        <a href="/book-now" class="mt-6 btn-outline self-start">All Reviews</a>
      </div>
      <div class="md:col-span-2 grid sm:grid-cols-2 gap-4">
        {items.map(t => (
          <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-full bg-teal-100 flex items-center justify-center text-teal-700 font-bold text-sm shrink-0 overflow-hidden">
                {t.avatar
                  ? <img src={t.avatar} alt={t.name} class="w-full h-full object-cover" width="40" height="40" loading="lazy"/>
                  : t.name.charAt(0)
                }
              </div>
              <div>
                <p class="font-semibold text-gray-900 text-sm">{t.name}</p>
                {(t.role || t.country) && <p class="text-gray-500 text-xs">{[t.role, t.country].filter(Boolean).join(' · ')}</p>}
              </div>
              <svg class="w-5 h-5 text-teal-500 ml-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
