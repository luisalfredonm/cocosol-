---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface MetaItem { icon: string; text: string }
export interface Props {
  bgImage:       ImageMetadata
  bgImageAlt:    string
  title:         string
  subtitle?:     string
  primaryCta:    { label: string; href: string }
  secondaryCta?: { label: string; href: string }
  meta?:         MetaItem[]
}
const { bgImage, bgImageAlt, title, subtitle, primaryCta, secondaryCta, meta } = Astro.props
---

<section class="fc-section">
  <div class="fc-bg" aria-hidden="true">
    <Image
      src={bgImage}
      alt={bgImageAlt}
      class="fc-bg-img"
      widths={[800, 1280, 1920]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="fc-wrap">
    <h2 class="fc-title">{title}</h2>
    {subtitle && <p class="fc-subtitle">{subtitle}</p>}

    <div class="fc-actions">
      <a href={primaryCta.href} class="fc-btn fc-btn--primary">{primaryCta.label}</a>
      {secondaryCta && (
        <a href={secondaryCta.href} class="fc-btn fc-btn--ghost">{secondaryCta.label}</a>
      )}
    </div>

    {meta && meta.length > 0 && (
      <div class="fc-meta">
        {meta.map(m => (
          <span class="fc-meta-item">
            <span aria-hidden="true">{m.icon}</span>
            {m.text}
          </span>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .fc-section {
    position: relative;
    padding: 100px 0;
    text-align: center;
    color: #fff;
    overflow: hidden;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }

  /* Background image + overlay */
  .fc-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .fc-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fc-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6,52,61,.82) 0%, rgba(6,52,61,.92) 100%);
  }

  .fc-wrap {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .fc-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .fc-subtitle {
    font-size: 1.12rem;
    opacity: .92;
    max-width: 580px;
    margin: 0 auto 32px;
    line-height: 1.65;
  }

  .fc-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .fc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 30px;
    border-radius: 50px;
    font-size: .95rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform .15s ease-out, box-shadow .2s ease, background .18s;
    white-space: nowrap;
  }
  .fc-btn:hover { transform: translateY(-2px); }

  .fc-btn--primary {
    background: var(--c-gold-soft);
    color: #3a2400;
    box-shadow: 0 8px 28px -6px rgba(255,208,121,.55);
  }
  .fc-btn--primary:hover {
    background: #f5c84a;
    box-shadow: 0 12px 32px -6px rgba(255,208,121,.65);
  }

  .fc-btn--ghost {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255,255,255,.55);
  }
  .fc-btn--ghost:hover {
    background: rgba(255,255,255,.12);
    border-color: #fff;
  }

  .fc-btn:focus-visible { outline: 3px solid var(--c-gold-soft); outline-offset: 3px; }

  .fc-meta {
    display: flex;
    gap: 26px;
    justify-content: center;
    flex-wrap: wrap;
    font-size: .95rem;
    font-weight: 600;
    opacity: .88;
  }
  .fc-meta-item { display: flex; align-items: center; gap: 6px; }

  @media (max-width: 600px) {
    .fc-section { padding: 72px 0; }
    .fc-wrap { padding: 0 20px; }
    .fc-meta { flex-direction: column; gap: 12px; align-items: center; }
  }
</style>
