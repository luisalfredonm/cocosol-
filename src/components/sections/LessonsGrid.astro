---
import { Image } from 'astro:assets'
import privateImg  from '../../assets/images/surf-school-tamarindo-private-class.webp'
import groupImg    from '../../assets/images/group-surf-lessons-tamarindo-students-beach.webp'
import coachingImg from '../../assets/images/one-on-one-surf-lessons-tamarindo-coaching.webp'

export interface Props {
  bookHref?: string
}
const { bookHref = '/book-now' } = Astro.props

const lessons = [
  {
    img: privateImg,
    imgAlt: 'Private surf lesson Cocoa Beach — one instructor, one student',
    badge: 'Fastest Progression',
    title: 'Private Surf Lessons',
    description: 'One instructor, one focus: you. The fastest progression and the most personalized feedback — ideal for individuals, couples, and families. If you\'ve only got a few days in town and want to leave actually knowing how to surf, this is the one.',
    price: 'From $75 / person',
    priceNote: null,
    cta: { label: 'Book a private lesson', href: bookHref },
  },
  {
    img: groupImg,
    imgAlt: 'Group surf lessons Cocoa Beach — fun social sessions',
    badge: 'Fun & Social',
    title: 'Group Surf Lessons',
    description: 'The fun, social way in. You learn alongside others while still getting hands-on attention thanks to our small-group ratio. The easygoing, more affordable entry point — perfect for groups of friends and solo travelers wanting to meet people.',
    price: '$65 / person',
    priceNote: 'min. 4',
    cta: { label: 'Book a group lesson', href: bookHref },
  },
  {
    img: coachingImg,
    imgAlt: 'Surf coaching Cocoa Beach — intermediate and advanced surfers',
    badge: 'Intermediate & Advanced',
    title: 'Surf Coaching',
    description: 'Already up and riding? Coaching sharpens technique, style, positioning, timing, and wave selection. We focus on real performance in real conditions and build the session around where you want to go next.',
    price: 'From $95 / person',
    priceNote: null,
    cta: { label: 'Book a coaching session', href: bookHref },
  },
]
---

<section class="lg-section">
  <div class="lg-wrap">

    <!-- Header -->
    <div class="lg-header">
      <span class="lg-eyebrow">Our Lessons</span>
      <h2 class="lg-title">
        Our Surf Lessons in<br/>
        <em>Cocoa Beach</em>
      </h2>
      <p class="lg-subtitle">
        Three ways to learn, built around your goals and how you like to learn.
        All include full gear and the same step-by-step method.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="lg-grid">
      {lessons.map(l => (
        <article class="lg-card">

          <!-- Image -->
          <div class="lg-img-wrap">
            <Image
              src={l.img}
              alt={l.imgAlt}
              class="lg-img"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Content -->
          <div class="lg-body">
            <span class="lg-badge">{l.badge}</span>
            <h3 class="lg-card-title">{l.title}</h3>
            <p class="lg-desc">{l.description}</p>

            <!-- Price + CTA -->
            <div class="lg-footer">
              <div class="lg-price-row">
                <span class="lg-price">{l.price}</span>
                {l.priceNote && <span class="lg-note">· {l.priceNote}</span>}
              </div>
              <a href={l.cta.href} class="lg-cta">
                {l.cta.label}
                <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
                  <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Variables ────────────────────────────────────────────────────── */
  .lg-section {
    --deep:   #0A3A40;
    --teal:   #0E6E78;
    --coral:  #FF6A4D;
    --gray:   #6B7E7C;
    --line:   rgba(16,48,46,.10);
    --maxw:   1180px;

    padding: 84px 0 96px;
    background: #fff;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }

  /* ── Layout ───────────────────────────────────────────────────────── */
  .lg-wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 28px; }

  /* ── Header ───────────────────────────────────────────────────────── */
  .lg-header { max-width: 620px; margin-bottom: 52px; }

  .lg-eyebrow {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .2em;
    color: var(--coral);
    margin-bottom: 16px;
  }

  .lg-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.08;
    color: var(--deep);
    margin-bottom: 20px;
  }
  .lg-title em {
    font-style: italic;
    color: var(--teal);
  }

  .lg-subtitle {
    font-size: 1.05rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Grid ─────────────────────────────────────────────────────────── */
  .lg-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  /* ── Card ─────────────────────────────────────────────────────────── */
  .lg-card { display: flex; flex-direction: column; }

  /* Image */
  .lg-img-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 24px;
  }
  .lg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }
  .lg-card:hover .lg-img { transform: scale(1.04); }

  /* Body */
  .lg-body { display: flex; flex-direction: column; flex: 1; }

  .lg-badge {
    display: inline-block;
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--coral);
    margin-bottom: 10px;
  }

  .lg-card-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.65rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--teal);
    margin-bottom: 14px;
  }

  .lg-desc {
    font-size: .97rem;
    color: var(--gray);
    line-height: 1.7;
    margin: 0 0 auto;
    padding-bottom: 24px;
  }

  /* Footer: price + CTA */
  .lg-footer {
    border-top: 1px solid var(--line);
    padding-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .lg-price-row { display: flex; align-items: baseline; gap: 6px; }

  .lg-price {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--deep);
  }
  .lg-note {
    font-size: .85rem;
    color: var(--gray);
    font-weight: 500;
  }

  .lg-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .88rem;
    font-weight: 700;
    color: var(--teal);
    text-decoration: none;
    transition: gap .2s ease, color .2s ease;
    white-space: nowrap;
  }
  .lg-cta:hover { gap: 10px; color: var(--coral); }

  /* ── Responsive ───────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .lg-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
  }
  @media (max-width: 600px) {
    .lg-section { padding: 60px 0 72px; }
    .lg-grid { grid-template-columns: 1fr; }
    .lg-img-wrap { aspect-ratio: 16 / 9; }
  }
</style>
