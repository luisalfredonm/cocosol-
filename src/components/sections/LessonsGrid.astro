---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import privateImg  from '../../assets/images/surf-school-cocoa-beach-private-lesson.webp'
import groupImg    from '../../assets/images/group-surf-lessons-cocoa-beach-students-beach.webp'
import coachingImg from '../../assets/images/one-on-one-surf-lessons-cocoa-beach-coaching.webp'

export interface Props {
  bookHref?: string
}
const { bookHref = '/book-now' } = Astro.props

/* Three products, three cells, deliberately unequal. Private is the entry
   point most first-time visitors take, so it gets the large cell; the other
   two run as compact horizontal cards beside it. The previous version was a
   3-column equal grid sitting immediately before two more 3-column equal
   grids, which flattened the whole middle of the page into one texture. */
const lessons = [
  {
    img: privateImg,
    imgAlt: 'Private surf lesson Cocoa Beach, one instructor with one student',
    badge: 'Fastest progression',
    title: 'Private Surf Lessons',
    description: 'One instructor, one focus: you. The fastest progression and the most personalized feedback, ideal for individuals, couples, and families.',
    price: 'From $75',
    priceUnit: '/ person',
    priceNote: null,
    detailHref: '/private-surf-lessons-cocoa-beach',
    detailLabel: 'Private surf lessons',
    feature: true,
  },
  {
    img: groupImg,
    imgAlt: 'Group surf lessons Cocoa Beach, fun social sessions',
    badge: 'Fun and social',
    title: 'Group Surf Lessons',
    description: 'The fun, social way in. Learn alongside others with hands-on attention, thanks to our small-group ratio.',
    price: '$60',
    priceUnit: '/ person',
    priceNote: 'min. 4 people',
    detailHref: '/group-surf-lessons-cocoa-beach',
    detailLabel: 'Group surf lessons',
    feature: false,
  },
  {
    img: coachingImg,
    imgAlt: 'Surf coaching Cocoa Beach for intermediate and advanced surfers',
    badge: 'Intermediate and advanced',
    title: 'Surf Coaching',
    description: 'Already riding? Coaching sharpens technique, positioning, and wave selection with real feedback in real conditions.',
    price: 'From $75',
    priceUnit: '/ person',
    priceNote: null,
    detailHref: '/surf-coaching-cocoa-beach',
    detailLabel: 'Surf coaching',
    feature: false,
  },
]

const featured = lessons.find(l => l.feature)!
const compact  = lessons.filter(l => !l.feature)
---

<section class="lg-section">
  <div class="lg-wrap">

    <!-- Header -->
    <div class="lg-header">
      <span class="lg-eyebrow">Our Lessons</span>
      <h2 class="lg-title">Surfing Lessons in <em>Cocoa Beach</em></h2>
      <p class="lg-subtitle">
        Three ways to learn, built around your goals.
        All include full gear and the same step-by-step method.
      </p>
    </div>

    <!-- Asymmetric grid: one tall feature cell + two compact cells -->
    <div class="lg-grid">

      <article class="lg-card lg-card--feature">
        <div class="lg-img-wrap">
          <Image
            src={featured.img}
            alt={featured.imgAlt}
            class="lg-img"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 1024px) 620px, 92vw"
            loading="lazy"
            decoding="async"
          />
          <div class="lg-price-overlay">
            <span class="lg-price-amount">{featured.price}</span>
            <span class="lg-price-unit">{featured.priceUnit}</span>
            {featured.priceNote && <span class="lg-price-note">{featured.priceNote}</span>}
          </div>
        </div>

        <div class="lg-body">
          <span class="lg-badge">{featured.badge}</span>
          <h3 class="lg-card-title">{featured.title}</h3>
          <p class="lg-desc">{featured.description}</p>
        </div>

        <div class="lg-footer">
          <a href={bookHref} class="lg-cta-primary">
            Book Now
            <Icon name="ph:arrow-right-bold" class="lg-cta-icon" aria-hidden="true"/>
          </a>
          <a href={featured.detailHref} class="lg-cta-secondary" aria-label={`${featured.detailLabel} in Cocoa Beach, see details`}>
            {featured.detailLabel} <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      {compact.map(l => (
        <article class="lg-card lg-card--compact">
          <div class="lg-img-wrap">
            <Image
              src={l.img}
              alt={l.imgAlt}
              class="lg-img"
              widths={[320, 480, 720]}
              sizes="(min-width: 1024px) 240px, (min-width: 640px) 40vw, 92vw"
              loading="lazy"
              decoding="async"
            />
            <div class="lg-price-overlay">
              <span class="lg-price-amount">{l.price}</span>
              <span class="lg-price-unit">{l.priceUnit}</span>
              {l.priceNote && <span class="lg-price-note">{l.priceNote}</span>}
            </div>
          </div>

          <div class="lg-compact-content">
            <div class="lg-body">
              <span class="lg-badge">{l.badge}</span>
              <h3 class="lg-card-title">{l.title}</h3>
              <p class="lg-desc">{l.description}</p>
            </div>

            <div class="lg-footer">
              <a href={bookHref} class="lg-cta-primary">
                Book Now
                <Icon name="ph:arrow-right-bold" class="lg-cta-icon" aria-hidden="true"/>
              </a>
              <a href={l.detailHref} class="lg-cta-secondary" aria-label={`${l.detailLabel} in Cocoa Beach, see details`}>
                {l.detailLabel} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}

    </div>
  </div>
</section>

<style>
  /* ── Variables ─────────────────────────────────────────── */
  .lg-section {
    --deep:       var(--c-ink);
    --brand:      var(--teal-primary);
    --brand-dark: var(--teal-dark);
    --brand-text: var(--teal-text);
    --gray:       var(--c-muted);
    --line:       rgba(0,188,212,.12);
    --maxw:       1180px;

    padding: 84px 0 96px;
    background: #fff;
    font-family: var(--font-body);
  }

  /* ── Layout ────────────────────────────────────────────── */
  .lg-wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 28px; }

  /* ── Header ────────────────────────────────────────────── */
  .lg-header { max-width: 600px; margin-bottom: 52px; }

  .lg-eyebrow {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .2em;
    color: var(--brand-text);
    margin-bottom: 14px;
  }

  .lg-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.12;
    color: var(--deep);
    margin-bottom: 18px;
  }
  /* Emphasis stays inside the same family. Padding reserve so an italic
     descender can never be clipped by the tight display leading. */
  .lg-title em {
    font-style: italic;
    color: var(--brand-text);
    padding-bottom: 1px;
  }

  .lg-subtitle {
    font-size: 1.05rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Asymmetric grid ───────────────────────────────────── */
  .lg-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 24px;
  }
  .lg-card--feature { grid-row: span 2; }

  /* ── Card ──────────────────────────────────────────────── */
  .lg-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 2px 16px -6px rgba(10,58,64,.10);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .lg-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px -12px rgba(10,58,64,.20);
  }

  /* Compact cards run horizontally beside the feature cell */
  .lg-card--compact { flex-direction: row; }
  .lg-card--compact .lg-img-wrap { width: 42%; height: auto; flex-shrink: 0; }
  .lg-compact-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  /* ── Image with overlay ────────────────────────────────── */
  .lg-img-wrap {
    position: relative;
    height: 300px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .lg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
    display: block;
  }
  .lg-card:hover .lg-img { transform: scale(1.06); }

  /* Price overlay at bottom of image */
  .lg-price-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(10,58,64,.92) 0%, rgba(10,58,64,.6) 60%, transparent 100%);
    padding: 32px 20px 16px;
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }

  .lg-price-amount {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--c-price-on-dark);
    line-height: 1;
  }
  .lg-price-unit {
    font-size: .82rem;
    color: rgba(255,255,255,.80);
    font-weight: 500;
  }
  .lg-price-note {
    font-size: .72rem;
    color: rgba(255,255,255,.65);
    font-weight: 500;
    width: 100%;
    margin-top: -2px;
  }

  /* ── Body ──────────────────────────────────────────────── */
  .lg-body {
    padding: 24px 24px 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Sentence-case chip, not a tracked-out uppercase eyebrow. A per-card
     eyebrow on every card in every section is what made the page read as
     templated; the differentiator itself is worth keeping. */
  .lg-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: .74rem;
    font-weight: 600;
    color: var(--brand-text);
    background: rgba(0,188,212,.08);
    border-radius: var(--r-sm);
    padding: 3px 9px;
    margin-bottom: 10px;
  }

  .lg-card-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--deep);
    margin-bottom: 12px;
  }
  .lg-card--compact .lg-card-title { font-size: 1.25rem; }

  .lg-desc {
    font-size: .93rem;
    color: var(--gray);
    line-height: 1.7;
    margin: 0;
    flex: 1;
  }
  .lg-card--compact .lg-desc { font-size: .88rem; }

  /* ── Footer / CTAs ─────────────────────────────────────── */
  .lg-footer {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lg-cta-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    padding: 13px 20px;
    border-radius: var(--r-full);
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-dark) 100%);
    color: #fff;
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: .01em;
    box-shadow: 0 4px 16px rgba(0,188,212,.30);
    transition: box-shadow .2s ease, gap .2s ease, transform .15s ease-out;
  }
  .lg-cta-primary:hover {
    gap: 12px;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,188,212,.42);
  }
  .lg-cta-primary:active { transform: translateY(0) scale(.98); }
  .lg-cta-primary :global(.lg-cta-icon) { width: 15px; height: 15px; flex-shrink: 0; }

  .lg-cta-secondary {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 11px 20px;
    border-radius: var(--r-full);
    border: 1.5px solid rgba(0,188,212,.25);
    background: transparent;
    color: var(--brand-text);
    font-size: .88rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: border-color .2s ease, color .2s ease, background .2s ease;
  }
  .lg-cta-secondary:hover {
    border-color: var(--brand);
    background: rgba(0,188,212,.06);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 1024px) {
    /* Below two columns the asymmetry stops earning its keep: single stack,
       compact cards stay horizontal while there is width for it. */
    .lg-grid { grid-template-columns: 1fr; grid-template-rows: auto; gap: 22px; }
    .lg-card--feature { grid-row: auto; }
    .lg-card--compact .lg-img-wrap { width: 38%; }
  }
  @media (max-width: 640px) {
    .lg-section { padding: 60px 0 72px; }
    .lg-wrap { padding: 0 20px; }
    .lg-card--compact { flex-direction: column; }
    .lg-card--compact .lg-img-wrap { width: 100%; height: 220px; }
    .lg-img-wrap { height: 220px; }
  }
</style>
