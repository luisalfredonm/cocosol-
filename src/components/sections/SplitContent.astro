---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Props {
  eyebrow?:   string
  title:      string
  body:       string[]          // array of paragraphs
  image:      ImageMetadata
  imageAlt:   string
  reverse?:   boolean           // image on right instead of left
  stat?:      { value: string; label: string }
  bg?:        'white' | 'tint'  // section background
  ctaLabel?:  string
  ctaHref?:   string
}
const {
  eyebrow,
  title,
  body,
  image,
  imageAlt,
  reverse = false,
  stat,
  bg = 'tint',
  ctaLabel,
  ctaHref,
} = Astro.props
---

<section class={`sc-section sc-section--${bg}`}>
  <div class={`sc-wrap ${reverse ? 'sc-wrap--reverse' : ''}`}>

    <div class="sc-img-col">
      <Image
        src={image}
        alt={imageAlt}
        class="sc-img"
        widths={[480, 720, 960]}
        sizes="(min-width: 900px) 45vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="sc-text-col">
      {eyebrow && <span class="sc-eyebrow">{eyebrow}</span>}
      <h2 class="sc-title">{title}</h2>
      {body.map(p => <p class="sc-body" set:html={p} />)}
      {stat && (
        <div class="sc-stat">
          <b class="sc-stat-value">{stat.value}</b>
          <span class="sc-stat-label">{stat.label}</span>
        </div>
      )}
      {ctaLabel && ctaHref && (
        <a href={ctaHref} class="sc-cta">{ctaLabel}</a>
      )}
    </div>

  </div>
</section>

<style>
  .sc-section {
    --deep:       #0A3A40;
    --brand:      #00BCD4;
    --brand-dark: #0097A7;
    --brand-text: #00838F;
    --gold:       #FFD079;
    --muted:      #5A7270;
    --maxw:       1180px;
    padding: 84px 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  .sc-section--white { background: #fff; }
  .sc-section--tint  { background: #EFF9FB; }

  .sc-wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .sc-wrap--reverse { direction: rtl; }
  .sc-wrap--reverse > * { direction: ltr; }

  /* Image */
  .sc-img-col { overflow: hidden; border-radius: 18px; }
  .sc-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 18px 50px -16px rgba(10,58,64,.25);
    display: block;
  }

  /* Text */
  .sc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--brand-text);
    margin-bottom: 14px;
  }
  .sc-eyebrow::before {
    content: '';
    width: 24px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
  }
  .sc-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--deep);
    margin-bottom: 18px;
  }
  .sc-body {
    font-size: 1.04rem;
    color: var(--muted);
    line-height: 1.72;
    margin-bottom: 14px;
  }
  .sc-body strong { color: var(--deep); font-weight: 700; }
  .sc-body:last-of-type { margin-bottom: 0; }

  /* Stat */
  .sc-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 20px;
  }
  .sc-stat-value {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--brand-text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .sc-stat-label { font-size: 1rem; color: var(--muted); font-weight: 600; }

  /* CTA */
  .sc-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding: 13px 26px;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--brand), var(--brand-dark));
    color: #fff;
    font-size: .92rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0,188,212,.30);
    transition: transform .15s ease-out, box-shadow .2s;
  }
  .sc-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0,188,212,.42);
  }

  @media (max-width: 900px) {
    .sc-wrap {
      grid-template-columns: 1fr;
      gap: 36px;
      direction: ltr;
    }
    .sc-wrap--reverse > * { direction: ltr; }
    .sc-img { height: 300px; order: -1; }
    .sc-img-col { order: -1; }
    .sc-section { padding: 60px 0; }
    .sc-wrap { padding: 0 20px; }
  }
</style>
