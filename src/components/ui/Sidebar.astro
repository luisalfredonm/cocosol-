---
export interface Props {
  price: string
  priceLabel?: string
  priceNote?: string
  includes: string[]
  ctaLabel?: string
  ctaHref?: string
  ctaColor?: 'teal' | 'dark'
  sidebarTitle?: string
}
const {
  price,
  priceLabel = '',
  priceNote,
  includes,
  ctaLabel = 'Check Availability',
  ctaHref = '/book-now',
  ctaColor = 'teal',
  sidebarTitle,
} = Astro.props

const ctaClass = ctaColor === 'dark'
  ? 'block w-full text-center bg-navy-900 hover:bg-gray-800 text-white font-bold py-3 rounded-xl transition-all duration-200'
  : 'block w-full text-center bg-gradient-to-br from-teal-500 to-teal-600 hover:from-teal-400 hover:to-teal-500 text-white font-bold py-3 rounded-xl transition-all duration-200 shadow-[0_4px_14px_rgba(0,188,212,0.3)] hover:shadow-[0_6px_20px_rgba(0,188,212,0.45)] hover:-translate-y-px'
---

<div class="sticky top-24 bg-teal-50 border border-teal-100 rounded-2xl p-6 shadow-brand">
  {sidebarTitle && <h3 class="font-bold text-gray-900 mb-3">{sidebarTitle}</h3>}

  <div class="text-center mb-5">
    <span class="text-5xl font-bold text-teal-500">{price}</span>
    {priceLabel && <span class="text-gray-500 text-sm ml-1">{priceLabel}</span>}
    {priceNote && <p class="text-xs text-gray-500 mt-1">{priceNote}</p>}
  </div>

  <ul class="space-y-2 mb-5">
    {includes.map(item => (
      <li class="flex items-center gap-2 text-sm text-gray-700">
        <svg class="w-4 h-4 text-teal-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        {item}
      </li>
    ))}
  </ul>

  <a href={ctaHref} class={ctaClass}>{ctaLabel}</a>

  <div class="flex items-center gap-2 mt-4 pt-4 border-t border-teal-100 text-sm text-gray-600">
    <svg class="w-4 h-4 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
    </svg>
    If you need help:
    <a href="tel:+50661987851" class="font-semibold text-teal-600 hover:underline">+506 6198-7851</a>
  </div>
</div>
