---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import { ROUTES } from '../../lib/seo'
import logoImg from '../../assets/images/Surf-Lessons-Cocoa-Beach.png'
const navLinks = [
  {
    label: 'Surf Lessons',
    href: ROUTES.SURF_LESSONS,
    children: [
      { label: 'Private Surf Lessons', href: ROUTES.PRIVATE },
      { label: 'Surf Coaching', href: ROUTES.SEMI_PRIVATE },
      { label: 'Training Schedule', href: ROUTES.TRAINING_SCHEDULE },
      { label: 'Group Surf Lessons', href: ROUTES.GROUP },
    ],
  },
  { label: 'Prices & Packages', href: ROUTES.PRICES },
  {
    label: 'Kids & Camps',
    href: ROUTES.CAMP,
    children: [
      { label: 'Kids Surf Lessons', href: ROUTES.KIDS },
      { label: 'Surf Camp Cocoa Beach', href: ROUTES.CAMP },
    ],
  },
  { label: 'About Us', href: ROUTES.ABOUT },
  { label: 'Guides', href: '/blog' },
  { label: 'Contact', href: ROUTES.CONTACT },
]
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 bg-white/95 transition-shadow duration-300 mobile-flat md:backdrop-blur-sm"
>
  <!-- Teal accent line at bottom matching footer top -->
  <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-teal-600 via-teal-400 to-teal-600 opacity-80"></div>

  <div class="container mx-auto px-4 lg:px-6">
    <div class="flex items-center justify-between h-[72px]">

      <!-- Logo: properly contained, no overflow tricks -->
      <a href="/" class="flex items-center shrink-0" aria-label="Cocosol Surf Lessons - Home">
        <Image
          src={logoImg}
          alt="Cocosol Surf Lessons"
          class="w-auto h-12 md:h-14 object-contain"
          width={120}
          height={113}
          widths={[90, 120, 160]}
          sizes="(max-width: 767px) 80px, 120px"
          loading="eager"
          decoding="sync"
          quality={70}
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(link => (
          <div class="relative group">
            {link.children ? (
              <button
                type="button"
                class="flex items-center gap-1 text-gray-700 hover:text-teal-600 font-semibold text-[16px] leading-5 tracking-wide transition-colors duration-150 px-3 py-6 bg-transparent border-0 cursor-default select-none"
              >
                {link.label}
                <Icon
                  name="ph:caret-down-bold"
                  class="w-3.5 h-3.5 mt-px opacity-60 group-hover:opacity-100 transition-transform duration-200 group-hover:rotate-180"
                  aria-hidden="true"
                />
              </button>
            ) : (
              <a
                href={link.href}
                class="flex items-center gap-1 text-gray-700 hover:text-teal-600 font-semibold text-[16px] leading-5 tracking-wide transition-colors duration-150 px-3 py-6"
              >
                {link.label}
              </a>
            )}

            <!-- Dropdown -->
            {link.children && (
              <div class="absolute top-full left-1/2 -translate-x-1/2 w-60 bg-white shadow-xl rounded-2xl border border-gray-100/80 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 translate-y-1 transition-all duration-200 py-2 mt-0">
                <!-- Small arrow pointer -->
                <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-white border-l border-t border-gray-100/80 rotate-45"></div>
                {link.children.map(child => (
                  <a
                    href={child.href}
                    class="block px-4 py-2.5 text-[14px] font-medium text-gray-600 hover:text-teal-600 hover:bg-teal-50/70 transition-colors mx-1 rounded-xl"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={ROUTES.BOOK}
          class="hidden md:inline-flex items-center gap-1.5 bg-gradient-to-br from-teal-500 to-teal-600 hover:from-teal-400 hover:to-teal-500 text-white font-bold text-[14px] tracking-wide px-5 py-2.5 rounded-xl transition-all duration-200 shadow-[0_4px_16px_rgba(0,188,212,0.35)] hover:shadow-[0_6px_22px_rgba(0,188,212,0.5)] hover:-translate-y-px"
        >
          <Icon name="ph:calendar-blank" class="w-4 h-4" aria-hidden="true"/>
          Book Now
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden p-2.5 rounded-xl text-gray-600 hover:text-teal-600 hover:bg-teal-50 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <Icon id="icon-open" name="ph:list" class="w-5 h-5" aria-hidden="true"/>
          <Icon id="icon-close" name="ph:x" class="w-5 h-5 hidden" aria-hidden="true"/>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-t border-gray-100 px-4 pb-5 shadow-lg"
  >
    <div class="pt-2 space-y-0.5">
      {navLinks.map(link => (
        <div>
          {link.children ? (
            <span class="block py-3 px-2 font-semibold text-[11px] text-gray-400 border-b border-gray-100 uppercase tracking-wider">
              {link.label}
            </span>
          ) : (
            <a
              href={link.href}
              class="block py-3 px-2 font-semibold text-[15px] text-gray-800 border-b border-gray-100 hover:text-teal-600 transition-colors"
            >
              {link.label}
            </a>
          )}
          {link.children && (
            <div class="pl-4 py-1 space-y-0.5">
              {link.children.map(child => (
                <a
                  href={child.href}
                  class="block py-2 text-[14px] text-gray-500 hover:text-teal-600 transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
    <a
      href={ROUTES.BOOK}
      class="mt-4 flex items-center justify-center gap-2 w-full bg-gradient-to-br from-teal-500 to-teal-600 text-white font-bold py-3 rounded-xl shadow-[0_4px_14px_rgba(0,188,212,0.3)] transition-all duration-200"
    >
      <Icon name="ph:calendar-blank" class="w-4 h-4" aria-hidden="true"/>
      Book Now
    </a>
  </div>
</header>

<!-- Zero-layout sentinel 8px down the document. The header shadow keys off
     whether this is still on screen, so the browser reports the crossing once
     instead of us recomputing it on every scroll frame. -->
<div id="header-sentinel" aria-hidden="true" class="absolute top-2 left-0 w-px h-px pointer-events-none"></div>

<!-- Spacer for fixed header. Must stay in sync with the h-[72px] above and with
     the `calc(100dvh-72px)` full-height hero in Hero.astro. -->
<div class="h-[72px]"></div>

<script>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('icon-open')
  const iconClose = document.getElementById('icon-close')
  const header = document.getElementById('site-header')

  // Mobile toggle with icon swap
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden')
    menu?.classList.toggle('hidden')
    iconOpen?.classList.toggle('hidden', !isOpen)
    iconClose?.classList.toggle('hidden', isOpen)
    toggle.setAttribute('aria-expanded', String(!isOpen))
  })

  // Scroll shadow, driven by IntersectionObserver rather than a scroll
  // listener: the callback runs only when the sentinel actually crosses the
  // viewport edge, not on every frame of every scroll.
  const sentinel = document.getElementById('header-sentinel')
  if (header && sentinel) {
    const io = new IntersectionObserver(
      ([entry]) => header.classList.toggle('shadow-md', !entry.isIntersecting),
      { threshold: 0 },
    )
    io.observe(sentinel)
  }
</script>
