---
import { Image } from 'astro:assets'
import { ROUTES } from '../../lib/seo'
import logoImg from '../../assets/images/Surf-Lessons-Cocoa-Beach.png'
const navLinks = [
  {
    label: 'Surf Lessons',
    href: ROUTES.SURF_LESSONS,
    children: [
      { label: 'Private Surf Lessons', href: ROUTES.PRIVATE },
      { label: 'Surf Coaching', href: ROUTES.SEMI_PRIVATE },
      { label: 'Group Surf Lessons', href: ROUTES.GROUP },
    ],
  },
  { label: 'Prices & Packages', href: ROUTES.PRICES },
  {
    label: 'Kids & Camps',
    href: ROUTES.CAMP,
    children: [
      { label: 'Kids Surf Lessons', href: ROUTES.KIDS },
      { label: 'Surf Camp Cocoa Beach', href: ROUTES.CAMP },
    ],
  },
  { label: 'About Us', href: ROUTES.ABOUT },
  { label: 'Guides', href: '/blog' },
  { label: 'Contact', href: ROUTES.CONTACT },
]
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 bg-white/95 transition-shadow duration-300 mobile-flat md:backdrop-blur-sm"
>
  <!-- Teal accent line at bottom matching footer top -->
  <div class="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-teal-600 via-teal-400 to-teal-600 opacity-80"></div>

  <div class="container mx-auto px-4 lg:px-6">
    <div class="flex items-center justify-between h-24">

      <!-- Logo: properly contained, no overflow tricks -->
      <a href="/" class="flex items-center shrink-0" aria-label="Cocosol Surf Lessons - Home">
        <Image
          src={logoImg}
          alt="Cocosol Surf Lessons"
          class="w-auto h-16 md:h-20 object-contain"
          width={120}
          height={113}
          widths={[90, 120, 160]}
          sizes="(max-width: 767px) 80px, 120px"
          loading="eager"
          decoding="sync"
          quality={70}
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(link => (
          <div class="relative group">
            {link.children ? (
              <button
                type="button"
                class="flex items-center gap-1 text-gray-700 hover:text-teal-600 font-semibold text-[16px] leading-5 tracking-wide transition-colors duration-150 px-3 py-7 bg-transparent border-0 cursor-default select-none"
              >
                {link.label}
                <svg
                  class="w-3.5 h-3.5 mt-px opacity-60 group-hover:opacity-100 transition-transform duration-200 group-hover:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
            ) : (
              <a
                href={link.href}
                class="flex items-center gap-1 text-gray-700 hover:text-teal-600 font-semibold text-[16px] leading-5 tracking-wide transition-colors duration-150 px-3 py-7"
              >
                {link.label}
              </a>
            )}

            <!-- Dropdown -->
            {link.children && (
              <div class="absolute top-full left-1/2 -translate-x-1/2 w-60 bg-white shadow-xl rounded-2xl border border-gray-100/80 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 translate-y-1 transition-all duration-200 py-2 mt-0">
                <!-- Small arrow pointer -->
                <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-white border-l border-t border-gray-100/80 rotate-45"></div>
                {link.children.map(child => (
                  <a
                    href={child.href}
                    class="flex items-center gap-2.5 px-4 py-2.5 text-[14px] font-medium text-gray-600 hover:text-teal-600 hover:bg-teal-50/70 transition-colors mx-1 rounded-xl"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-teal-400 shrink-0"></span>
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a
          href={ROUTES.BOOK}
          class="hidden md:inline-flex items-center gap-1.5 bg-gradient-to-br from-teal-500 to-teal-600 hover:from-teal-400 hover:to-teal-500 text-white font-bold text-[14px] tracking-wide px-5 py-2.5 rounded-xl transition-all duration-200 shadow-[0_4px_16px_rgba(0,188,212,0.35)] hover:shadow-[0_6px_22px_rgba(0,188,212,0.5)] hover:-translate-y-px"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Book Now
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden p-2.5 rounded-xl text-gray-600 hover:text-teal-600 hover:bg-teal-50 transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-t border-gray-100 px-4 pb-5 shadow-lg"
  >
    <div class="pt-2 space-y-0.5">
      {navLinks.map(link => (
        <div>
          {link.children ? (
            <span class="block py-3 px-2 font-semibold text-[15px] text-gray-400 border-b border-gray-100 uppercase tracking-wider text-[11px]">
              {link.label}
            </span>
          ) : (
            <a
              href={link.href}
              class="block py-3 px-2 font-semibold text-[15px] text-gray-800 border-b border-gray-100 hover:text-teal-600 transition-colors"
            >
              {link.label}
            </a>
          )}
          {link.children && (
            <div class="pl-4 py-1 space-y-0.5">
              {link.children.map(child => (
                <a
                  href={child.href}
                  class="flex items-center gap-2 py-2 text-[14px] text-gray-500 hover:text-teal-600 transition-colors"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-teal-400 shrink-0"></span>
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
    <a
      href={ROUTES.BOOK}
      class="mt-4 flex items-center justify-center gap-2 w-full bg-gradient-to-br from-teal-500 to-teal-600 text-white font-bold py-3 rounded-xl shadow-[0_4px_14px_rgba(0,188,212,0.3)] transition-all duration-200"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      Book Now
    </a>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-24"></div>

<script>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('icon-open')
  const iconClose = document.getElementById('icon-close')
  const header = document.getElementById('site-header')

  // Mobile toggle with icon swap
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden')
    menu?.classList.toggle('hidden')
    iconOpen?.classList.toggle('hidden', !isOpen)
    iconClose?.classList.toggle('hidden', isOpen)
    toggle.setAttribute('aria-expanded', String(!isOpen))
  })

  // Scroll shadow
  const updateShadow = () => {
    if (window.scrollY > 8) {
      header?.classList.add('shadow-md')
    } else {
      header?.classList.remove('shadow-md')
    }
  }
  window.addEventListener('scroll', updateShadow, { passive: true })
  updateShadow()
</script>
