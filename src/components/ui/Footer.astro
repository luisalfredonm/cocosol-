---
import { Image } from 'astro:assets'
import { ROUTES } from '../../lib/seo'
import logoImg from '../../assets/images/Surf-Lessons-Cocoa-Beach.png'

const year = new Date().getFullYear()
---

<footer class="bg-[#0C2128] text-white">

  <!-- Teal accent line at top -->
  <div class="h-1 w-full bg-gradient-to-r from-teal-600 via-teal-400 to-teal-600"></div>

  <!-- Main footer body -->
  <div class="container mx-auto px-4 pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 mb-14">

      <!-- Brand col — 4 cols -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-block mb-5">
          <Image
            src={logoImg}
            alt="Cocosol Surf Lessons"
            class="h-20 w-auto"
            width={180} height={80}
            loading="lazy" decoding="async"
          />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed max-w-xs mb-6">
          Certified surf lessons, camps and packages in Cocoa Beach, Florida.
          Small groups, local coaches and real progression from your first wave.
        </p>

        <!-- Contact pills -->
        <div class="flex flex-col gap-3 mb-6">
          <a href="https://wa.me/13213869993" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2.5 text-sm font-semibold text-white/80 hover:text-[#25D366] transition-colors group">
            <span class="w-8 h-8 rounded-xl bg-[#25D366]/15 group-hover:bg-[#25D366]/25 flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </span>
            WhatsApp: +1 (321) 386-9993
          </a>
          <a href="mailto:info@cocosolsurf.com"
            class="inline-flex items-center gap-2.5 text-sm font-semibold text-white/80 hover:text-teal-400 transition-colors group">
            <span class="w-8 h-8 rounded-xl bg-teal-500/15 group-hover:bg-teal-500/25 flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            info@cocosolsurf.com
          </a>
          <a href="https://maps.google.com/?q=632+Adams+Ave,+Cape+Canaveral,+FL+32920" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2.5 text-sm font-semibold text-white/80 hover:text-teal-400 transition-colors group">
            <span class="w-8 h-8 rounded-xl bg-teal-500/15 group-hover:bg-teal-500/25 flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            Cocoa Beach, Florida, USA
          </a>
        </div>

      </div>

      <!-- Nav cols -->
      <div class="lg:col-span-2">
        <p class="text-xs font-extrabold uppercase tracking-widest text-teal-300 mb-5">Surf Lessons</p>
        <ul class="space-y-3">
          <li><a href={ROUTES.PRIVATE} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Private Lessons</a></li>
          <li><a href={ROUTES.SEMI_PRIVATE} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Surf Coaching</a></li>
          <li><a href={ROUTES.GROUP} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Group Lessons</a></li>
          <li><a href={ROUTES.SURF_LESSONS} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">All Surf Lessons</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <p class="text-xs font-extrabold uppercase tracking-widest text-teal-300 mb-5">Kids & Camps</p>
        <ul class="space-y-3">
          <li><a href={ROUTES.PRICES} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Surf Packages</a></li>
          <li><a href={ROUTES.KIDS} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Kids Surf Lessons</a></li>
          <li><a href={ROUTES.CAMP} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Surf Camp Cocoa Beach</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <p class="text-xs font-extrabold uppercase tracking-widest text-teal-300 mb-5">Company</p>
        <ul class="space-y-3">
          <li><a href={ROUTES.ABOUT} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">About Us</a></li>
          <li><a href={ROUTES.CONTACT} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Contact</a></li>
          <li><a href="/blog" class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Guides</a></li>
          <li><a href={ROUTES.BOOK} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Book Now</a></li>
        </ul>
      </div>

      <!-- Newsletter col — 2 cols -->
      <div class="lg:col-span-2">
        <p class="text-xs font-extrabold uppercase tracking-widest text-teal-300 mb-5">Stay in the Loop</p>
        <p class="text-gray-300 text-sm mb-4 leading-relaxed">Get surf tips, camp updates and exclusive deals.</p>
        <form class="flex flex-col gap-2" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            class="w-full bg-white/8 border border-white/12 rounded-xl px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500/30 transition-all"
          />
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-400 hover:to-teal-500 text-white text-sm font-bold py-2.5 rounded-xl transition-all duration-200 shadow-[0_4px_14px_rgba(0,188,212,0.25)] hover:shadow-[0_4px_20px_rgba(0,188,212,0.4)]"
          >
            Subscribe
          </button>
        </form>

        <!-- Trust badge -->
        <div class="mt-6 flex items-center gap-2 bg-white/5 rounded-xl px-3 py-2.5">
          <svg class="w-5 h-5 text-teal-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span class="text-xs text-gray-400">Certified · Insured · 5★ rated</span>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-white/8 pt-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-gray-300 text-sm">
          &copy; {year} Cocosol Surf Lessons. All rights reserved. Cocoa Beach, Florida
          <span class="text-white/15 mx-2">|</span>
          Developed by
          <a href="https://321solutions.net" target="_blank" rel="noopener noreferrer" class="text-teal-300 hover:text-teal-200 font-semibold transition-colors">321 Solutions</a>
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
          <a href="/privacy-policy" class="text-gray-300 hover:text-teal-300 text-xs transition-colors">Privacy Policy</a>
          <span class="text-white/10 hidden md:inline">|</span>
          <a href="/terms-of-use" class="text-gray-300 hover:text-teal-300 text-xs transition-colors">Terms of Use</a>
          <span class="text-white/10 hidden md:inline">|</span>
          <a href="/sitemap-index.xml" class="text-gray-300 hover:text-teal-300 text-xs transition-colors">Sitemap</a>
          <span class="text-white/10 hidden md:inline">|</span>
          <a href="https://wa.me/13213869993" target="_blank" rel="noopener" class="text-gray-300 hover:text-teal-300 text-xs transition-colors">WhatsApp Support</a>
        </div>
      </div>
    </div>
  </div>
</footer>
