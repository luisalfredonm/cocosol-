---
import { Image } from 'astro:assets'
import { ROUTES } from '../../lib/seo'
import logoImg from '../../assets/images/logo.png'
---

<footer class="bg-navy-900 text-white pt-16 pb-8">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/">
          <Image src={logoImg} alt="Pura Vida Surf School Tamarindo" class="h-16 w-auto mb-4 brightness-0 invert" width={160} height={64} loading="lazy" decoding="async" formats={['avif', 'webp']} />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Surf lessons, camps and packages in Tamarindo with pura vida style and care!!!!!!
        </p>
        <div class="flex gap-4 mt-4">
          <a href="https://www.facebook.com/puravidasurfschool" target="_blank" rel="noopener" aria-label="Facebook" class="text-gray-400 hover:text-teal-400 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/puravidasurfschool" target="_blank" rel="noopener" aria-label="Instagram" class="text-gray-400 hover:text-teal-400 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>
      </div>

      <!-- Surf Packages -->
      <div>
        <h3 class="font-bold text-white mb-4">Surf Packages</h3>
        <ul class="space-y-2">
          <li><a href={ROUTES.PKG_3} class="text-gray-400 hover:text-teal-400 text-sm transition-colors">3 Days Surf Packages</a></li>
          <li><a href={ROUTES.PKG_5} class="text-gray-400 hover:text-teal-400 text-sm transition-colors">5 Days Surf Packages</a></li>
          <li><a href={ROUTES.CAMP_7} class="text-gray-400 hover:text-teal-400 text-sm transition-colors">7 Days Surf Packages</a></li>
        </ul>
      </div>

      <!-- Surf Lessons -->
      <div>
        <h3 class="font-bold text-white mb-4">Surf Lessons</h3>
        <ul class="space-y-2">
          <li><a href={ROUTES.PRIVATE} class="text-gray-400 hover:text-teal-400 text-sm transition-colors">Private Surf Lessons</a></li>
          <li><a href={ROUTES.SEMI_PRIVATE} class="text-gray-400 hover:text-teal-400 text-sm transition-colors">Semi-Private Surf Lessons</a></li>
          <li><a href={ROUTES.GROUP} class="text-gray-400 hover:text-teal-400 text-sm transition-colors">Group Surf Lessons</a></li>
        </ul>
      </div>

      <!-- Call Us + Subscribe -->
      <div>
        <h3 class="font-bold text-white mb-4">Call Us</h3>
        <a href="tel:+50661987851" class="flex items-center gap-2 text-white font-bold text-lg mb-6 hover:text-teal-400 transition-colors">
          <svg class="w-5 h-5 text-teal-400" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          +50661987851
        </a>
        <h3 class="font-bold text-white mb-3">Subscribe:</h3>
        <form class="flex gap-2" onsubmit="return false;">
          <input type="email" placeholder="Your email" class="flex-1 bg-white/10 border border-white/20 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-400 focus:outline-none focus:border-teal-400" />
          <button type="submit" class="bg-gradient-to-br from-teal-500 to-teal-600 hover:from-teal-400 hover:to-teal-500 text-white text-sm font-bold px-4 py-2 rounded-lg transition-all duration-200 shadow-[0_4px_10px_rgba(0,188,212,0.3)]">Sign Up</button>
        </form>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-gray-400 text-sm">
        &copy; {new Date().getFullYear()} Pura Vida Surf School. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="/privacy-policy" class="text-gray-400 hover:text-teal-400 text-sm transition-colors">Privacy Policy</a>
        <a href="/terms-of-use" class="text-gray-400 hover:text-teal-400 text-sm transition-colors">Terms of Use</a>
        <a href="/sitemap-index.xml" class="text-gray-400 hover:text-teal-400 text-sm transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
