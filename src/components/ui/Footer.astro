---
import { Image } from 'astro:assets'
import { ROUTES } from '../../lib/seo'
import logoImg from '../../assets/images/logo.png'

const year = new Date().getFullYear()
---

<footer class="bg-[#0A1628] text-white">

  <!-- Teal accent line at top -->
  <div class="h-1 w-full bg-gradient-to-r from-teal-600 via-teal-400 to-teal-600"></div>

  <!-- Main footer body -->
  <div class="container mx-auto px-4 pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 mb-14">

      <!-- Brand col — 4 cols -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-block mb-5">
          <Image
            src={logoImg}
            alt="Pura Vida Surf School Tamarindo"
            class="h-20 w-auto brightness-0 invert"
            width={180} height={80}
            loading="lazy" decoding="async"
            formats={['avif', 'webp']}
          />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed max-w-xs mb-6">
          Certified surf lessons, camps and packages in Tamarindo, Costa Rica.
          Small groups, warm water, pura vida vibes — from your very first wave.
        </p>

        <!-- Contact pills -->
        <div class="flex flex-col gap-3 mb-6">
          <a href="https://wa.me/50661987851" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2.5 text-sm font-semibold text-white/80 hover:text-[#25D366] transition-colors group">
            <span class="w-8 h-8 rounded-xl bg-[#25D366]/15 group-hover:bg-[#25D366]/25 flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </span>
            WhatsApp: +506 6198-7851
          </a>
          <a href="mailto:info@puravidasurfschool.com"
            class="inline-flex items-center gap-2.5 text-sm font-semibold text-white/80 hover:text-teal-400 transition-colors group">
            <span class="w-8 h-8 rounded-xl bg-teal-500/15 group-hover:bg-teal-500/25 flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            info@puravidasurfschool.com
          </a>
          <a href="https://maps.google.com/?q=Tamarindo,+Costa+Rica" target="_blank" rel="noopener"
            class="inline-flex items-center gap-2.5 text-sm font-semibold text-white/80 hover:text-teal-400 transition-colors group">
            <span class="w-8 h-8 rounded-xl bg-teal-500/15 group-hover:bg-teal-500/25 flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            Tamarindo, Guanacaste, Costa Rica
          </a>
        </div>

        <!-- Social icons -->
        <div class="flex gap-3">
          <a href="https://www.facebook.com/profile.php?id=61578013897729" target="_blank" rel="noopener" aria-label="Facebook"
            class="w-9 h-9 rounded-xl bg-white/8 hover:bg-[#1877F2]/20 hover:text-[#1877F2] text-gray-400 flex items-center justify-center transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/pura_vidasurfschool" target="_blank" rel="noopener" aria-label="Instagram"
            class="w-9 h-9 rounded-xl bg-white/8 hover:bg-pink-500/20 hover:text-pink-400 text-gray-400 flex items-center justify-center transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@puravidasurfschool" target="_blank" rel="noopener" aria-label="TikTok"
            class="w-9 h-9 rounded-xl bg-white/8 hover:bg-white/15 text-gray-400 hover:text-white flex items-center justify-center transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>
          </a>
        </div>
      </div>

      <!-- Nav cols -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-extrabold uppercase tracking-widest text-teal-400 mb-5">Surf Lessons</h4>
        <ul class="space-y-3">
          <li><a href={ROUTES.PRIVATE} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Private Lessons</a></li>
          <li><a href={ROUTES.SEMI_PRIVATE} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Semi-Private Lessons</a></li>
          <li><a href={ROUTES.GROUP} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Group Lessons</a></li>
          <li><a href={ROUTES.SURF_LESSONS} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">All Surf Lessons</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h4 class="text-xs font-extrabold uppercase tracking-widest text-teal-400 mb-5">Packages & Camps</h4>
        <ul class="space-y-3">
          <li><a href={ROUTES.PKG_3} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">3-Day Package</a></li>
          <li><a href={ROUTES.PKG_5} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">5-Day Package</a></li>
          <li><a href={ROUTES.CAMP_5} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">5-Day Surf Camp</a></li>
          <li><a href={ROUTES.CAMP_7} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">7-Day Surf Camp</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h4 class="text-xs font-extrabold uppercase tracking-widest text-teal-400 mb-5">Company</h4>
        <ul class="space-y-3">
          <li><a href={ROUTES.ABOUT} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">About Us</a></li>
          <li><a href={ROUTES.CONTACT} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Contact</a></li>
          <li><a href="/blog" class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Blog</a></li>
          <li><a href={ROUTES.BOOK} class="text-gray-400 hover:text-white text-sm transition-colors hover:translate-x-1 inline-block transition-transform">Book Now</a></li>
        </ul>
      </div>

      <!-- Newsletter col — 2 cols -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-extrabold uppercase tracking-widest text-teal-400 mb-5">Stay in the Loop</h4>
        <p class="text-gray-400 text-sm mb-4 leading-relaxed">Get surf tips, camp updates and exclusive deals.</p>
        <form class="flex flex-col gap-2" onsubmit="return false;">
          <input
            type="email"
            placeholder="your@email.com"
            class="w-full bg-white/8 border border-white/12 rounded-xl px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500/30 transition-all"
          />
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-400 hover:to-teal-500 text-white text-sm font-bold py-2.5 rounded-xl transition-all duration-200 shadow-[0_4px_14px_rgba(0,188,212,0.25)] hover:shadow-[0_4px_20px_rgba(0,188,212,0.4)]"
          >
            Subscribe
          </button>
        </form>

        <!-- Trust badge -->
        <div class="mt-6 flex items-center gap-2 bg-white/5 rounded-xl px-3 py-2.5">
          <svg class="w-5 h-5 text-teal-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span class="text-xs text-gray-400">Certified · Insured · 5★ rated</span>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-white/8 pt-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-gray-500 text-sm">
          &copy; {year} Pura Vida Surf School. All rights reserved. · Tamarindo, Costa Rica
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
          <a href="/privacy-policy" class="text-gray-500 hover:text-teal-400 text-xs transition-colors">Privacy Policy</a>
          <span class="text-white/10 hidden md:inline">|</span>
          <a href="/terms-of-use" class="text-gray-500 hover:text-teal-400 text-xs transition-colors">Terms of Use</a>
          <span class="text-white/10 hidden md:inline">|</span>
          <a href="/sitemap-index.xml" class="text-gray-500 hover:text-teal-400 text-xs transition-colors">Sitemap</a>
          <span class="text-white/10 hidden md:inline">|</span>
          <a href="https://wa.me/50661987851" target="_blank" rel="noopener" class="text-gray-500 hover:text-teal-400 text-xs transition-colors">WhatsApp Support</a>
        </div>
      </div>
    </div>
  </div>
</footer>
