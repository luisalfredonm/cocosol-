---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Props {
  title: string
  subtitle?: string
  image: ImageMetadata | string
  imageAlt: string
  cta?: { label: string; href: string }
  ctaSecondary?: { label: string; href: string }
  breadcrumb?: { label: string; href?: string }
  height?: 'full' | 'large' | 'medium'
  overlay?: 'dark' | 'medium' | 'light'
  objectPosition?: string
}
const {
  title, subtitle, image, imageAlt,
  cta, ctaSecondary,
  breadcrumb,
  height = 'large',
  overlay = 'dark',
  objectPosition = 'center center',
} = Astro.props

/* The header is fixed at 72px with a spacer of the same height in normal flow,
   so a `100dvh` hero actually renders 72px taller than the viewport and pushes
   its own bottom-aligned CTA below the fold. Subtracting the header height is
   what keeps "Book Now" visible without scrolling.
   dvh (not vh) so the iOS Safari address bar does not cause a jump. */
const heightClass = {
  full:   'min-h-[calc(100dvh-72px)]',
  large:  'min-h-[62dvh] md:min-h-[68dvh]',
  medium: 'min-h-[46dvh] md:min-h-[52dvh]',
}[height]

const overlayClass = {
  dark:   'bg-gradient-to-t from-[#0C2128]/90 via-[#0C2128]/50 to-[#0C2128]/25',
  medium: 'bg-gradient-to-t from-[#0C2128]/80 via-[#0C2128]/40 to-[#0C2128]/15',
  light:  'bg-gradient-to-t from-[#0C2128]/65 via-[#0C2128]/28 to-transparent',
}[overlay]
const isLocal = typeof image !== 'string'
---

<section class={`relative ${heightClass} flex items-end pb-12 md:pb-16`}>
  <div class="absolute inset-0">
    {isLocal ? (
      <Image
        src={image as ImageMetadata}
        alt={imageAlt}
        class="w-full h-full object-cover"
        style={`object-position: ${objectPosition}`}
        widths={[640, 1280, 1920]}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        sizes="100vw"
      />
    ) : (
      <img
        src={image as string}
        alt={imageAlt}
        class="w-full h-full object-cover"
        style={`object-position: ${objectPosition}`}
        width="1920"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        sizes="100vw"
      />
    )}
    <div class={`absolute inset-0 ${overlayClass}`}></div>
  </div>

  <div class="relative z-10 container mx-auto px-4 w-full">
    {breadcrumb && (
      <nav class="mb-5 flex items-center gap-2 text-white/70 text-sm" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true">/</span>
        {breadcrumb.href
          ? <a href={breadcrumb.href} class="hover:text-white transition-colors">{breadcrumb.label}</a>
          : <span class="text-white">{breadcrumb.label}</span>
        }
      </nav>
    )}

    <!-- Scale planned to land in 2 lines at desktop with the full keyword
         phrase intact. max-w-4xl (not 3xl) is what buys the second line. -->
    <h1 class="font-display font-bold text-white max-w-4xl text-[2rem] leading-[1.1] sm:text-4xl md:text-5xl lg:text-[3.25rem] lg:leading-[1.08] tracking-[-0.02em]">
      {title}
    </h1>

    {subtitle && (
      <p class="mt-4 text-base md:text-lg text-white/85 max-w-xl leading-relaxed">{subtitle}</p>
    )}

    {(cta || ctaSecondary) && (
      <div class="mt-7 flex flex-wrap gap-3">
        {cta && <a href={cta.href} data-astro-prefetch="viewport" class="btn-primary">{cta.label}</a>}
        {ctaSecondary && <a href={ctaSecondary.href} data-astro-prefetch class="btn-secondary">{ctaSecondary.label}</a>}
      </div>
    )}
  </div>
</section>
