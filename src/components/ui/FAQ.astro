---
export interface FAQItem {
  question: string
  answer: string
}
export interface Props {
  items: FAQItem[]
  title?: string
  subtitle?: string
  columns?: 1 | 2
}
const { items, title, subtitle, columns = 1 } = Astro.props
const half = Math.ceil(items.length / 2)
---

{(title || subtitle) && (
  <div class="mb-8">
    {title && <h2 class="text-3xl font-bold text-gray-900">{title}</h2>}
    {subtitle && <p class="text-gray-600 mt-2 max-w-xl">{subtitle}</p>}
  </div>
)}

<div class={columns === 2 ? 'grid md:grid-cols-2 gap-x-12' : ''}>
  {columns === 2 ? (
    <>
      <div class="space-y-3">
        {items.slice(0, half).map((item, i) => (
          <details class="group border border-gray-200 rounded-xl overflow-hidden" id={`faq-${i}`}>
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none">
              {item.question}
              <svg class="w-5 h-5 text-teal-500 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
      <div class="space-y-3 mt-3 md:mt-0">
        {items.slice(half).map((item, i) => (
          <details class="group border border-gray-200 rounded-xl overflow-hidden" id={`faq-b-${i}`}>
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none">
              {item.question}
              <svg class="w-5 h-5 text-teal-500 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed">{item.answer}</div>
          </details>
        ))}
      </div>
    </>
  ) : (
    <div class="space-y-3">
      {items.map((item, i) => (
        <details class="group border border-gray-200 rounded-xl overflow-hidden" id={`faq-${i}`}>
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none">
            {item.question}
            <svg class="w-5 h-5 text-teal-500 shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
          </summary>
          <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed">{item.answer}</div>
        </details>
      ))}
    </div>
  )}
</div>
