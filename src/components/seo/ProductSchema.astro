---
interface Props {
  name: string
  description: string
  price: string
  url: string
  image?: string
  currency?: string
}
const { name, description, price, url, image, currency = 'USD' } = Astro.props
const site = 'https://puravidasurfschool.com'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  ...(image ? { image: image.startsWith('http') ? image : `${site}${image}` } : {}),
  brand: { '@type': 'Brand', name: 'Pura Vida Surf School' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: '127',
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'Offer',
    price,
    priceCurrency: currency,
    availability: 'https://schema.org/InStock',
    url: url.startsWith('http') ? url : `${site}${url}`,
    seller: { '@type': 'Organization', name: 'Pura Vida Surf School' },
  },
}
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
