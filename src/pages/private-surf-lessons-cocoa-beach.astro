---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import TrustBar from '../components/sections/TrustBar.astro'
import LessonPricing from '../components/sections/LessonPricing.astro'
import GearIncluded from '../components/sections/GearIncluded.astro'
import CompareColumns from '../components/sections/CompareColumns.astro'
import AudienceCards from '../components/sections/AudienceCards.astro'
import HowItWorks from '../components/sections/HowItWorks.astro'
import SplitContent from '../components/sections/SplitContent.astro'
import FinalCTA from '../components/sections/FinalCTA.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BookingWizard from '../components/booking/BookingWizard'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import ProductSchema from '../components/seo/ProductSchema.astro'
import { seoData } from '../lib/seo'

import heroImg       from '../assets/images/private-surf-lessons-cocoa-beach-one-on-one.webp'
import instructorImg from '../assets/images/cocoa-beach-private-surf-lesson-instructor.webp'
import coachingImg   from '../assets/images/one-on-one-surf-lessons-cocoa-beach-coaching.webp'
import techniqueImg  from '../assets/images/private-surf-classes-cocoa-beach-technique.webp'
import ctaBgImg      from '../assets/images/cocoa-beach-private-surf-coaching-beginner.webp'

const seo = seoData.privateLessons

const trustItems = [
  { value: '5★',      label: 'Google Rating' },
  { value: '100%',    label: 'Satisfaction' },
  { value: '1–2 hr',  label: 'Per Session' },
  { value: 'All Levels', label: 'Welcome' },
]

const priceRows = [
  { name: 'Single Lesson',    note: '1 hr $75 · 2 hr $140',              sessions: '1 session',  price: '$75',  popular: false },
  { name: 'Starter Pack',     note: '4 lessons · flexible scheduling',   sessions: '4 sessions', price: '$260', popular: true  },
  { name: 'Progression Pack', note: '6 lessons · 1 photo session',       sessions: '6 sessions', price: '$475', popular: false },
]

const gear = [
  { label: 'Surfboard (foam or fiberglass)' },
  { label: 'Foam guard & rash protection' },
  { label: 'Certified surf instructor (1-on-1)' },
  { label: 'Beach safety briefing' },
  { label: 'Wave-reading coaching' },
  { label: 'Photos available on request' },
]

const subblocks = [
  {
    image:    coachingImg,
    imageAlt: 'One-on-one surf coaching session on Cocoa Beach',
    title:    'Personalized Instruction',
    body:     'Your instructor adapts every drill to your level — from your first pop-up to linking turns. No waiting, no group pace. Every correction is yours.',
  },
  {
    image:    techniqueImg,
    imageAlt: 'Surf technique correction during private lesson on Cocoa Beach',
    title:    'Faster Progression',
    body:     'Students in private lessons progress on average twice as fast as those in group settings. Every minute of the water time is dedicated exclusively to you.',
  },
]

const compareLeft = {
  title:   'Private Lesson',
  price:   'From $75 / person',
  badge:   'Best for Progress',
  items: [
    '100% instructor attention — only you',
    'Lesson adapts to your real-time feedback',
    'Flexible start times around your schedule',
    'Fastest path to standing and turning',
    'Works for all levels, even complete beginners',
  ],
}

const compareRight = {
  title:   'Group Lesson',
  price:   'From $60 / person',
  items: [
    'Shared instructor across 4–8 students',
    'Fixed curriculum and scheduled times',
    'Great for the social, shared experience',
    'Best if you want a casual intro to surfing',
    'Beginner-focused curriculum',
  ],
}

const audienceCards = [
  {
    num:       '01',
    title:     'Complete Beginners',
    body:      'Never been on a board? Private lessons are the safest, fastest way to stand up on your first day. Your instructor never takes their eyes off you.',
    linkLabel: 'Book a beginner session',
    linkHref:  '#book',
  },
  {
    num:       '02',
    title:     'Intermediate Surfers',
    body:      'Stuck on the same move for months? One-on-one coaching targets exactly what\'s holding you back and gives you a clear plan to break through.',
    linkLabel: 'Level up your surfing',
    linkHref:  '#book',
  },
  {
    num:       '03',
    title:     'Families & Kids',
    body:      'Traveling with kids? Private lessons let every member progress at their own pace under dedicated instructor supervision — safe and fun.',
    linkLabel: 'Book a family session',
    linkHref:  '#book',
  },
  {
    num:       '04',
    title:     'Couples & Friends',
    body:      'Want to share the experience but still get personal attention? Book a session for two — progression together without the compromise of a group.',
    linkLabel: 'Book for two',
    linkHref:  '#book',
  },
]

const steps = [
  {
    title: 'Choose your date',
    body:  'Use our booking wizard to pick your preferred date and time. Morning slots fill fastest — book early to secure the best conditions.',
  },
  {
    title: 'Beach safety briefing',
    body:  'Your instructor starts on the sand. You\'ll learn ocean safety basics, wave reading, and practice your pop-up before entering the water.',
  },
  {
    title: 'In the water',
    body:  'Your instructor stays right beside you for the full water session, giving real-time corrections and choosing the right waves for your level.',
  },
  {
    title: 'Post-session debrief',
    body:  'At the end, your instructor reviews what you nailed and what to focus on next — leaving you with a clear roadmap for your next session.',
  },
]

const faqs = [
  { question: 'What is included in a private surf lesson?', answer: 'Every private lesson includes a certified instructor, surfboard, foam guard, beach safety briefing, and 1 to 2 hours of one-on-one instruction in the water. Photos are available on request.' },
  { question: 'Are private surf lessons suitable for complete beginners?', answer: "Absolutely. Private lessons are the best option for beginners because you get 100% of the instructor's attention. You'll progress much faster than in a group setting, and your instructor can prioritize your safety at every step." },
  { question: 'How long does each private surf lesson last?', answer: 'Each session runs 1 to 2 hours total, including a land safety briefing and active time in the water with your instructor.' },
  { question: 'Do I need to bring my own surfboard or equipment?', answer: 'No — a surfboard and all necessary gear are included with every lesson. We provide the right board for your level and body size.' },
  { question: 'What should I bring to my surf lesson?', answer: 'Wear or bring a swimsuit. We recommend reef-safe sunscreen, a towel, and a water bottle. Everything else is provided by us.' },
  { question: 'Can I cancel or reschedule my lesson?', answer: 'Yes. We offer flexible rescheduling up to 24 hours before your session at no extra charge. Contact us via WhatsApp for any last-minute changes.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[
    { name: 'Home',          href: '/' },
    { name: 'Private Surf Lessons', href: '/private-surf-lessons-cocoa-beach' },
  ]} />
  <ProductSchema
    slot="head"
    name="Private Surf Lesson Cocoa Beach"
    description="One-on-one private surf lesson in Cocoa Beach, Florida. Personalized coaching for all levels from certified instructors at Cocosol Surf Lessons."
    price="75"
    url="/private-surf-lessons-cocoa-beach"
    image="/images/private-surf-lessons-cocoa-beach-one-on-one.webp"
  />
  <FAQSchema slot="head" items={faqs} />

  <!-- HERO -->
  <Hero
    title="Private Surf Lessons Cocoa Beach — One-on-One Coaching for Every Level"
    image={heroImg}
    imageAlt="Private surf lessons Cocoa Beach one-on-one coaching on the beach"
    breadcrumb={{ label: 'Surf Lessons', href: '/' }}
    cta={{ label: 'Check Availability', href: '#book' }}
    height="large"
  />

  <!-- TRUST BAR -->
  <TrustBar items={trustItems} />

  <!-- PRICING -->
  <LessonPricing
    eyebrow="Pricing"
    title="Simple, All-Inclusive Pricing"
    lead1="One-on-one coaching from a certified instructor. Everything you need is included — board, gear, and full attention for 1 to 2 hours."
    lead2="Book a single session or save with a multi-lesson pack. All sessions are valid for 30 days from purchase."
    rows={priceRows}
    altLinks={[
      { label: 'Group Lessons from $60', href: '/group-surf-lessons-cocoa-beach' },
      { label: 'Surf Coaching from $75', href: '/surf-coaching-cocoa-beach' },
    ]}
    cardLabel="Private Lesson"
    cardFrom="$75"
    cardUnit="/ session · 1 person"
    cardIncludes={[
      'Certified instructor (1-on-1)',
      '1-to-2-hour session',
      'Surfboard & foam guard',
      'Beach safety briefing',
      'Photos available on request',
    ]}
    ctaLabel="Book Your Lesson"
    ctaHref="#book"
  />

  <!-- GEAR INCLUDED -->
  <GearIncluded
    eyebrow="All-inclusive"
    title="Everything You Need Is Included"
    subtitle="No rental fees. No extra charges. Show up ready to surf — we handle the rest."
    gear={gear}
    subblocks={subblocks}
  />

  <!-- COMPARE COLUMNS -->
  <CompareColumns
    eyebrow="Make the right call"
    title="Private Lesson vs. Group Lesson"
    subtitle="Both are great ways to surf. The right choice depends on how fast you want to progress and the experience you're after."
    left={compareLeft}
    right={compareRight}
    note="Not sure which is right for you?"
    noteLink={{ label: 'Talk to us on WhatsApp', href: 'https://wa.me/13212180272' }}
  />

  <!-- AUDIENCE CARDS -->
  <AudienceCards
    eyebrow="Who it's for"
    title="Who Are Private Lessons For?"
    subtitle="Our instructors adapt to whoever shows up — complete first-timers to frustrated intermediates."
    cards={audienceCards}
  />

  <!-- HOW IT WORKS -->
  <HowItWorks
    eyebrow="Step by step"
    title="What to Expect in Your Session"
    subtitle="No experience needed. Here's exactly how your private surf lesson unfolds from start to finish."
    steps={steps}
    footer="Most first-time surfers stand up on their board within the first session."
  />

  <!-- SPLIT CONTENT — instructor story -->
  <SplitContent
    eyebrow="Your instructor"
    title="Experienced Instructors Who Surf These Waves Every Day"
    body={[
      'Every instructor at Cocosol Surf Lessons is certified, CPR-trained, and has spent years teaching on the waves of Cocoa Beach. They know the breaks, the tides, and exactly how to read a student\'s technique from the first wave.',
      'Your instructor doesn\'t just watch from the beach — they\'re in the water with you, positioning boards, timing waves, and delivering real-time corrections that make the difference between trying and actually surfing.',
    ]}
    image={instructorImg}
    imageAlt="Certified surf instructor coaching a student during a private lesson in Cocoa Beach"
    bg="white"
    ctaLabel="Check Availability"
    ctaHref="#book"
  />

  <!-- TESTIMONIALS -->
  <Testimonials
    title="What Our Students Say About Private Surf Lessons"
    intro="One-on-one students progress fastest, and it shows in their feedback: most stand up within the first session and leave knowing how to read the water on their own."
    items={[
      {
        name: 'Stephanie Smith',
        role: 'First-time surfer',
        text: 'Best experience on our whole vacation! My instructor was awesome — kind and patient. He prepared us fully on land, so when we hit the ocean, everyone stood up. Highly recommend!',
      },
      {
        name: 'Jess Armijo',
        role: 'Intermediate surfer',
        text: "I've spent years underwater as a diver but surfing was a completely different challenge. My instructor broke everything down perfectly — pop-up, reading the wave, weight distribution. By the end of the session I was standing. Worth every penny.",
      },
    ]}
  />

  <!-- FAQ -->
  <section class="psl-faq">
    <div class="psl-faq-wrap">
      <h2 class="psl-faq-title">Frequently Asked Questions</h2>
      <FAQ items={faqs} columns={1} />
    </div>
  </section>

  <!-- BOOKING WIZARD -->
  <section id="book" class="psl-book" style="scroll-margin-top: 96px;">
    <div class="psl-book-wrap">
      <div class="psl-book-head">
        <span class="psl-book-eyebrow">Ready to Ride?</span>
        <h2 class="psl-book-title">Book Your Private Lesson</h2>
        <p class="psl-book-sub">Choose your session length, pick a date and time, and you're set. All gear and a certified instructor included.</p>
      </div>
      <div class="psl-book-wizard">
        <BookingWizard filterGroup="private-lessons" client:idle />
      </div>
      <p class="psl-book-note">Secure payments · Certified instructors · Flexible rescheduling</p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <FinalCTA
    bgImage={ctaBgImg}
    bgImageAlt="Surfer catching a wave at Cocoa Beach Florida"
    title="Your First Wave Is Closer Than You Think"
    subtitle="Book a private lesson and stand up on a surfboard today. Spots fill fast — secure yours before they're gone."
    primaryCta={{ label: 'Book Now', href: '#book' }}
    secondaryCta={{ label: 'Ask a Question', href: 'https://wa.me/13212180272' }}
    meta={[
      { icon: '✓', text: 'Certified instructors' },
      { icon: '✓', text: 'All equipment included' },
      { icon: '✓', text: 'Flexible rescheduling' },
    ]}
  />

  <!-- SEO INTERNAL LINKS -->
  <section class="psl-links">
    <div class="psl-links-wrap">
      <h2 class="psl-links-title">Also Available at Cocosol Surf Lessons</h2>
      <div class="psl-links-list">
        {[
          { l: 'Surf Lessons in Cocoa Beach',     h: '/' },
          { l: 'Group Surf Lessons Cocoa Beach',  h: '/group-surf-lessons-cocoa-beach' },
          { l: 'Surf Coaching Cocoa Beach',       h: '/surf-coaching-cocoa-beach' },
          { l: 'Surf School in Cocoa Beach',      h: '/best-surf-school-cocoa-beach' },
        ].map(x => (
          <a href={x.h} data-astro-prefetch="viewport" class="psl-link">{x.l}</a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── FAQ ─────────────────────────────────────────────────────────────── */
  .psl-faq {
    background: #EFF9FB;
    padding: 80px 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  .psl-faq-wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .psl-faq-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 600;
    color: var(--c-heading);
    margin-bottom: 36px;
    line-height: 1.1;
  }

  /* ── Booking ─────────────────────────────────────────────────────────── */
  .psl-book {
    background: #fff;
    padding: 80px 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  .psl-book-wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .psl-book-head { text-align: center; margin-bottom: 36px; }
  .psl-book-eyebrow {
    display: inline-block;
    background: rgba(0,188,212,.10);
    color: #00838F;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .psl-book-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 600;
    color: var(--c-heading);
    margin-bottom: 10px;
    line-height: 1.1;
  }
  .psl-book-sub {
    font-size: 1rem;
    color: var(--c-muted);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.65;
  }
  .psl-book-wizard { margin-bottom: 16px; }
  .psl-book-note {
    text-align: center;
    font-size: .85rem;
    color: #9ab;
  }

  /* ── SEO links ───────────────────────────────────────────────────────── */
  .psl-links {
    background: #f9fafb;
    border-top: 1px solid #e5e7eb;
    padding: 40px 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  .psl-links-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .psl-links-title {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 16px;
  }
  .psl-links-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .psl-link {
    padding: 8px 18px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    font-size: .88rem;
    color: var(--c-muted);
    font-weight: 500;
    text-decoration: none;
    transition: border-color .2s, color .2s;
  }
  .psl-link:hover {
    border-color: rgba(0,188,212,.4);
    color: #00838F;
  }

  @media (max-width: 600px) {
    .psl-faq, .psl-book { padding: 60px 0; }
    .psl-faq-wrap, .psl-book-wrap, .psl-links-wrap { padding: 0 20px; }
  }
</style>
