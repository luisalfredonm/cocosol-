---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import { seoData } from '../lib/seo'
const seo = seoData.surfPackages
const packages = [
  { days: '3 Days', title: '3 Days Pura Vida Surf Package', href: '/3-days-pura-vida-surf-package', price: '$245', lessons: '3 Surf Lessons', trip: '1 Surf Trip', features: ['90 minutes surf lesson','Professional, certified instructor','Surfboard included','Rash guard','Safety briefing','Photos available on request'] },
  { days: '5 Days', title: '5 Days Pura Vida Surf Package', href: '/5-days-pura-vida-surf-package', price: '$405', lessons: '4 Surf Lessons', trip: '1 Surf Trip', features: ['90 minutes surf lesson','Professional, certified instructor','Surfboard included','Rash guard','Safety briefing','Photos available on request'], popular: true },
  { days: '7 Days', title: '7 Days Pura Vida Surf Package', href: '/7-days-surf-camp-tamarindo', price: '$565', lessons: '6 Surf Lessons', trip: '1 Surf Trip', features: ['90 minutes surf lesson','Professional, certified instructor','Surfboard included','Rash guard','Safety briefing','Photos available on request'] },
]
---
<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <Hero title="Surf Packages In Tamarindo" subtitle="Choose from our 3, 5, or 7-day surf packages designed for beginners and intermediate surfers looking for progress and fun." image="/images/surf-packages-hero.jpg" imageAlt="Surf packages Tamarindo Costa Rica" height="medium"/>

  <section class="py-16 container mx-auto px-4">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Pura Vida Surf Packages</h2>
        <p class="text-gray-700 leading-relaxed mb-4">If you are looking for flexible, professional, and results-driven <strong>surf packages in Tamarindo</strong>, our Pura Vida Surf Packages are designed exactly for you. These packages are ideal for travelers who want to focus purely on surfing, skill progression, and enjoying the ocean in Tamarindo, Costa Rica — without committing to accommodations or a full surf camp experience.</p>
        <p class="text-gray-700 leading-relaxed mb-4">Our surf packages in Tamarindo are available in 3-day, 5-day, and 7-day options, giving you the freedom to choose a program that fits your schedule and surf goals. Whether you are a complete beginner or an intermediate surfer looking to improve technique and confidence, our structured packages provide consistent feedback every day.</p>
        <p class="text-gray-700 leading-relaxed mb-6">All lessons are led by certified local surf instructors who know Tamarindo's waves, tides, and beach conditions inside and out. Safety is always a priority, and every session includes instruction on proper technique, paddling, wave selection, positioning, and surf etiquette.</p>

        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div>
            <h3 class="font-bold text-gray-900 mb-3">What is a Surf Package?</h3>
            <ul class="space-y-2">{['Multiple surf lessons','Better value than single lessons','Structured learning plan','Ideal for short stays in Tamarindo'].map(i=><li class="flex items-center gap-2 text-sm text-gray-600"><svg class="w-4 h-4 text-teal-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{i}</li>)}</ul>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-3">Who Can Take Surf Lessons?</h3>
            <ul class="space-y-2">{['Beginners','Kids','Intermediate Surfers','Families'].map(i=><li class="flex items-center gap-2 text-sm text-gray-600"><svg class="w-4 h-4 text-teal-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{i}</li>)}</ul>
          </div>
        </div>
      </div>

      <div>
        <div class="bg-teal-50 border border-teal-100 rounded-2xl p-6">
          <h3 class="font-bold text-gray-900 mb-4">What You'll Learn:</h3>
          {['How to pop up','Wave timing','Basic paddling','Safety rules','Surf etiquette','How to handle the board'].map(i=>(
            <div class="flex items-center gap-2 text-sm text-gray-700 mb-2">
              <svg class="w-4 h-4 text-teal-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{i}
            </div>
          ))}
          <a href="/book-now" class="mt-4 btn-primary block text-center">Choose Your Surf Lesson</a>
          <div class="flex items-center gap-2 mt-3 text-sm text-gray-600">
            <svg class="w-4 h-4 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            If you need help: <a href="tel:+50661987851" class="font-semibold text-teal-600">+506 6198-7851</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Package Comparison -->
  <section class="py-16 bg-teal-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold text-gray-900 text-center mb-3">Package Comparison</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">We have the perfect option for travelers looking for high-quality Tamarindo surf lessons without booking a full surf camp.</p>
      <div class="grid md:grid-cols-3 gap-6">
        {packages.map(p => (
          <div class={`bg-white rounded-2xl p-6 border relative ${p.popular ? 'border-teal-500 ring-2 ring-teal-500' : 'border-gray-200'}`}>
            {p.popular && <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-teal-500 text-white text-xs font-bold px-4 py-1 rounded-full whitespace-nowrap">Most Popular</span>}
            <h3 class="font-bold text-gray-900 text-lg mb-1">{p.title}</h3>
            <ul class="space-y-2 mt-4 mb-5">
              {[p.lessons, p.trip, ...p.features].map(f => <li class="flex items-center gap-2 text-sm text-gray-600"><svg class="w-4 h-4 text-teal-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{f}</li>)}
            </ul>
            <p class="text-2xl font-bold text-teal-600 mb-4">From {p.price}</p>
            <a href={p.href} class="btn-primary block text-center text-sm">View Package Details</a>
          </div>
        ))}
      </div>
      <p class="text-center text-gray-500 text-sm mt-6">Our Tamarindo surf lessons fill up fast — especially during peak season — so we recommend reserving your spot in advance.</p>
    </div>
  </section>

  <NeedHelp/>
</BaseLayout>
