---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import Sidebar from '../components/ui/Sidebar.astro'
import VideoSection from '../components/sections/VideoSection.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BookingWizard from '../components/booking/BookingWizard'
import { seoData } from '../lib/seo'

import heroImg   from '../assets/images/surf-school-tamarindo-private-class.webp'
import gallery1  from '../assets/images/surf-school-tamarindo-beach-lesson.webp'
import gallery2  from '../assets/images/surf-school-tamarindo-students.webp'
import gallery3  from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import gallery4  from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'
import videoBg   from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'

const seo = seoData.privateLessons

const perfectFor = [
  'Beginners who want one-on-one attention and a safe introduction to surfing',
  'Intermediate surfers looking to improve technique and progress faster',
  'Travelers who prefer a personalized experience instead of group lessons',
  'Surfers who want guaranteed waves and full focus from an instructor',
  'Families, couples, and anyone who wants a fully customized surf session',
]

const cols = [
  { h: 'Who Can Take?',    items: ['Beginners', 'Kids', 'Intermediate Surfers', 'Families'] },
  { h: "What's Included",  items: ['90-minute surf lesson', 'Professional certified instructor', 'Foam guard', 'Safety briefing', 'Surfboard included', 'Photos on request'] },
  { h: 'What to Bring',    items: ['Swimwear', 'Sunscreen (reef-safe)', 'Towel', 'Water bottle'] },
]

const faqs = [
  { question: 'What is included in a private surf lesson?', answer: 'Every private lesson includes a certified instructor, surfboard, foam guard, safety briefing on the beach, and 90 minutes of one-on-one instruction in the water. Photos are available on request.' },
  { question: 'Are private surf lessons suitable for beginners?', answer: "Absolutely! Private lessons are perfect for beginners because you get 100% of the instructor's attention. You'll progress much faster than in a group setting." },
  { question: 'How long does each private surf lesson last?', answer: 'Each session is 90 minutes, including a land safety briefing and time in the water.' },
  { question: 'Do I need to bring my own surfboard?', answer: 'No — a surfboard is included with every lesson. We provide the right board for your level and size.' },
]

const gallery = [gallery1, gallery2, gallery3, gallery4]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <FAQSchema slot="head" items={faqs} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Private Surf Lessons Tamarindo — A Personalized Surfing Experience in Costa Rica"
    image={heroImg}
    imageAlt="Private surf lessons Tamarindo one on one"
    breadcrumb={{ label: 'Surf Lessons', href: '/tamarindo-surf-lessons' }}
    cta={{ label: 'Check Availability', href: '#book' }}
    height="large"
  />

  <!-- ── MAIN CONTENT ───────────────────────────────────────────────────────── -->
  <section class="py-20 container mx-auto px-4">
    <div class="grid lg:grid-cols-3 gap-12">

      <!-- Left col -->
      <div class="lg:col-span-2">

        <!-- Intro text -->
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase">1-on-1 Coaching</span>
        <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Private Surf Lessons Tamarindo — Personalized One-on-One Coaching</h2>
        <p class="text-gray-700 leading-relaxed mb-4">Looking for the best one-on-one surf coaching in Costa Rica? Our <strong>private surf lessons in Tamarindo</strong> are designed for complete adaptability and faster progression. Whether you're starting your first steps on a surfboard or looking to refine your technique, our experienced instructors are here to help you achieve your goals.</p>
        <p class="text-gray-700 leading-relaxed mb-8">Every session provides customized feedback, safety guidance, and a step-by-step experience tailored to your level. Sessions are scheduled around the best tides and waves to maximize your time in the water.</p>

        <p class="text-gray-700 leading-relaxed mb-8">Unlike group sessions, a private lesson means your instructor watches every move you make and adjusts the coaching in real time. From your pop-up technique to reading the waves, every minute of the 90-minute session is dedicated exclusively to you. Most students who choose one-on-one coaching progress twice as fast compared to shared lessons — and they feel more confident and safer in the water from day one.</p>

        <!-- Perfect For -->
        <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 mb-8">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Perfect For:</h3>
          <ul class="space-y-3">
            {perfectFor.map(i => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="w-5 h-5 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </span>
                {i}
              </li>
            ))}
          </ul>
        </div>

        <!-- 3-col cards -->
        <div class="grid md:grid-cols-3 gap-4 mb-8">
          {cols.map(col => (
            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-4 text-sm uppercase tracking-wide">{col.h}</h3>
              <ul class="space-y-2">
                {col.items.map(i => (
                  <li class="flex items-center gap-2.5 text-sm text-gray-600">
                    <span class="w-4 h-4 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0">
                      <svg class="w-2.5 h-2.5 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    {i}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Best time info box -->
        <div class="border-l-4 border-[#00BCD4] bg-[#00BCD4]/5 rounded-r-2xl pl-5 pr-6 py-4 mb-8">
          <h3 class="font-bold text-gray-900 mb-1">Best Time for Your Surf Lesson in Tamarindo</h3>
          <p class="text-gray-600 text-sm leading-relaxed">The best time for learning is the morning, early afternoon, when the waves are smoother and the wind is lighter. We schedule lessons based on tide and wave conditions to guarantee the best experience.</p>
        </div>

        <!-- FAQ -->
        <FAQ items={faqs} columns={1}/>
      </div>

      <!-- Right col: Sidebar -->
      <div>
        <Sidebar
          price="$90"
          priceLabel="/ 90 Minutes"
          includes={['Surfboard included', 'Professional, certified instructor', 'Foam guard', 'Safety briefing', 'Photos available on request']}
          ctaLabel="Check Availability"
          ctaHref="#book"
        />
      </div>

    </div>
  </section>

  <!-- ── VIDEO SECTION ──────────────────────────────────────────────────────── -->
  <VideoSection
    title="See What a One-on-One Surf Session Looks Like in Tamarindo"
    subtitle="Watch what a private lesson looks like — personalized coaching, one-on-one attention, and real progress on the waves of Tamarindo Beach."
    bgImage={videoBg}
    cta={{ label: 'Check Availability', href: '#book' }}
  />

  <!-- ── GALLERY ─────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <!-- Images -->
        <div class="grid grid-cols-2 gap-3">
          {gallery.map((img, i) => (
            <div class={`overflow-hidden rounded-2xl shadow-md ${i % 2 === 1 ? 'mt-6' : ''}`}>
              <Image
                src={img}
                alt="Private surf lessons Tamarindo gallery"
                class="w-full h-44 object-cover hover:scale-105 transition-transform duration-500"
                widths={[200, 400]}
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          ))}
        </div>

        <!-- Text -->
        <div>
          <span class="section-label mb-3 block">Our Gallery</span>
          <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Surf Moments from Your Private Session in Tamarindo</h2>
          <p class="text-gray-600 leading-relaxed text-sm">Explore our gallery and see the real moments captured during one-on-one sessions on Tamarindo Beach. These images show the personalized instruction, safety techniques, and the joy that make every session so unique.</p>
          <a href="#book" class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-[#00BCD4] text-white font-bold rounded-2xl hover:bg-[#0097A7] transition-colors text-sm shadow-lg shadow-[#00BCD4]/25">
            Book Your Session →
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── BOOKING WIZARD ─────────────────────────────────────────────────────── -->
  <section id="book" class="py-16 bg-white min-h-[800px]" style="scroll-margin-top: 96px;">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Ready to Ride?</span>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Book Your Private Lesson</h2>
        <p class="text-gray-500 max-w-md mx-auto">Select your date and time below. Your private lesson is pre-selected — just pick when you want to surf.</p>
      </div>
      <div class="max-w-4xl mx-auto">
        <BookingWizard preselectedType="private" client:idle />
      </div>
      <p class="text-center mt-4 text-sm text-gray-400">Secure payments · Trusted instructors · Flexible rescheduling</p>
    </div>
  </section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <Testimonials items={[
    { name: 'Stephanie Smith', role: 'Designer', text: 'Best experience on our whole vacation! Franky was AWESOME! He was kind and patient. Fully prepared us on land, so when we hit the ocean, everyone was successful.' },
    { name: 'Jess Armijo',     role: 'Diver',    text: 'In facilisi odio metus nunc himenaeos semper consectetur tempus adipiscing elit. Ut hac habitant feugiat cursus lectus faucibus.' },
  ]} title="What Our Students Say About Private Surf Lessons"/>

  <!-- ── NEED HELP ──────────────────────────────────────────────────────────── -->
  <NeedHelp/>

  <!-- ── SEO INTERNAL LINKS ─────────────────────────────────────────────────── -->
  <section class="py-10 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <h2 class="text-sm font-bold text-gray-500 mb-4 uppercase tracking-widest">Also Available at Pura Vida Surf School</h2>
      <div class="flex flex-wrap gap-2">
        {[
          { l: 'Semi-Private Surf Lessons', h: '/semi-private-surf-lessons-tamarindo' },
          { l: 'Group Surf Lessons',        h: '/group-surf-lessons-tamarindo' },
          { l: 'Surf Packages',             h: '/tamarindo-surf-packages' },
          { l: 'Surf Camp Tamarindo',       h: '/surf-camp-tamarindo' },
        ].map(x => (
          <a href={x.h} data-astro-prefetch="viewport"
            class="px-4 py-2 bg-white hover:bg-[#00BCD4]/8 border border-gray-200 hover:border-[#00BCD4]/40 hover:text-[#00BCD4] rounded-full text-sm text-gray-600 transition-colors font-medium">
            {x.l}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
