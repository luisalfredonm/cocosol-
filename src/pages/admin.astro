                  <div class="adm-dialog-sec-label">Customer</div>
                  <div style="display:flex;align-items:flex-start;gap:12px">
                    <div class="adm-avatar" style={`background:${avBg};color:${avFg};width:42px;height:42px;font-size:14px;flex-shrink:0`}>{initials}</div>
                    <div style="display:flex;flex-direction:column;gap:4px;min-width:0">
                      <span style="font-weight:700;color:#0F172A;font-size:15px">{b.customer_name}</span>
                      <a href={`mailto:${b.customer_email}`} style="font-size:13px;color:#2563EB;text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{b.customer_email}</a>
                      {b.customer_phone && <span style="font-size:13px;color:#475569">{b.customer_phone}</span>}
