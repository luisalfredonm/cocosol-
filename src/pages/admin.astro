                            <td style="font-weight:600">{new Date(s.start_date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td>
                            <td>{new Date(s.end_date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</td>
                            <td style="font-weight:700;color:#0097A7">${Number(s.price_per_person_usd).toFixed(2)}</td>
                            <td>{assignedRooms} room{assignedRooms !== 1 ? 's' : ''}</td>
                            <td><span style={`font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;background:${s.is_active?'#D1FAE5':'#FEE2E2'};color:${s.is_active?'#065F46':'#991B1B'}`}>{s.is_active?'Active':'Inactive'}</span></td>
                            <td>
                              <form method="POST" style="display:inline">
                                <input type="hidden" name="action" value="delete_camp_session" />
                                <input type="hidden" name="id" value={s.id} />
                                <button type="submit" class="adm-btn-ghost" onclick="return confirm('Delete this session and all its bookings?')">Delete</button>
                              </form>
                            </td>
                          </tr>
                        )
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- ══ TAB: CAMP BOOKINGS ══════════════════════════════════════════ -->
        {activeTab === 'camp-bookings' && (
          <div class="adm-tab" style="display:flex;flex-direction:column;gap:16px">
            <div class="adm-card">
              {campBookings.length === 0 ? (
                <div class="adm-empty">
                  <p class="adm-empty-title">No camp bookings yet</p>
                  <p class="adm-empty-sub">Bookings will appear here once clients reserve a camp</p>
                </div>
              ) : (
                <div style="overflow-x:auto">
                  <table class="adm-tbl">
                    <thead>
                      <tr><th>Guest</th><th>Camp</th><th>Room</th><th>Dates</th><th>Guests</th><th>Charged</th><th>Full Total</th><th>Payment</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                      {campBookings.map((b: any) => (
                        <tr>
                          <td>
                            <div style="font-weight:700;color:#0F172A">{b.guest1_name}</div>
                            <div style="font-size:11px;color:#94A3B8">{b.guest1_email}</div>
                            <div style="font-size:11px;color:#94A3B8">{b.guest1_phone}</div>
                            {(b.guests_json ?? []).slice(1).map((g: any) => (
                              <div style="font-size:11px;color:#64748B;margin-top:2px">+ {g.name}{g.email ? ` · ${g.email}` : ''}</div>
                            ))}
                          </td>
                          <td>
                            <span style="font-size:11px;font-weight:700;padding:2px 7px;border-radius:999px;background:#E0F7FA;color:#006064">
                              Custom Camp
                            </span>
                          </td>
                          <td style="font-weight:600">{b.camp_rooms?.name ?? '—'}</td>
                          <td style="font-size:12px">
                            {b.camp_sessions ? (
                              <span>{new Date(b.camp_sessions.start_date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'})} → {new Date(b.camp_sessions.end_date+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span>
                            ) : '—'}
                          </td>
                          <td>{b.persons}</td>
                          <td style="font-weight:700;color:#0097A7">${Number(b.charged_amount_usd).toFixed(2)}</td>
                          <td>${Number(b.full_amount_usd).toFixed(2)}</td>
                          <td>
                            <span style="font-size:11px;background:#F1F5F9;padding:2px 7px;border-radius:999px;color:#475569">
                              {b.payment_mode === 'deposit' ? `Deposit ${Math.round((b.charged_amount_usd/b.full_amount_usd)*100)}%` : 'Full'}
                            </span>
                          </td>
                          <td>
                            <span style={`font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;background:${b.status==='confirmed'?'#D1FAE5':b.status==='pending'?'#FEF9C3':'#FEE2E2'};color:${b.status==='confirmed'?'#065F46':b.status==='pending'?'#A16207':'#991B1B'}`}>
                              {b.status}
                            </span>
                          </td>
                          <td>
                            <form method="POST" style="display:flex;gap:4px">
                              <input type="hidden" name="action" value="update_camp_booking_status" />
                              <input type="hidden" name="id" value={b.id} />
                              <select name="status" class="adm-input" style="font-size:12px;padding:4px 8px;width:auto">
                                <option value="pending" selected={b.status==='pending'}>Pending</option>
                                <option value="confirmed" selected={b.status==='confirmed'}>Confirmed</option>
                                <option value="cancelled" selected={b.status==='cancelled'}>Cancelled</option>
                              </select>
                              <button type="submit" class="adm-btn adm-btn-teal" style="font-size:12px;padding:4px 10px">Save</button>
                            </form>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- ══ TAB: CAMP SETTINGS ══════════════════════════════════════════ -->
        {activeTab === 'camp-settings' && (
          <div class="adm-tab" style="display:flex;flex-direction:column;gap:16px;max-width:480px">
            <div class="adm-card adm-card-p">
              <div style="font-size:15px;font-weight:700;color:#0F172A;margin-bottom:4px">Payment Configuration</div>
              <div style="font-size:12.5px;color:#94A3B8;line-height:1.5;margin-bottom:20px">
                Choose whether clients pay the full amount or a deposit at booking time. Changes take effect immediately for new bookings.
              </div>
              <form method="POST" style="display:flex;flex-direction:column;gap:16px">
                <input type="hidden" name="action" value="save_camp_settings" />
                <div>
                  <label class="adm-label">Payment Mode</label>
                  <div style="display:flex;flex-direction:column;gap:8px;margin-top:6px">
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:12px 14px;border:1.5px solid #E2E8F0;border-radius:12px;transition:border-color 0.15s" id="mode-full-label">
                      <input type="radio" name="payment_mode" value="full" checked={campSettings.payment_mode === 'full'} style="accent-color:#0097A7" onchange="document.getElementById('deposit-row').style.opacity='0.4'" />
                      <div>
                        <div style="font-size:13px;font-weight:600;color:#0F172A">Full payment</div>
                        <div style="font-size:11.5px;color:#94A3B8">Client pays 100% at booking</div>
                      </div>
                    </label>
                    <label style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:12px 14px;border:1.5px solid #E2E8F0;border-radius:12px;transition:border-color 0.15s">
                      <input type="radio" name="payment_mode" value="deposit" checked={campSettings.payment_mode === 'deposit'} style="accent-color:#0097A7" onchange="document.getElementById('deposit-row').style.opacity='1'" />
                      <div>
                        <div style="font-size:13px;font-weight:600;color:#0F172A">Deposit</div>
                        <div style="font-size:11.5px;color:#94A3B8">Client pays a % now, rest at check-in</div>
                      </div>
                    </label>
                  </div>
                </div>
                <div id="deposit-row" style={`opacity:${campSettings.payment_mode === 'deposit' ? '1' : '0.4'}`}>
                  <label class="adm-label">Deposit Percentage</label>
                  <div style="display:flex;align-items:center;gap:8px">
                    <input type="number" name="deposit_percentage" min="10" max="100" value={campSettings.deposit_percentage} class="adm-input" style="width:100px" />
                    <span style="font-size:13px;color:#64748B">%</span>
                  </div>
                  <div style="font-size:11.5px;color:#94A3B8;margin-top:4px">
                    Example: with 30% deposit on a $798 booking → client pays $239.40 now
                  </div>
                </div>
                <button type="submit" class="adm-btn adm-btn-teal" style="width:fit-content">Save Settings</button>
              </form>
            </div>
          </div>
        )}

        {activeTab === 'payment-settings' && (
          <PaymentConfig authToken={ADMIN_PASSWORD} />
        )}

        {activeTab === 'booking-settings' && (
          <BookingSettings authToken={ADMIN_PASSWORD} />
        )}

      </main>
    </div>
  </div>
)}

<script>
  // Cerrar dialog al hacer click en el backdrop
  document.addEventListener('click', e => {
    if (e.target instanceof HTMLDialogElement) e.target.close()
  })

  document.addEventListener('click', e => {
    const target = e.target
    if (!(target instanceof HTMLElement)) return

    const addButton = target.closest('[data-add-tier-row]')
    if (addButton) {
      const editor = addButton.closest('[data-tier-editor]')
      const rows = editor?.querySelector('[data-tier-rows]')
      if (!rows) return

      const row = document.createElement('div')
      row.className = 'adm-tier-grid adm-tier-row'
      row.innerHTML = `
        <input type="number" name="price_tier_min" min="1" class="adm-input" placeholder="1" />
        <input type="number" name="price_tier_max" min="1" class="adm-input" placeholder="No limit" />
        <input type="text" name="price_tier_label" class="adm-input" placeholder="Group" />
        <input type="number" name="price_tier_price" min="0" step="0.01" class="adm-input" placeholder="65" />
        <select name="price_tier_type" class="adm-input">
          <option value="per_person">Per person</option>
          <option value="total">Total</option>
        </select>
        <button type="button" class="adm-tier-remove" data-remove-tier-row title="Remove tier">×</button>
      `
      rows.appendChild(row)
      const firstInput = row.querySelector('input')
      if (firstInput instanceof HTMLInputElement) firstInput.focus()
      return
    }

    const removeButton = target.closest('[data-remove-tier-row]')
    if (removeButton) {
      removeButton.closest('.adm-tier-row')?.remove()
    }
  })
</script>
</body>
</html>
