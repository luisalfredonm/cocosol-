                                      <td>
                                        <span style="font-weight:600;color:#0F172A">{ctName}</span>
                                      </td>
                                      <td>
                                        <span style={`background:${timeBg};color:${timeFg};font-size:12.5px;font-weight:800;padding:4px 10px;border-radius:8px;white-space:nowrap;display:inline-block`}>
                                          {formatTime(b.start_time)}
                                        </span>
                                      </td>
                                      <td>
                                        <span style={`font-size:12px;color:${color.border};font-weight:600`}>↳ family group</span>
                                      </td>
                                      <td style="text-align:center">
                                        <span style="font-weight:800;color:#334155;font-size:15px">{b.participants}</span>
                                      </td>
                                      <td>
                                        <span style="font-weight:800;color:#0097A7;font-size:14px">{formatCurrency(Number(b.total_amount))}</span>
                                      </td>
                                      <td>
                                        {b.status === 'pending' && b.payment_method === 'on-site' ? (
                                          <span class="adm-pill" style="background:#FEF3C7;color:#92400E;border:1px solid #FCD34D">⚠ Awaiting Payment</span>
                                        ) : (
                                          <span class={`adm-pill adm-pill-${b.status}`}>{b.status}</span>
                                        )}
                                      </td>
                                      <td>
                                        <div style="display:flex;align-items:center;gap:6px">
                                          <button type="button" class="adm-btn-view" onclick={`document.getElementById('bd-${b.id}').showModal()`}>
