                      <div style="font-size:10.5px;color:#94A3B8;text-transform:uppercase;letter-spacing:0.09em;font-weight:700">Booked on</div>
                      <div style="font-size:13px;font-weight:600;color:#475569;margin-top:3px">{bookedOn}</div>
                    </div>
                  </div>
                </div>

                {/* Acciones */}
                {(b.status !== 'confirmed' || b.status !== 'cancelled') && (
                  <div class="adm-dialog-actions">
                    {b.status === 'pending' && b.payment_method === 'on-site' && (
