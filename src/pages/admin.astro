                <div class="adm-stat-value" style="color:#16A34A">{stats.confirmed}</div>
              </div>
            </div>
            <div class="adm-stat">
              <div class="adm-stat-icon" style="background:#FEFCE8">
                <svg style="color:#CA8A04" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
