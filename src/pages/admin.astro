            {bookingsByDate.map((group, groupIdx) => {
              const color = DAY_COLORS[groupIdx % DAY_COLORS.length]
              const dateObj = new Date(group.date + 'T12:00:00')
              const dayLabel = dateObj.toLocaleDateString('en-US', { weekday: 'long' })
              const dateLabel = dateObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
              const confirmedRevenue = group.items.filter(b => b.status === 'confirmed').reduce((s, b) => s + Number(b.total_amount), 0)
              const confirmedCount = group.items.filter(b => b.status === 'confirmed').length
              const pendingCount  = group.items.filter(b => b.status === 'pending').length
