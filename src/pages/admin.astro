                                            )}
                                            {b.status !== 'cancelled' && (
                                              <button type="submit" name="status" value="cancelled" class="adm-btn adm-btn-cancel">✗ Cancel</button>
                                            )}
                                          </form>
                                        </div>
                                      </td>
                                    </tr>
                                  )
                                })}
                                {/* Separador después del grupo familiar */}
                                <tr><td colSpan={8} style="padding:0;height:2px;background:#E2E8F0"></td></tr>
                              </>
                            )
                          }
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              )
            })}

          {/* Dialogs de detalle — uno por booking, pre-renderizados */}
          {sortedBookings.map(b => {
            const ct = classTypesById[b.class_type_id]
            const ctName = ct?.name ?? b.class_type_id
            const initials = getInitials(b.customer_name)
            const [avBg, avFg] = avatarColor(b.customer_name)
            const bDateFull = new Date(b.booking_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })
            const bookedOn = b.created_at ? new Date(b.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'
            const pricePerPerson = ct?.price_per_person ?? (Number(b.total_amount) / Math.max(b.participants, 1))
            return (
              <dialog id={`bd-${b.id}`} class="adm-dialog">

                {/* Header */}
                <div class="adm-dialog-hd">
                  <div>
                    <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.13em;color:#94A3B8;margin-bottom:6px">Booking Detail</div>
                    <div style="display:flex;align-items:center;gap:10px">
                      <span style="font-family:ui-monospace,monospace;font-size:18px;font-weight:800;color:#0F172A;letter-spacing:-0.01em">#{b.id.slice(-8).toUpperCase()}</span>
