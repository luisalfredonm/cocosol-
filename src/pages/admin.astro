---
export const prerender = false

import { isSupabaseConfigured, missingSupabaseEnv, supabase } from '../lib/supabase'
import { formatCurrency, formatTime, formatPricingTiers } from '../lib/classTypes'
import PaymentConfig from '../components/admin/PaymentConfig.astro'
import BookingSettings from '../components/admin/BookingSettings.astro'
import '../styles/global.css'

const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD ?? 'admin'
const authCookie = Astro.cookies.get('pvss_admin')
const isAuthenticated = authCookie?.value === ADMIN_PASSWORD

const DOW_LABELS = ['', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
const DISABLED_CAMP_TABS = ['camp-bookings', 'camp-rooms', 'camp-sessions', 'camp-settings']
const FLORIDA_PRICE_TIERS_EXAMPLE = `[
  { "min_participants": 1, "max_participants": 1, "price_per_person": 75 },
  { "min_participants": 2, "max_participants": 2, "price_per_person": 70 },
  { "min_participants": 3, "max_participants": null, "price_per_person": 65 }
]`
const DEFAULT_PRICE_TIER_ROWS = [
  { min_participants: 1, max_participants: 1, price_per_person: 75, price_type: 'per_person', label: 'Private' },
  { min_participants: 2, max_participants: 2, price_per_person: 70, price_type: 'per_person', label: 'Semi-private' },
  { min_participants: 3, max_participants: null, price_per_person: 65, price_type: 'per_person', label: 'Group' },
]

function parsePriceTiers(raw: FormDataEntryValue | null) {
  const text = String(raw ?? '').trim()
  if (!text) return null

  try {
    const parsed = JSON.parse(text)
    if (!Array.isArray(parsed)) return null

    return parsed
      .map((tier: any) => ({
        min_participants: Math.max(1, Number(tier.min_participants) || 1),
        max_participants:
          tier.max_participants === null || tier.max_participants === undefined || tier.max_participants === ''
            ? null
            : Math.max(1, Number(tier.max_participants) || 1),
        price_per_person: Math.max(0, Number(tier.price_per_person) || 0),
        price_type: tier.price_type === 'total' ? 'total' : 'per_person',
        label: tier.label ? String(tier.label) : null,
      }))
      .filter((tier: any) => tier.price_per_person > 0)
  } catch {
    return null
  }
}

function stringifyPriceTiers(tiers: any) {
  if (!Array.isArray(tiers) || tiers.length === 0) return ''
  return JSON.stringify(tiers, null, 2)
}

function getTierRows(tiers: any) {
  if (!Array.isArray(tiers) || tiers.length === 0) return []
  return tiers.map((tier: any) => ({
    min_participants: Math.max(1, Number(tier.min_participants) || 1),
    max_participants:
      tier.max_participants === null || tier.max_participants === undefined || tier.max_participants === ''
        ? ''
        : Math.max(1, Number(tier.max_participants) || 1),
    price_per_person: Math.max(0, Number(tier.price_per_person) || 0),
    price_type: tier.price_type === 'total' ? 'total' : 'per_person',
    label: tier.label ? String(tier.label) : '',
  }))
}

function parsePriceTiersFromForm(form: FormData) {
  const usesVisualEditor = form.get('price_tiers_visual') === 'true'
  const mins = form.getAll('price_tier_min')
  const maxes = form.getAll('price_tier_max')
  const prices = form.getAll('price_tier_price')
  const labels = form.getAll('price_tier_label')
  const types = form.getAll('price_tier_type')

  const tiers = mins
    .map((rawMin, index) => {
      const rawPrice = String(prices[index] ?? '').trim()
      if (!rawPrice) return null

      const rawMax = String(maxes[index] ?? '').trim()
      return {
        min_participants: Math.max(1, Number(rawMin) || 1),
        max_participants: rawMax ? Math.max(1, Number(rawMax) || 1) : null,
        price_per_person: Math.max(0, Number(rawPrice) || 0),
        price_type: String(types[index] ?? 'per_person') === 'total' ? 'total' : 'per_person',
        label: String(labels[index] ?? '').trim() || null,
      }
    })
    .filter((tier: any) => tier && tier.price_per_person > 0)
    .sort((a: any, b: any) => a.min_participants - b.min_participants)

  if (usesVisualEditor) return tiers.length > 0 ? tiers : null
  if (tiers.length > 0) return tiers
  return parsePriceTiers(form.get('price_tiers'))
}

function parseSlotCapacity(raw: FormDataEntryValue | null, fallback = 1) {
  const parsed = parseInt(String(raw ?? ''), 10)
  if (Number.isNaN(parsed)) return Math.max(0, fallback)
  return Math.max(0, parsed)
}

function parseBookingMode(raw: FormDataEntryValue | null) {
  return String(raw ?? 'shared') === 'exclusive' ? 'exclusive' : 'shared'
}

// ── POST handlers ──────────────────────────────────────────────────────────
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const action = form.get('action') as string

  if (action === 'login') {
    const password = form.get('password') as string
    if (password === ADMIN_PASSWORD) {
      Astro.cookies.set('pvss_admin', ADMIN_PASSWORD, {
        httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60 * 60 * 8, path: '/',
      })
    }
    return Astro.redirect('/admin')
  }

  if (!isAuthenticated) return Astro.redirect('/admin')
  if (!isSupabaseConfigured) return Astro.redirect('/admin?setup=missing-supabase-env')

  try {
    // ── Camp actions ──────────────────────────────────────────────────────
    if (action === 'upsert_camp_room') {
      const id = form.get('id') as string | null
      const amenitiesRaw = (form.get('amenities') as string ?? '').split(',').map(a => a.trim()).filter(Boolean)
      const payload = {
        name: form.get('name'),
        description: (form.get('description') as string) || null,
        bed_type: form.get('bed_type') || 'Queen',
        capacity: parseInt(form.get('capacity') as string) || 2,
        amenities: amenitiesRaw,
        photo_url: (form.get('photo_url') as string) || null,
        floor_label: (form.get('floor_label') as string) || null,
        is_active: form.get('is_active') === 'true',
        sort_order: parseInt(form.get('sort_order') as string) || 0,
      }
      if (id) await supabase.from('camp_rooms').update(payload).eq('id', id)
      else await supabase.from('camp_rooms').insert(payload)
      return Astro.redirect('/admin?tab=camp-rooms')
    }

    if (action === 'delete_camp_room') {
      await supabase.from('camp_rooms').delete().eq('id', form.get('id') as string)
      return Astro.redirect('/admin?tab=camp-rooms')
    }

    if (action === 'upsert_camp_session') {
      const id = form.get('id') as string | null
      const startDate = form.get('start_date') as string
      const campType = 'custom'
      const nights = parseInt(form.get('nights') as string) || 1
      const startObj = new Date(startDate + 'T12:00:00')
      startObj.setDate(startObj.getDate() + nights)
      const endDate = startObj.toISOString().slice(0, 10)
      const sessionPayload = {
        camp_type: campType,
        start_date: startDate,
        end_date: endDate,
        price_per_person_usd: parseFloat(form.get('price_per_person_usd') as string),
        is_active: form.get('is_active') === 'true',
      }
      let sessionId = id
      if (id) {
        await supabase.from('camp_sessions').update(sessionPayload).eq('id', id)
      } else {
        const { data: newSession } = await supabase.from('camp_sessions').insert(sessionPayload).select('id').single()
        sessionId = newSession?.id
      }
      // Sync rooms
      if (sessionId) {
        const roomIds = (form.getAll('room_ids') as string[]).filter(Boolean)
        await supabase.from('camp_session_rooms').delete().eq('session_id', sessionId)
        if (roomIds.length > 0) {
          await supabase.from('camp_session_rooms').insert(roomIds.map(rid => ({ session_id: sessionId, room_id: rid })))
        }
      }
      return Astro.redirect('/admin?tab=camp-sessions')
    }

    if (action === 'delete_camp_session') {
      await supabase.from('camp_sessions').delete().eq('id', form.get('id') as string)
      return Astro.redirect('/admin?tab=camp-sessions')
    }

    if (action === 'update_camp_booking_status') {
      const { id, status } = Object.fromEntries(form)
      await supabase.from('camp_bookings').update({ status, updated_at: new Date().toISOString() }).eq('id', id)
      return Astro.redirect('/admin?tab=camp-bookings')
    }

    if (action === 'save_camp_settings') {
      await supabase.from('camp_settings').update({
        payment_mode: form.get('payment_mode'),
        deposit_percentage: parseInt(form.get('deposit_percentage') as string) || 30,
        updated_at: new Date().toISOString(),
      }).eq('id', 1)
      return Astro.redirect('/admin?tab=camp-settings')
    }
    // ── End camp actions ──────────────────────────────────────────────────

    if (action === 'update') {
      const id = form.get('id') as string
      const status = form.get('status') as string
      await supabase.from('bookings').update({ status }).eq('id', id)
      return Astro.redirect('/admin?tab=bookings')
    }

    if (action === 'create_class_type') {
      const id = String(form.get('id') ?? '').trim()
      if (!id) return Astro.redirect('/admin?tab=class-types')

      const minParticipants = parseInt(form.get('min_participants_per_booking') as string)
      const maxParticipants = parseInt(form.get('max_participants_per_booking') as string)
      const normalizedMin = Number.isNaN(minParticipants) ? 1 : Math.max(1, minParticipants)
      const normalizedMaxRaw = Number.isNaN(maxParticipants) ? normalizedMin : Math.max(1, maxParticipants)
      const normalizedMax = Math.max(normalizedMin, normalizedMaxRaw)
      const included = String(form.get('included') ?? '')
        .split(',')
        .map(item => item.trim())
        .filter(Boolean)

      await supabase.from('class_types').insert({
        id,
        name: form.get('name'),
        category: form.get('category') || 'lesson',
        price_per_person: parseFloat(form.get('price_per_person') as string),
        price_tiers: parsePriceTiersFromForm(form),
        min_participants_per_booking: normalizedMin,
        max_participants_per_booking: normalizedMax,
        max_capacity: parseInt(form.get('max_capacity') as string),
        duration_minutes: parseInt(form.get('duration_minutes') as string),
        description: form.get('description'),
        included: included.length > 0 ? included : ['Surfboard', 'Leash', 'Rash guard', 'Certified instructor'],
        badge: (form.get('badge') as string) || null,
        active: form.get('active') === 'true',
        sort_order: parseInt(form.get('sort_order') as string) || 0,
      })

      const firstSlotTime = String(form.get('first_slot_start_time') ?? '').trim()
      if (firstSlotTime) {
        await supabase.from('weekly_slots').upsert(
          {
            class_type_id: id,
            day_of_week: parseInt(form.get('first_slot_day_of_week') as string) || 1,
            start_time: firstSlotTime,
            capacity: parseSlotCapacity(form.get('first_slot_capacity'), normalizedMax),
            booking_mode: parseBookingMode(form.get('first_slot_booking_mode')),
          },
          { onConflict: 'class_type_id,day_of_week,start_time' }
        )
      }
      return Astro.redirect('/admin?tab=class-types')
    }

    if (action === 'update_class_type') {
      const id = form.get('id') as string
      const minParticipants = parseInt(form.get('min_participants_per_booking') as string)
      const maxParticipants = parseInt(form.get('max_participants_per_booking') as string)
      const normalizedMin = Number.isNaN(minParticipants) ? 1 : Math.max(1, minParticipants)
      const normalizedMaxRaw = Number.isNaN(maxParticipants) ? normalizedMin : Math.max(1, maxParticipants)
      const normalizedMax = Math.max(normalizedMin, normalizedMaxRaw)
      await supabase.from('class_types').update({
        name: form.get('name'),
        category: form.get('category') || 'lesson',
        price_per_person: parseFloat(form.get('price_per_person') as string),
        price_tiers: parsePriceTiersFromForm(form),
        min_participants_per_booking: normalizedMin,
        max_participants_per_booking: normalizedMax,
        max_capacity: parseInt(form.get('max_capacity') as string),
        duration_minutes: parseInt(form.get('duration_minutes') as string),
        description: form.get('description'),
        badge: (form.get('badge') as string) || null,
        active: form.get('active') === 'true',
        sort_order: parseInt(form.get('sort_order') as string),
      }).eq('id', id)
      return Astro.redirect('/admin?tab=class-types')
    }

    if (action === 'add_weekly_slot') {
      const class_type_id = form.get('class_type_id') as string
      const day_of_week = parseInt(form.get('day_of_week') as string)
      const start_time = form.get('start_time') as string
      await supabase.from('weekly_slots').upsert(
        {
          class_type_id,
          day_of_week,
          start_time,
          capacity: parseSlotCapacity(form.get('capacity'), 1),
          booking_mode: parseBookingMode(form.get('booking_mode')),
        },
        { onConflict: 'class_type_id,day_of_week,start_time' }
      )
      const redirectTab = form.get('redirect_to') === 'class-types' ? 'class-types' : 'weekly-slots'
      return Astro.redirect(`/admin?tab=${redirectTab}`)
    }
    if (action === 'delete_weekly_slot') {
      await supabase.from('weekly_slots').delete().eq('id', parseInt(form.get('id') as string))
      return Astro.redirect('/admin?tab=weekly-slots')
    }

    if (action === 'set_capacity') {
      await supabase.from('tour_capacity').upsert(
        {
          class_type_id: form.get('class_type_id'),
          capacity_date: form.get('capacity_date'),
          max_capacity: parseInt(form.get('max_capacity') as string),
        },
        { onConflict: 'class_type_id,capacity_date' }
      )
      return Astro.redirect('/admin?tab=capacity')
    }
    if (action === 'delete_capacity') {
      await supabase.from('tour_capacity').delete().eq('id', parseInt(form.get('id') as string))
      return Astro.redirect('/admin?tab=capacity')
    }

    if (action === 'add_slot') {
      const class_type_id = form.get('class_type_id') as string
      await supabase.from('tour_slots').upsert(
        {
          class_type_id,
          slot_date: form.get('slot_date'),
          start_time: form.get('start_time'),
          capacity: parseSlotCapacity(form.get('capacity'), 1),
          booking_mode: parseBookingMode(form.get('booking_mode')),
        },
        { onConflict: 'class_type_id,slot_date,start_time' }
      )
      return Astro.redirect('/admin?tab=date-slots')
    }
    if (action === 'delete_slot') {
      await supabase.from('tour_slots').delete().eq('id', parseInt(form.get('id') as string))
      return Astro.redirect('/admin?tab=date-slots')
    }
  } catch (e) {
    console.error('Admin action error:', e)
  }
}

if (Astro.url.searchParams.get('logout') === '1') {
  Astro.cookies.delete('pvss_admin', { path: '/' })
  return Astro.redirect('/admin')
}

// ── Data fetching ──────────────────────────────────────────────────────────
let bookings: any[] = []
let classTypes: any[] = []
let weeklySlots: any[] = []
let capacities: any[] = []
let dateSlots: any[] = []
let stats     = { total: 0, confirmed: 0, pending: 0, cancelled: 0, revenue: 0 }
let campStats = { total: 0, confirmed: 0, pending: 0, cancelled: 0, revenue: 0 }

let campRooms: any[] = []
let campSessions: any[] = []
let campBookings: any[] = []
let campSettings: any = { payment_mode: 'full', deposit_percentage: 30 }

const activeTab = Astro.url.searchParams.get('tab') ?? 'bookings'
const statusFilter = Astro.url.searchParams.get('status') ?? ''
const dateFilter = Astro.url.searchParams.get('date') ?? ''

if (isAuthenticated && DISABLED_CAMP_TABS.includes(activeTab)) {
  return Astro.redirect('/admin?tab=class-types')
}

if (isAuthenticated && isSupabaseConfigured) {
  const [
    { data: allBookings },
    { data: ctData },
    { data: wsData },
    { data: capData },
    { data: dsData },
    { data: statsData },
  ] = await Promise.all([
    supabase.from('bookings').select('*')
      .order('booking_date', { ascending: true })
      .order('start_time', { ascending: true })
      .order('created_at', { ascending: true })
      .limit(200),
    supabase.from('class_types').select('*').order('sort_order'),
    supabase.from('weekly_slots').select('*, class_types(name)').order('class_type_id').order('day_of_week').order('start_time'),
    supabase.from('tour_capacity').select('*, class_types(name)').order('capacity_date', { ascending: true }),
    supabase.from('tour_slots').select('*, class_types(name)').order('slot_date', { ascending: true }).order('start_time'),
    supabase.from('bookings').select('status, total_amount'),
  ])

  classTypes = ctData ?? []
  weeklySlots = wsData ?? []
  capacities = capData ?? []
  dateSlots = dsData ?? []

  for (const b of statsData ?? []) {
    stats.total++
    if (b.status === 'confirmed') { stats.confirmed++; stats.revenue += Number(b.total_amount) }
    if (b.status === 'pending') stats.pending++
    if (b.status === 'cancelled') stats.cancelled++
  }

  let q = (allBookings ?? [])
  if (statusFilter) q = q.filter((b: any) => b.status === statusFilter)
  if (dateFilter) q = q.filter((b: any) => b.booking_date === dateFilter)
  bookings = q
}

const classTypesById: Record<string, any> = {}
for (const ct of classTypes) classTypesById[ct.id] = ct

const weeklySlotsByService: Record<string, Record<number, any[]>> = {}
for (const s of weeklySlots) {
  if (!weeklySlotsByService[s.class_type_id]) weeklySlotsByService[s.class_type_id] = {}
  const byDay = weeklySlotsByService[s.class_type_id]
  if (!byDay[s.day_of_week]) byDay[s.day_of_week] = []
  byDay[s.day_of_week].push(s)
}

const sortedBookings = [...bookings].sort((a, b) => {
  if (a.booking_date !== b.booking_date) return a.booking_date < b.booking_date ? -1 : 1
  return (a.start_time || '').localeCompare(b.start_time || '')
})

type DayGroup = { date: string; items: any[] }
const bookingsByDate: DayGroup[] = []
for (const b of sortedBookings) {
  const last = bookingsByDate[bookingsByDate.length - 1]
  if (last && last.date === b.booking_date) last.items.push(b)
  else bookingsByDate.push({ date: b.booking_date, items: [b] })
}

const DAY_COLORS = [
  { border: '#00BCD4', bg: '#E0F7FA', text: '#006064', chip: '#B2EBF2' },
  { border: '#3B82F6', bg: '#EFF6FF', text: '#1E40AF', chip: '#BFDBFE' },
