---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import HeroPreload from '../components/ui/HeroPreload.astro'
import WhyChooseUs from '../components/sections/WhyChooseUs.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData } from '../lib/seo'

import heroImg    from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'
import gallery1   from '../assets/images/surf-school-tamarindo-beach-lesson.webp'
import gallery2   from '../assets/images/surf-school-tamarindo-students.webp'
import gallery3   from '../assets/images/surf-school-tamarindo-private-class.webp'
import gallery4   from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import storyImg   from '../assets/images/student-from-our-surf-school-in-Tamarindo.webp'

const seo = seoData.aboutUs

const highlights = [
  'Certified and experienced surf instructors',
  'Personalized coaching for all levels',
  "Deep local knowledge of Tamarindo's waves",
  'Safe, fun, and inclusive environment',
]

const stats = [
  { value: '500+', label: 'Surfers Trained' },
  { value: '5★', label: 'Average Rating' },
  { value: '10+',  label: 'Expert Instructors' },
  { value: '15+',  label: 'Years Experience' },
]

const pageStats = [
  { num: '100%',   label: 'Customer Satisfaction' },
  { num: '10+',  label: 'Expert Instructors' },
  { num: '15+',  label: 'Years Experience' },
]

const gallery = [gallery1, gallery2, gallery3, gallery4]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <HeroPreload slot="head" src={heroImg} />
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Best Surf School in Tamarindo',href:'/best-surf-school-in-tamarindo'}]} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Pura Vida Surf School — The Best Surf School In Tamarindo"
    image={heroImg}
    imageAlt="Best surf school in Tamarindo Costa Rica"
    breadcrumb={{ label: 'About Us' }}
    cta={{ label: 'Book a Lesson', href: '/book-now' }}
    ctaSecondary={{ label: 'View Surf Lessons', href: '/tamarindo-surf-lessons' }}
    height="large"
  />

  <!-- ── STATS BAR ──────────────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-gray-100 shadow-sm">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100">
        {stats.map(s => (
          <div class="py-7 px-4 text-center">
            <p class="text-3xl font-extrabold text-[#00BCD4] mb-0.5">{s.value}</p>
            <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── INTRO 2-COL ───────────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-14 items-center">

        <!-- Staggered gallery -->
        <div class="grid grid-cols-2 gap-3 relative">
          {gallery.map((img, i) => (
            <div class={`overflow-hidden rounded-2xl shadow-md h-48 ${i % 2 === 1 ? 'mt-8' : ''}`}>
              <Image
                src={img}
                alt="Surf instructor with students at Tamarindo Beach"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                widths={[200, 400]}
                formats={['avif', 'webp']}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding={i === 0 ? 'sync' : 'async'}
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          ))}
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-[#00BCD4]/10 rounded-full -z-10 blur-xl"/>
        </div>

        <!-- Text -->
        <div>
          <span class="section-label mb-3 block">Welcome to Pura Vida Surf School</span>
          <h2 class="text-4xl font-extrabold text-gray-900 leading-tight mb-5">
            Your Local Surf Family in Tamarindo, Costa Rica
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Welcome to Pura Vida Surf School, proudly recognized by students from around the world as the <strong>best surf school in Tamarindo</strong>. Our mission is simple: to share our passion for surfing through high-quality instruction, local knowledge, and the warm, welcoming pura vida spirit that makes Tamarindo so special.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Whether you're a beginner catching your first wave or an intermediate surfer looking to improve technique, our team is dedicated to helping you progress quickly, safely, and with confidence.
          </p>
          <ul class="space-y-3 mb-8">
            {highlights.map(i => (
              <li class="flex items-center gap-3 text-gray-700">
                <span class="w-5 h-5 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </span>
                {i}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/tamarindo-surf-lessons" class="btn-primary">Discover More</a>
            <div class="inline-flex items-center gap-3 bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-2xl px-5 py-3">
              <span class="text-3xl font-extrabold text-[#00BCD4]">15+</span>
              <span class="text-gray-600 text-sm leading-snug">Years of<br/>Experience</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── OUR STORY ─────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-14 items-center">

        <!-- Text -->
        <div>
          <span class="section-label mb-3 block">Our Story</span>
          <h2 class="text-4xl font-extrabold text-gray-900 leading-tight mb-6">Our Story — How It All Started</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Pura Vida Surf School was born from a deep love for the ocean and a desire to create a space where students from all over the world could learn to surf in a safe, supportive, and unforgettable environment. Our founders grew up surfing Tamarindo's legendary waves and wanted to share the same magic with visitors.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            What started as a small team of passionate local surfers has grown into one of the <strong>top surf schools in Tamarindo</strong>, recognized for personalized instruction, authenticity, and a commitment to excellence.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Through the years, we've taught thousands of surfers — from 6-year-old beginners trying surfing for the first time to grandparents discovering the joy of riding waves in a way that feels natural, fun, and empowering.
          </p>
        </div>

        <!-- Image -->
        <div class="overflow-hidden rounded-3xl shadow-xl">
          <Image
            src={storyImg}
            alt="Pura Vida Surf School story Tamarindo"
            class="w-full h-96 object-cover hover:scale-105 transition-transform duration-700"
            widths={[400, 800]}
            formats={['avif', 'webp']}
            loading="lazy"
            decoding="async"
            sizes="(min-width: 768px) 50vw, 100vw"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ── STATS ─────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="grid grid-cols-3 gap-6 text-center">
          {pageStats.map(s => (
            <div class="bg-gray-50 border border-gray-100 rounded-3xl py-10 px-6 shadow-sm hover:shadow-md transition-shadow">
              <p class="text-5xl font-extrabold text-[#00BCD4] mb-2">{s.num}</p>
              <p class="text-gray-600 text-sm font-medium">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHY CHOOSE US ──────────────────────────────────────────────────────── -->
  <WhyChooseUs/>

  <!-- ── TEAM ───────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-[#00BCD4]">
    <div class="container mx-auto px-4 text-center">
      <span class="inline-block bg-white/15 text-white text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase">Our Team</span>
      <h2 class="text-4xl font-extrabold text-white mb-5">Meet Our Surf Instructors</h2>
      <p class="text-white/80 max-w-xl mx-auto mb-8 leading-relaxed">
        Our certified instructors are passionate local surfers who know Tamarindo's waves like the back of their hand. They're patient, encouraging, and genuinely invested in your progress.
      </p>
      <a href="/surf-school-near-me-tamarindo"
        class="inline-block bg-white text-[#00BCD4] font-bold px-8 py-4 rounded-2xl hover:bg-white/90 transition-colors shadow-lg shadow-black/10">
        All Instructors
      </a>
    </div>
  </section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <Testimonials bg="gray" items={[
    { name: 'Carlos M.',    role: 'Traveler',      country: 'Spain',   text: 'The best surf school I\'ve ever been to. The instructors truly care about your progress and the vibe is incredibly welcoming. I\'ll be back next year!' },
    { name: 'Jessica L.',   role: 'Solo Traveler', country: 'USA',     text: 'I was nervous about surfing for the first time but they made it so easy. Patient, professional, and so much fun. Best experience in Costa Rica!' },
    { name: 'Thomas B.',    role: 'Digital Nomad', country: 'Germany', text: 'I\'ve tried surf schools in Bali and Portugal but Pura Vida is on another level. The local knowledge and personal touch make all the difference.' },
    { name: 'Ana P.',       role: 'Traveler',      country: 'Brazil',  text: 'Brought my whole family here — from my 8-year-old to my mom. Everyone learned, everyone had fun. That says it all about how good these guys are.' },
  ]} title="What Students Say About Pura Vida Surf School"/>

  <!-- ── LATEST NEWS ────────────────────────────────────────────────────────── -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="section-label mb-2 block">Insight</span>
          <h2 class="text-3xl font-extrabold text-gray-900 mb-2">Latest News & Articles</h2>
          <p class="text-gray-500 max-w-lg">Stay informed with surf tips, local knowledge, and stories from Tamarindo.</p>
        </div>
        <a href="/blog"
          class="shrink-0 inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-200 text-gray-700 font-semibold rounded-2xl hover:border-[#00BCD4] hover:text-[#00BCD4] transition-colors text-sm">
          All Articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── NEED HELP ──────────────────────────────────────────────────────────── -->
  <NeedHelp/>

</BaseLayout>
