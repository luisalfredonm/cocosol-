---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import TrustBar from '../components/sections/TrustBar.astro'
import LessonPricing from '../components/sections/LessonPricing.astro'
import GearIncluded from '../components/sections/GearIncluded.astro'
import CompareColumns from '../components/sections/CompareColumns.astro'
import AudienceCards from '../components/sections/AudienceCards.astro'
import HowItWorks from '../components/sections/HowItWorks.astro'
import SplitContent from '../components/sections/SplitContent.astro'
import FinalCTA from '../components/sections/FinalCTA.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BookingWizard from '../components/booking/BookingWizard'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import ProductSchema from '../components/seo/ProductSchema.astro'
import { seoData } from '../lib/seo'

import heroImg  from '../assets/images/group-surf-lessons-cocoa-beach-students-beach.webp'
import groupImg from '../assets/images/beginner-surf-lessons-cocoa-beach-group-session.webp'
import coachImg from '../assets/images/beginner-group-surf-lessons-cocoa-beach-wave.webp'
import beachImg from '../assets/images/surf-school-cocoa-beach-beach-lesson.webp'
import ctaBgImg from '../assets/images/surf-group-lessons-cocoa-beach-warm-water.webp'

const seo = seoData.groupLessons

const trustItems = [
  { value: '5★',       label: 'Google Rating' },
  { value: '$60',      label: 'Per Person' },
  { value: '1–2 hr', label: 'Per Session' },
  { value: 'Bilingual', label: 'Certified Pros' },
]

const priceRows = [
  { name: 'Group Surf Lesson', note: 'Min. 4 participants · all gear included',           sessions: '/ person / hour', price: '$60', popular: true  },
  { name: 'Private Lesson',    note: 'One-on-one · fastest progression',                  sessions: '/ person / hour', price: '$75', popular: false },
  { name: 'Surf Coaching',     note: 'Intermediate & advanced · technique & performance', sessions: '/ person / hour', price: '$75', popular: false },
]

const gear = [
  { label: 'Premium surfboard, sized to each surfer' },
  { label: 'High-quality leash' },
  { label: 'UV-protection rash guard' },
  { label: 'Professional surf wax' },
  { label: 'Mineral-based sunscreen' },
  { label: 'Beach safety briefing' },
]

const subblocks = [
  {
    image:    groupImg,
    imageAlt: 'Group surf lesson on Cocoa Beach — friends learning together',
    title:    'Premium Gear, No Rentals',
    body:     'We bring ready-to-ride boards matched to each surfer by height, weight, and skill. Beginners learn on stable boards — no one gets stuck on the wrong equipment.',
  },
  {
    image:    coachImg,
    imageAlt: 'Certified instructor coaching beginners during a group surf lesson in Cocoa Beach',
    title:    'Small Groups, Real Attention',
    body:     'We keep groups small so every surfer gets hands-on coaching — pop-up corrections, wave reading, and a real push into their first ride. Not just a crowd in the water.',
  },
]

const compareLeft = {
  title:   'Group Lesson',
  price:   'From $60 / person',
  badge:   'Best for Groups',
  items: [
    'The social, shared experience with friends & family',
    'Our most affordable way to get on a board',
    'Small groups with hands-on instructor attention',
    'Beginner-friendly — most stand up the first session',
    'Minimum 4 participants for the group rate',
  ],
}

const compareRight = {
  title:   'Private Lesson',
  price:   'From $75 / person',
  items: [
    '100% one-on-one instructor attention',
    'Fastest path to standing and turning',
    'Flexible start times around your schedule',
    'Ideal if you\'re short on time or want to progress fast',
    'Works for all levels, even complete beginners',
  ],
}

const audienceCards = [
  {
    num:       '01',
    title:     'Families & Kids',
    body:      'Surfing together is a memory your family keeps for life. Safe, encouraging sessions for parents and kids (from age 6) to learn side by side, with boards sized for every age.',
    linkLabel: 'Book a family session',
    linkHref:  '#book',
  },
  {
    num:       '02',
    title:     'Friends & Group Trips',
    body:      'Visiting Cocoa Beach with your crew? A group lesson is the highlight of any trip — bachelor parties, birthdays, reunions, or just a great day out on the water.',
    linkLabel: 'Book for your group',
    linkHref:  '#book',
  },
  {
    num:       '03',
    title:     'Corporate & Teams',
    body:      'Get your team out of the office and into the ocean. Surfing builds trust and shared wins no conference room can. We organize sessions for companies of all sizes.',
    linkLabel: 'Plan a team session',
    linkHref:  '#book',
  },
  {
    num:       '04',
    title:     'First-Timers & Tourists',
    body:      'In town from Orlando or the Space Coast? Cocoa Beach\'s gentle waves make it the perfect place for total beginners to try surfing for the very first time — together.',
    linkLabel: 'Try your first wave',
    linkHref:  '#book',
  },
]

const steps = [
  {
    title: 'Welcome & safety briefing',
    body:  'We start on the beach: reading the ocean, spotting rip currents, handling your board, and the rules that keep everyone safe. Plus pop-up practice on dry land before you paddle.',
  },
  {
    title: 'Gear up',
    body:  'We match each surfer with the right board and rash guard, sized by height, weight, and experience. Everyone is waxed up and ready to go in minutes.',
  },
  {
    title: 'Into the water & first wave',
    body:  'Your instructor stays right beside you — help you paddle, time the wave, and stand. Most beginners stand up on their very first session. Your group cheers each other on.',
  },
  {
    title: 'Ride, repeat & improve',
    body:  'The rest of the session is live practice with coaching. Your instructor corrects your pop-up, wave selection, and positioning — every wave is better than the last.',
  },
]

const faqs = [
  { question: 'How much do group surf lessons cost in Cocoa Beach?', answer: 'Group lessons at Cocosol Surf Lessons are $60 per person, per hour, with a minimum of 4 people to get the group rate. That price already covers everything — surfboard, leash, rash guard, wax, sunscreen, and your instructor — so there\'s nothing extra to rent or pay for once you show up.' },
  { question: 'Are group surf lessons a good idea if I\'ve never surfed before?', answer: 'Yes. Cocoa Beach has gentle, rolling waves and a soft, sandy bottom — exactly the forgiving setup beginners want. Most first-timers in our group lessons are standing up and riding small waves within their first session, and learning next to friends takes most of the nerves away.' },
  { question: 'How many people can join one group surf lesson?', answer: 'We keep groups small for hands-on attention, and the group rate starts at 4 people. For bigger crews — family reunions, birthdays, work teams — we add instructors so nobody waits on the sand.' },
  { question: 'Do we need to bring our own surfboards or gear?', answer: 'No. Every spot in the lesson includes a surfboard sized to you, a leash, a UV rash guard, wax, and mineral sunscreen. You only need a swimsuit, a towel, and water.' },
  { question: 'Where is the best place to learn to surf near Orlando?', answer: 'Cocoa Beach is the best place to learn to surf near Orlando — about an hour\'s drive east and minutes from the Kennedy Space Center, with consistent, beginner-friendly waves. It\'s an easy add to any Central Florida trip.' },
  { question: 'Can kids do a group surf lesson?', answer: 'Yes. Cocosol Surf Lessons teaches surfers from age 6 and up. We size each board to the child, run a safety briefing before anyone enters the water, and our instructors are patient with first-timers, so families can learn together.' },
  { question: 'What actually happens during a group surf lesson?', answer: 'You start on the beach with a safety briefing and pop-up practice on the sand, then gear up and head into the water where your instructor helps you paddle, time the wave, and stand. The full session runs about 1 to 2 hours depending on ocean conditions.' },
  { question: 'Should we do a group lesson or book private lessons?', answer: 'Group lessons ($60/person) are the social, budget-friendly choice for friends and family learning together. Private lessons ($75/person) give one-on-one focus and faster progress. Many groups start social and book a private later to level up.' },
  { question: 'What should we wear and bring to the lesson?', answer: 'Wear a swimsuit or board shorts under the rash guard we provide, and bring a towel, a change of clothes, and water. Sunscreen and all surf gear are included. Photo sessions are available if you\'d rather leave your phone dry.' },
  { question: 'How do we book a group surf lesson in Cocoa Beach?', answer: 'Book online using the form below or message Cocosol Surf Lessons on WhatsApp at +1 (321) 386-9993. We\'re open every day from 9 AM to 5 PM. Peak season fills fast, so book a few days ahead, especially for larger groups.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[
    { name: 'Home',         href: '/' },
    { name: 'Group Surf Lessons', href: '/group-surf-lessons-cocoa-beach' },
  ]} />
  <ProductSchema
    slot="head"
    name="Group Surf Lesson Cocoa Beach"
    description="Group surf lesson in Cocoa Beach, Florida. Learn to surf with friends and family from certified bilingual instructors at Cocosol Surf Lessons. All gear included."
    price="65"
    url="/group-surf-lessons-cocoa-beach"
    image="/images/group-surf-lessons-cocoa-beach-students-beach.webp"
  />
  <FAQSchema slot="head" items={faqs} />

  <!-- HERO -->
  <Hero
    title="Group Surf Lessons in Cocoa Beach, FL — Learn to Surf With Friends"
    image={heroImg}
    imageAlt="Group surf lessons in Cocoa Beach Florida — friends learning to surf together on the beach"
    breadcrumb={{ label: 'Surf Lessons', href: '/' }}
    cta={{ label: 'Book Your Group', href: '#book' }}
    height="large"
  />

  <!-- TRUST BAR -->
  <TrustBar items={trustItems} />

  <!-- PRICING -->
  <LessonPricing
    eyebrow="Pricing"
    title="Group Surf Lesson Prices in Cocoa Beach"
    lead1="Simple and upfront — no packages required to get in the water, no fine print. Gear, safety briefing, and your instructor are always included in the price."
    lead2="Group rate applies from 4 participants. Larger groups get additional instructors so nobody waits on the sand."
    rows={priceRows}
    altLinks={[
      { label: 'Private Lessons from $75', href: '/private-surf-lessons-cocoa-beach' },
      { label: 'Surf Coaching from $75',   href: '/surf-coaching-cocoa-beach' },
    ]}
    cardLabel="Group Lesson"
    cardFrom="$60"
    cardUnit="/ person · min. 4 people"
    cardIncludes={[
      'Premium surfboard (sized to you)',
      '1–2 hour guided session',
      'Leash, rash guard & sunscreen',
      'Beach safety briefing',
      'Certified bilingual instructor',
    ]}
    ctaLabel="Book Your Group"
    ctaHref="#book"
  />

  <!-- GEAR INCLUDED -->
  <GearIncluded
    eyebrow="All-inclusive"
    title="What's Included in Every Group Surf Lesson"
    subtitle="No rental fees. No surprise add-ons. One price covers your whole experience — show up and surf."
    gear={gear}
    subblocks={subblocks}
  />

  <!-- COMPARE COLUMNS -->
  <CompareColumns
    eyebrow="Make the right call"
    title="Group vs. Private Surf Lessons — Which Is Right for You?"
    subtitle="Both get you surfing. The difference is pace and attention — pick the experience you're after."
    left={compareLeft}
    right={compareRight}
    note="Not sure which fits your group?"
    noteLink={{ label: 'Talk to us on WhatsApp', href: 'https://wa.me/13213869993' }}
  />

  <!-- AUDIENCE CARDS -->
  <AudienceCards
    eyebrow="Who it's for"
    title="Who Are Group Surf Lessons For?"
    subtitle="If you're learning with other people, a group lesson is built for you. We tailor every session to who's in the water."
    cards={audienceCards}
  />

  <!-- HOW IT WORKS -->
  <HowItWorks
    eyebrow="Step by step"
    title="What to Expect in Your First Surf Lesson"
    subtitle="Never surfed before? Perfect — that's exactly who we teach. Here's how your group lesson unfolds, from the sand to your first wave."
    steps={steps}
    footer="Most first-time surfers stand up on their board within the very first session."
  />

  <!-- SPLIT CONTENT — Why Cocoa Beach -->
  <SplitContent
    eyebrow="Why Cocoa Beach"
    title="One of the Best Places to Learn to Surf in Florida"
    body={[
      'Cocoa Beach isn\'t just convenient — it\'s one of the best beginner surf spots on the U.S. Atlantic coast. Gentle, consistent waves break over a soft, sandy bottom, far safer for first-timers than rocky or reef breaks anywhere else in Florida.',
      'About an hour east of Orlando and minutes from the Kennedy Space Center, Cocoa Beach is an easy add to any Central Florida trip. A true surf town with warm water most of the year — and the beginner-friendly waves to prove it.',
    ]}
    image={beachImg}
    imageAlt="Beginner-friendly surf waves at Cocoa Beach, Florida — ideal for group surf lessons"
    reverse={true}
    bg="white"
    ctaLabel="Book Your Group Lesson"
    ctaHref="#book"
  />

  <!-- TESTIMONIALS -->
  <Testimonials
    title="What Our Surfers Say"
    items={[
      {
        name: 'Danielle Hodge',
        role: 'Local Guide · Group booking',
        text: 'Victor is truly amazing! The whole staff and crew are truly so wonderful. Our non profit planned a surf lesson for youth and adults, and some had never had a beach experience or ever surfed before. CocoSol brought boards, set up tents and really gave our group an unforgettable surf experience. 10/10 for being so hands on, encouraging and patient while the new surfers learned.',
      },
      {
        name: 'Brittany Lott',
        role: 'Google Review · Group with friends',
        text: 'Cocosol truly has a heart of gold. Victor and team have been incredibly kind, welcoming, and supportive to my friends and I as we embarked on the surfing journey! From the first interaction, they went out of their way to help us feel comfortable and encouraged in the water. Highly recommend to anyone looking for a surf school that values community, respect, and fun.',
      },
    ]}
  />

  <!-- FAQ -->
  <section class="gsl-faq">
    <div class="gsl-faq-wrap">
      <h2 class="gsl-faq-title">Group Surf Lessons in Cocoa Beach — FAQ</h2>
      <FAQ items={faqs} columns={1} />
    </div>
  </section>

  <!-- BOOKING WIZARD -->
  <section id="book" class="gsl-book" style="scroll-margin-top: 96px;">
    <div class="gsl-book-wrap">
      <div class="gsl-book-head">
        <span class="gsl-book-eyebrow">Ready to Ride?</span>
        <h2 class="gsl-book-title">Book Your Group Surf Lesson</h2>
        <p class="gsl-book-sub">Get your group in the water together. Spots fill quickly in peak season — secure yours before they're gone.</p>
      </div>
      <div class="gsl-book-wizard">
        <BookingWizard filterGroup="group-lessons" client:idle />
      </div>
      <p class="gsl-book-note">Secure payments · Certified instructors · Open 7 days · 9 AM–5 PM</p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <FinalCTA
    bgImage={ctaBgImg}
    bgImageAlt="Group of surfers catching waves at Cocoa Beach Florida"
    title="Get Your Group in the Water Today"
    subtitle="Book a group lesson and share the stoke together. All gear included, certified instructors, beginner-friendly waves."
    primaryCta={{ label: 'Book Your Group', href: '#book' }}
    secondaryCta={{ label: 'WhatsApp Us', href: 'https://wa.me/13213869993' }}
    meta={[
      { icon: '✓', text: 'All gear included' },
      { icon: '✓', text: 'Bilingual instructors' },
      { icon: '✓', text: 'Open 7 days a week' },
    ]}
  />

  <!-- SEO INTERNAL LINKS -->
  <section class="gsl-links">
    <div class="gsl-links-wrap">
      <h2 class="gsl-links-title">Also Available at Cocosol Surf Lessons</h2>
      <div class="gsl-links-list">
        {[
          { l: 'Private Surf Lessons',  h: '/private-surf-lessons-cocoa-beach' },
          { l: 'Surf Coaching',         h: '/surf-coaching-cocoa-beach' },
          { l: 'Surf Packages',         h: '/surf-packages-cocoa-beach' },
          { l: 'Surf Camp Cocoa Beach', h: '/surf-camp-cocoa-beach' },
        ].map(x => (
          <a href={x.h} data-astro-prefetch="viewport" class="gsl-link">{x.l}</a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── FAQ ─────────────────────────────────────────────────────────────── */
  .gsl-faq {
    background: #EFF9FB;
    padding: 80px 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  .gsl-faq-wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .gsl-faq-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 600;
    color: var(--c-heading);
    margin-bottom: 36px;
    line-height: 1.1;
  }

  /* ── Booking ─────────────────────────────────────────────────────────── */
  .gsl-book {
    background: #fff;
    padding: 80px 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  .gsl-book-wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .gsl-book-head { text-align: center; margin-bottom: 36px; }
  .gsl-book-eyebrow {
    display: inline-block;
    background: rgba(0,188,212,.10);
    color: #00838F;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .gsl-book-title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 600;
    color: var(--c-heading);
    margin-bottom: 10px;
    line-height: 1.1;
  }
  .gsl-book-sub {
    font-size: 1rem;
    color: var(--c-muted);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.65;
  }
  .gsl-book-wizard { margin-bottom: 16px; }
  .gsl-book-note {
    text-align: center;
    font-size: .85rem;
    color: #9ab;
  }

  /* ── SEO links ───────────────────────────────────────────────────────── */
  .gsl-links {
    background: #f9fafb;
    border-top: 1px solid #e5e7eb;
    padding: 40px 0;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  .gsl-links-wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }
  .gsl-links-title {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 16px;
  }
  .gsl-links-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .gsl-link {
    padding: 8px 18px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    font-size: .88rem;
    color: var(--c-muted);
    font-weight: 500;
    text-decoration: none;
    transition: border-color .2s, color .2s;
  }
  .gsl-link:hover {
    border-color: rgba(0,188,212,.4);
    color: #00838F;
  }

  @media (max-width: 600px) {
    .gsl-faq, .gsl-book { padding: 60px 0; }
    .gsl-faq-wrap, .gsl-book-wrap, .gsl-links-wrap { padding: 0 20px; }
  }
</style>
