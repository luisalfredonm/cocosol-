---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData } from '../lib/seo'

import heroImg from '../assets/images/surf-camp-costa-rica-tamarindo-sunset.webp'
import campGallery1 from '../assets/images/surf-camp-tamarindo-guided-surf-trip.webp'
import campGallery2 from '../assets/images/tamarindo-surf-camp-video-analysis.webp'
import campGallery3 from '../assets/images/surf-camp-tamarindo-instructor-coaching.webp'
import campGallery4 from '../assets/images/surf-vacation-tamarindo-camp-group.webp'

const seo = seoData.surfCamp

const faqs = [
  { question: 'Do I need surf experience to join the camp?', answer: 'No experience is required. We adapt the coaching plan to your level, goals, and comfort in the ocean.' },
  { question: 'Is accommodation included?', answer: 'Accommodation can be arranged as an add-on through partner stays in Cocoa Beach. Contact us and we will help match the right option to your budget.' },
  { question: 'Can the camp be customized?', answer: 'Yes. The Cocoa Beach camp can be planned around your travel dates, surf level, and how much coaching you want during your stay.' },
  { question: 'What happens if conditions are unsafe?', answer: 'If weather or waves are unsafe, we reschedule. Safety comes first, and Florida conditions can change quickly.' },
  { question: 'Can I join alone?', answer: 'Yes. Solo travelers are welcome, and private coaching is available if you prefer a more focused experience.' },
  { question: 'What should I bring?', answer: 'Bring sunscreen, water, a towel, and comfortable beachwear. We provide surfboards and the core lesson equipment.' },
]

const inclusions = [
  'Certified surf coaching',
  'Surfboard and lesson equipment',
  'Video feedback available',
  'Beginner-friendly Cocoa Beach waves',
  'Flexible scheduling',
  'Accommodation support on request',
]

const gallery = [
  { img: campGallery1, alt: 'Cocoa Beach surf camp guided session' },
  { img: campGallery2, alt: 'Surf camp video coaching session' },
  { img: campGallery3, alt: 'Certified surf instructor coaching in Cocoa Beach' },
  { img: campGallery4, alt: 'Cocoa Beach surf camp group experience' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[{ name: 'Home', href: '/' }, { name: 'Surf Camp Cocoa Beach', href: '/surf-camp-cocoa-beach' }]} />
  <FAQSchema slot="head" items={faqs} />

  <section class="relative min-h-[82vh] flex items-center justify-center overflow-hidden">
    <Image
      src={heroImg}
      alt="Surf camp Cocoa Beach Florida"
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[800, 1200, 1920]}
      loading="eager"
      decoding="async"
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-slate-950/65"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <span class="inline-flex items-center bg-white/10 text-white text-sm font-semibold px-5 py-2.5 rounded-full mb-8 border border-white/20">
        Cocoa Beach, Florida
      </span>
      <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-6 leading-tight">
        Cocoa Beach Surf Camp
      </h1>
      <p class="text-xl md:text-2xl text-white/80 mb-10 max-w-2xl mx-auto leading-relaxed">
        Flexible surf camp coaching with daily lessons, certified instructors, video feedback, and classic Florida beach-town energy.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book-now" class="px-8 py-4 bg-white text-gray-900 font-bold rounded-2xl hover:bg-gray-100 transition-all text-lg shadow-xl">
          Book Your Camp
        </a>
        <a href="https://wa.me/50661987851" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-teal-500 text-white font-bold rounded-2xl hover:bg-teal-400 transition-all text-lg shadow-xl">
          Ask About Dates
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="inline-block bg-teal-100 text-teal-700 text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Camp Includes</span>
        <h2 class="text-4xl font-extrabold text-gray-900 mb-4">Built Around Your Surf Goals</h2>
        <p class="text-gray-500 text-lg leading-relaxed">
          This camp is designed for travelers who want more than one lesson: consistent coaching, a clear progression plan, and enough ocean time to build real confidence.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {inclusions.map(item => (
          <div class="bg-teal-50 border border-teal-100 rounded-2xl px-5 py-4 flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-teal-500 shrink-0"></span>
            <span class="font-semibold text-gray-800 text-sm">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
        <div>
          <span class="inline-block bg-teal-100 text-teal-700 text-xs font-bold px-4 py-1.5 rounded-full mb-6 tracking-wider uppercase">The Location</span>
          <h2 class="text-4xl font-extrabold text-gray-900 mb-6">Why Cocoa Beach Works</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Cocoa Beach is one of Florida's most iconic surf towns. The waves are approachable, the beach is easy to access, and the surf culture makes it a natural place to learn or progress.
          </p>
          <ul class="space-y-3 text-gray-700">
            <li>Consistent beach-break waves</li>
            <li>Beginner-friendly learning zones</li>
            <li>Warm Florida water and relaxed surf-town atmosphere</li>
            <li>Coaching available for complete beginners and improving surfers</li>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {gallery.map(({ img, alt }) => (
            <div class="overflow-hidden rounded-2xl aspect-[4/3]">
              <Image src={img} alt={alt} class="w-full h-full object-cover object-center" widths={[400, 800]} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-gray-900">Frequently Asked Questions</h2>
        <p class="text-gray-500 mt-3">Everything you need to know before booking your Cocoa Beach surf camp.</p>
      </div>
      <FAQ columns={2} items={faqs} />
    </div>
  </section>

  <section class="py-20 bg-gradient-to-br from-teal-600 to-teal-800">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl font-extrabold text-white mb-4">Ready to Surf Every Day?</h2>
      <p class="text-teal-100 text-lg mb-10 max-w-xl mx-auto">
        Tell us your dates and goals, and we will help you shape the right Cocoa Beach camp experience.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book-now" class="px-8 py-4 bg-white text-gray-900 font-bold rounded-2xl hover:bg-gray-50 transition-all text-lg shadow-xl">Book Your Camp</a>
        <a href="https://wa.me/50661987851" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl hover:bg-slate-800 transition-all text-lg shadow-xl">Ask About Dates</a>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
