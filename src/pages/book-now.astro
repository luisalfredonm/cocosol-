---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import FAQ from '../components/ui/FAQ.astro'
import BookingWizard from '../components/booking/BookingWizard'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData } from '../lib/seo'
import heroImg from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'

const seo = seoData.bookNow

// Pre-select class type from URL param (e.g. /book-now?type=private)
// Camps are handled by CampBookingWizard on /surf-camp-tamarindo — not here
const typeParam = Astro.url.searchParams.get('type') as any
const validTypes = ['private','semi-private','group','pkg-3-private','pkg-3-semi','pkg-5-private','pkg-5-semi','camp-7-private','camp-7-semi','camp-5-days']
const preselectedType = validTypes.includes(typeParam) ? typeParam : undefined
---
<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Book Surf Lessons',href:'/book-now'}]} />
  <Hero
    title="Book Surf Lessons & Packages in Tamarindo"
    subtitle="Secure your spot online in minutes. Instant confirmation, flexible cancellation."
    image={heroImg}
    imageAlt="Book surf lessons Tamarindo Costa Rica"
    height="medium"
  />

  <!-- Booking Wizard -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <p class="section-label mb-2">Online Booking</p>
          <h2 class="text-3xl font-bold text-gray-900 mb-3">Reserve Your Surf Session</h2>
          <p class="text-gray-500 max-w-xl mx-auto">
            Choose your experience, pick a date and time, and pay securely online.
            We'll send you a confirmation email right away.
          </p>
        </div>

        <BookingWizard preselectedType={preselectedType} client:idle />
      </div>
    </div>
  </section>

  <!-- Quick links to specific services -->
  <section class="py-10 bg-gray-50">
    <div class="container mx-auto px-4">
      <p class="text-center text-sm font-semibold text-gray-400 mb-8 uppercase tracking-widest">Book by service</p>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">

        <!-- Surf Lessons -->
        <div>
          <p class="text-xs font-bold text-teal-600 uppercase tracking-wider mb-3 px-1">Surf Lessons</p>
          <div class="flex flex-col gap-2">
            {[
              { label: 'Private Lesson', href: '/book-now?type=private' },
              { label: 'Semi-Private Lesson', href: '/book-now?type=semi-private' },
              { label: 'Group Lesson', href: '/book-now?type=group' },
            ].map(link => (
              <a href={link.href} class="text-sm border border-gray-200 hover:border-teal-400 hover:text-teal-600 px-4 py-2.5 rounded-xl transition-colors bg-white text-gray-700 font-medium">
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Surf Packages -->
        <div>
          <p class="text-xs font-bold text-teal-600 uppercase tracking-wider mb-3 px-1">Surf Packages</p>
          <div class="flex flex-col gap-2">
            {[
              { label: '3-Day Private Package', href: '/book-now?type=pkg-3-private' },
              { label: '3-Day Semi-Private Package', href: '/book-now?type=pkg-3-semi' },
              { label: '5-Day Private Package', href: '/book-now?type=pkg-5-private' },
              { label: '5-Day Semi-Private Package', href: '/book-now?type=pkg-5-semi' },
              { label: '7-Day Private Package', href: '/book-now?type=camp-7-private' },
              { label: '7-Day Semi-Private Package', href: '/book-now?type=camp-7-semi' },
            ].map(link => (
              <a href={link.href} class="text-sm border border-gray-200 hover:border-teal-400 hover:text-teal-600 px-4 py-2.5 rounded-xl transition-colors bg-white text-gray-700 font-medium">
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Surf Camps -->
        <div>
          <p class="text-xs font-bold text-teal-600 uppercase tracking-wider mb-3 px-1">Surf Camps</p>
          <div class="flex flex-col gap-2">
            {[
              { label: '5-Day Surf Camp', href: '/surf-camp-tamarindo#book-camp' },
              { label: '7-Day Surf Camp', href: '/surf-camp-tamarindo#book-camp' },
            ].map(link => (
              <a href={link.href} class="text-sm border border-gray-200 hover:border-teal-400 hover:text-teal-600 px-4 py-2.5 rounded-xl transition-colors bg-white text-gray-700 font-medium">
                {link.label}
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Help + FAQ -->
  <section class="py-16 container mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div class="bg-gray-50 rounded-2xl p-6">
        <h3 class="font-bold text-gray-900 mb-3">Need Help?</h3>
        <p class="text-gray-600 text-sm mb-4">
          Not sure which option is right for you? Our team is happy to help you choose the best
          surf experience based on your level and travel plans.
        </p>
        <a
          href="https://wa.me/50661987851"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#20BA5A] text-white font-bold px-5 py-2.5 rounded-xl transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp Us
        </a>
      </div>
      <div>
        <h3 class="font-bold text-gray-900 mb-4">Booking FAQ</h3>
        <FAQ items={[
          { question: 'How early should I book my session?', answer: 'We recommend booking at least 48 hours in advance, especially during peak season (December–April) to ensure your preferred time slot and instructor.' },
          { question: 'What happens if the weather is bad?', answer: "If conditions are unsafe for surfing, we will contact you to reschedule at no extra charge. Costa Rica's tropical climate usually allows us to find a good window." },
          { question: 'Can I cancel or reschedule my booking?', answer: 'Yes! We have a flexible policy. You can reschedule up to 24 hours before your session. Cancellations within 24 hours may be subject to a small fee.' },
          { question: 'Is online payment secure?', answer: 'Absolutely. All online payments are processed securely and we never store your card details.' },
        ]}/>
      </div>
    </div>
  </section>
</BaseLayout>
