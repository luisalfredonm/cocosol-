---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import Sidebar from '../components/ui/Sidebar.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import CampBookingWizard from '../components/booking/CampBookingWizard'
import { seoData } from '../lib/seo'

import heroImg    from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import gallery1   from '../assets/images/family-surf-lessons-tamarindo.webp'
import gallery2   from '../assets/images/surf-school-tamarindo-students.webp'
import gallery3   from '../assets/images/surf-school-tamarindo-private-class.webp'
import gallery4   from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'
import gallery5   from '../assets/images/student-from-our-surf-school-in-Tamarindo.webp'
import gallery6   from '../assets/images/tamarindo-surf-lessons-instructor-teaching-beginner.webp'

const galleryImgs = [gallery1, gallery2, gallery3, gallery4, gallery5, gallery6]
const seo = seoData.surfCamp5Days
const faqs = [
  { question: 'What is the difference between the 5-day and 7-day camp?', answer: 'The 5-day camp has 4 lessons vs 6 in the 7-day version. Both include a surf trip, video analysis, and the same quality of instruction. Choose based on how much time you have.' },
  { question: 'Is accommodation included in the 5-day camp?', answer: 'Accommodation is optional. We can connect you with our partner hotels and hostels in Tamarindo at preferential rates.' },
  { question: 'What if I have only 5 days in Costa Rica?', answer: "The 5-day camp is designed exactly for this scenario. You'll maximize your surf progression in the time available and leave with real surfing skills." },
]
---
<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <FAQSchema slot="head" items={faqs} />
  <Hero title="5 Days Surf Camp Tamarindo — Surf Package Costa Rica" subtitle="5 days of surfing, progression, and pura vida. The perfect short surf camp for travelers with limited time." image={heroImg} imageAlt="5 days surf camp Tamarindo Costa Rica" cta={{ label: 'Book Your Surf Camp', href: '#book' }} breadcrumb={{ label: 'Surf Camp', href: '/surf-camp-tamarindo' }}/>

  <section class="py-16 container mx-auto px-4">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">What You Get in 5 Packed Days of Surfing</h2>
        <p class="text-gray-700 leading-relaxed mb-4">Our <strong>5 Days Surf Camp in Tamarindo</strong> is the perfect option for travelers who want an immersive surf experience without committing to a full week. With 4 surf lessons, a guided surf trip, video analysis, and daily access to a surfboard, this camp delivers real progression in just 5 days.</p>
        <p class="text-gray-700 leading-relaxed mb-4">Like our 7-day camp, this short program includes all essential equipment, certified instructors, and the authentic pura vida spirit that makes Tamarindo so special. By day 5, most campers are surfing green waves with confidence.</p>

        <!-- Why 5 days works -->
        <div class="bg-teal-50 border border-teal-100 rounded-2xl px-6 py-5 mb-8">
          <p class="text-gray-700 text-sm leading-relaxed"><strong>Why 5 days is enough:</strong> Five consecutive days in the water is the sweet spot for most beginner travelers. You have enough time to build real technique, correct your mistakes session by session, and experience a genuine surf trip without needing to extend your vacation. The structured format — land briefing, water session, and video review — ensures that every single day moves you forward. Instructors track your progress across all five sessions and adapt the coaching plan based on how you're developing. By your final lesson, the goal is always the same: catch a green wave on your own and ride it all the way to the shore. The 5-day format has proven itself as the ideal entry point for travelers who are short on time but serious about learning to surf properly.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-6 mb-10">
          <div>
            <h3 class="font-bold text-gray-900 mb-3">What's Included</h3>
            <ul class="space-y-2">{['4 Surf lessons with certified instructors','High quality surfboard & rash guard','Surf theory & video analysis','One guided surf trip','Beach transportation (when needed)','Unlimited board rental during camp','Adventure activity of your choice (ATV, Zip-line, Catamaran)'].map(i=><li class="flex items-start gap-2 text-sm text-gray-600"><svg class="w-4 h-4 text-teal-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{i}</li>)}</ul>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 mb-3">This camp is for:</h3>
            <ul class="space-y-2">{['Complete beginners','Intermediate surfers','Travelers with 5 days in Tamarindo','Couples & solo travelers','Anyone wanting serious progression'].map(i=><li class="flex items-center gap-2 text-sm text-gray-600"><svg class="w-4 h-4 text-teal-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{i}</li>)}</ul>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-10">
          {galleryImgs.map((img, i) => (
            <Image
              src={img}
              alt="Campers surfing at Tamarindo Beach Costa Rica"
              class="rounded-xl w-full h-32 object-cover"
              widths={[280, 560]}
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 768px) 18vw, 33vw"
            />
          ))}
        </div>

        <FAQ items={faqs}/>
      </div>

      <div>
        <Sidebar price="$1,049" priceLabel="/ Per Person" includes={['4 Surf Lessons','1 Surf Trip','Video analysis','Your own rash guard','Unlimited board rental','Adventure activity']} ctaLabel="Book Your Surf Camp" ctaColor="dark" ctaHref="#book"/>
      </div>
    </div>
  </section>

  <section id="book" class="py-16 bg-gray-50 min-h-[800px]" style="scroll-margin-top: 96px;">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <span class="inline-block bg-teal-100 text-teal-700 text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Ready to Ride?</span>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Book Your 5-Day Surf Camp</h2>
        <p class="text-gray-500 max-w-md mx-auto">Select your start date and room. Your 5-Day Surf Camp is pre-selected — just pick your dates and complete the booking.</p>
      </div>
      <div class="max-w-4xl mx-auto">
        <CampBookingWizard preselectedCampType="5day" client:idle />
      </div>
      <p class="text-center mt-4 text-sm text-gray-400">Secure Payments · Trusted Instructors · Flexible Rescheduling</p>
    </div>
  </section>

  <Testimonials items={[{ name: 'Laura T.', role: 'Traveler', text: 'The short camp was the best investment of my Costa Rica trip. By day 4 I was catching real waves on my own. The video analysis made a huge difference!' }, { name: 'Ryan M.', role: 'Surfer', text: 'Compact but complete. The 5-day camp gave me everything I needed to go from paddling to riding. The instructor was patient and incredibly skilled at teaching.' }]} title="What They Say About Our 5-Day Surf Camp"/>

  <NeedHelp/>
</BaseLayout>
