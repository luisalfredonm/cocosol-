---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import VideoSection from '../components/sections/VideoSection.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData } from '../lib/seo'

import heroImg      from '../assets/images/tamarindo-surf-lessons-instructor-teaching-beginner.webp'
import privateImg   from '../assets/images/surf-school-tamarindo-private-class.webp'
import semiImg      from '../assets/images/surf-school-tamarindo-students.webp'
import groupImg     from '../assets/images/surf-school-tamarindo-beach-lesson.webp'
import beginnerImg  from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import videoBg      from '../assets/images/student-from-our-surf-school-in-Tamarindo.webp'

const seo = seoData.surfLessons

const faqs = [
  { question: 'Do I need experience to take surf lessons?', answer: 'Not at all! Our surf lessons are designed for complete beginners. Our certified instructors will guide you step by step from land training to catching your first waves.' },
  { question: 'How long is a surf lesson?', answer: 'All our surf lessons are 90 minutes. This includes a safety briefing on the beach and time in the water with your instructor.' },
  { question: 'What is the best option to start?', answer: 'For beginners, we recommend a private lesson for the fastest progress, or a group lesson for a social experience at a lower price.' },
  { question: 'What can I expect on a regular day?', answer: 'Your instructor will meet you at the beach, provide all equipment, give a safety briefing, and guide you through your first waves.' },
  { question: 'What sets your surf camp apart?', answer: "We are a local surf school with certified instructors who know Tamarindo's waves inside and out. Small groups, personalized attention, and a true pura vida experience." },
  { question: 'Is equipment included?', answer: 'Yes! Surfboard, foam guard, and all necessary equipment are included in every lesson.' },
]

const lessons = [
  { title: 'Private Surf Lessons',      href: '/private-surf-lessons-tamarindo',      price: '$90', badge: '1-on-1 coaching',   desc: 'One-on-one personalized coaching for faster progress and full instructor focus.', img: privateImg },
  { title: 'Semi-Private Surf Lessons', href: '/semi-private-surf-lessons-tamarindo', price: '$60', badge: 'Up to 3 students',  desc: 'Learn together with 2-3 people. Great for couples and small groups of friends.',  img: semiImg },
  { title: 'Group Surf Lessons',        href: '/group-surf-lessons-tamarindo',        price: '$50', badge: 'Up to 6 students',  desc: 'The most affordable option. Small groups, big fun. Perfect for solo travelers.',   img: groupImg },

]

const packages = [
  { days: '3 Days', price: '$245', href: '/3-days-pura-vida-surf-package', detail: '3 Surf lessons + 1 Surf Trip', popular: false },
  { days: '5 Days', price: '$405', href: '/5-days-pura-vida-surf-package', detail: '4 Surf lessons + 1 Surf Trip', popular: true },
  { days: '7 Days', price: '$565', href: '/7-days-pura-vida-surf-package', detail: '6 Surf lessons + 1 Surf Trip', popular: false },
]

const stats = [
  { value: '500+',  label: 'Surfers Taught' },
  { value: '90min', label: 'Per Lesson' },
  { value: '4.9â˜…',  label: 'Average Rating' },
  { value: '100%',  label: 'ISA Certified' },
]

const whyLearn = ['How to pop up', 'Wave timing', 'Basic paddling', 'Safety rules', 'Surf etiquette', 'How to handle the board']
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Surf Lessons',href:'/tamarindo-surf-lessons'}]} />
  <FAQSchema slot="head" items={faqs} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Tamarindo Surf Lessons — Learn to Surf in Costa Rica"
    subtitle="Learn to surf in Tamarindo with certified instructors. Safe, fun, and perfect for beginners & families."
    image={heroImg}
    imageAlt="Tamarindo surf lessons Costa Rica"
    cta={{ label: 'Book Your Lesson', href: '/book-now' }}
    ctaSecondary={{ label: 'View Lesson Types', href: '#lessons' }}
    height="large"
  />

  <!-- ── STATS BAR ──────────────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-gray-100 shadow-sm">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100">
        {stats.map(s => (
          <div class="py-7 px-4 text-center">
            <p class="text-3xl font-extrabold text-[#00BCD4] mb-0.5">{s.value}</p>
            <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHY CHOOSE TAMARINDO ──────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-3 gap-12 items-start">

        <!-- Main content -->
        <div class="lg:col-span-2">
          <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase">Why Tamarindo</span>
          <h2 class="text-4xl font-extrabold text-gray-900 leading-tight mb-5">Why Choose Tamarindo for Surf Lessons?</h2>
          <p class="text-gray-600 leading-relaxed mb-10">If you're dreaming of riding your first wave in warm tropical water surrounded by golden beaches, friendly locals, and consistent waves, then Tamarindo, Costa Rica is where you should learn. Our certified surf instructors, safe learning conditions, and personalized approach make <strong>learning to surf in Tamarindo</strong> accessible for everyone from kids to grandparents.</p>

          <div class="grid md:grid-cols-3 gap-6">
            {[
              { h: 'Who Can Take Surf Lessons?', items: ['Beginners', 'Kids', 'Intermediate Surfers', 'Families'] },
              { h: "What's Included",            items: ['90-minute surf lesson', 'Professional certified instructor', 'Foam guard', 'Safety briefing', 'Surfboard included', 'Photos on request'] },
              { h: 'What to Bring',              items: ['Swimwear or board shorts', 'Towel', 'Sunscreen (reef-safe)', 'Water bottle'] },
            ].map(col => (
              <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
                <h3 class="font-bold text-gray-900 mb-4 text-sm uppercase tracking-wide">{col.h}</h3>
                <ul class="space-y-2">
                  {col.items.map(i => (
                    <li class="flex items-center gap-2.5 text-sm text-gray-600">
                      <span class="w-4 h-4 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0">
                        <svg class="w-2.5 h-2.5 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                      </span>
                      {i}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <!-- Sticky sidebar: What You'll Learn -->
        <div class="lg:sticky lg:top-28">
          <div class="bg-gradient-to-br from-[#00BCD4] to-[#0097A7] rounded-3xl p-7 text-white shadow-xl shadow-[#00BCD4]/20">
            <span class="inline-block bg-white/15 text-white text-xs font-bold px-3 py-1 rounded-full mb-5 tracking-wider uppercase">Skill Building</span>
            <h3 class="text-xl font-bold mb-6">What You'll Learn</h3>
            <ul class="space-y-3 mb-8">
              {whyLearn.map(i => (
                <li class="flex items-center gap-3 text-sm text-white/90">
                  <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center shrink-0">
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </span>
                  {i}
                </li>
              ))}
            </ul>
            <a href="/book-now" class="block w-full py-3.5 bg-white text-[#00BCD4] font-bold rounded-2xl text-center hover:bg-white/90 transition-colors text-sm shadow-sm">
              Choose Your Surf Lesson
            </a>
          </div>

          <!-- Quick info card -->
          <div class="mt-4 bg-gray-50 border border-gray-100 rounded-2xl p-5">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-2xl">ðŸ“</span>
              <div>
                <p class="font-semibold text-gray-900 text-sm">Tamarindo Beach</p>
                <p class="text-gray-500 text-xs">Guanacaste, Costa Rica</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-2xl">ðŸ•</span>
              <div>
                <p class="font-semibold text-gray-900 text-sm">90-minute sessions</p>
                <p class="text-gray-500 text-xs">Morning & afternoon available</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── VIDEO SECTION ──────────────────────────────────────────────────────── -->
  <VideoSection
    title="Learn to surf in the most beautiful beaches in Tamarindo with certified instructors who truly care about your progress."
    bullets={['Use the pura vida lifestyle', 'Feel the vibes', 'Ride the wave']}
    bgImage={videoBg}
    cta={{ label: 'Choose Your Surf Lesson', href: '/book-now' }}
  />

  <!-- ── OUR SURF LESSONS ───────────────────────────────────────────────────── -->
  <section id="lessons" class="py-20 bg-white" style="scroll-margin-top: 96px;">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14">
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Pick Your Style</span>
        <h2 class="text-4xl font-extrabold text-gray-900 mb-3">Our Surf Lessons in Tamarindo</h2>
        <p class="text-gray-500 max-w-2xl mx-auto">We offer three main types of surfing lessons taught in small groups to guarantee personalized attention, fast learning, and maximum safety.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {lessons.map((l, i) => (
          <a href={l.href} data-astro-prefetch
            class="group relative rounded-3xl overflow-hidden block shadow-md hover:shadow-2xl hover:shadow-black/15 transition-all duration-300 hover:-translate-y-1"
            style="height: 380px;">
            <Image
              src={l.img}
              alt={l.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[300, 600]}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 768px) 33vw, 100vw"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/30 to-transparent"/>

            <!-- Badge top-left -->
            <div class="absolute top-4 left-4">
              <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1 rounded-full border border-white/30">
                {l.badge}
              </span>
            </div>

            <!-- Price badge top-right -->
            <div class="absolute top-4 right-4">
              <span class="bg-[#00BCD4] text-white text-sm font-extrabold px-3 py-1 rounded-full shadow-lg">
                From {l.price}
              </span>
            </div>

            <!-- Content bottom -->
            <div class="absolute bottom-0 inset-x-0 p-6">
              <h3 class="text-lg font-bold text-white mb-2 leading-snug">{l.title}</h3>
              <p class="text-white/70 text-xs mb-4 leading-relaxed">{l.desc}</p>
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/15 backdrop-blur-sm border border-white/25 text-white text-xs font-bold rounded-xl group-hover:bg-[#00BCD4] group-hover:border-[#00BCD4] transition-colors">
                View Details
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SURF PACKAGES ──────────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-14">
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Multi-Day Programs</span>
        <h2 class="text-4xl font-extrabold text-gray-900 mb-3">Pura Vida Surf Package</h2>
        <p class="text-gray-500 max-w-2xl mx-auto">The perfect option for travelers who want structured surf lessons without committing to a full surf camp.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {packages.map(p => (
          <div class={`relative bg-white rounded-3xl overflow-hidden border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${p.popular ? 'border-[#00BCD4] ring-2 ring-[#00BCD4] shadow-lg shadow-[#00BCD4]/10' : 'border-gray-200 shadow-sm hover:shadow-gray-200'}`}>
            {p.popular && (
              <div class="bg-gradient-to-r from-[#00BCD4] to-[#0097A7] px-6 py-3 text-center">
                <span class="text-white text-xs font-bold tracking-widest uppercase">â­ Most Popular</span>
              </div>
            )}
            <div class="p-7 text-center">
              <h3 class="text-2xl font-extrabold text-gray-900 mb-1">{p.days}</h3>
              <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Pura Vida Surf</p>
              <p class="text-gray-500 text-sm mb-5">{p.detail}</p>
              <p class="text-4xl font-extrabold mb-1 {p.popular ? 'text-[#00BCD4]' : 'text-gray-900'}">
                <span class={p.popular ? 'text-[#00BCD4]' : 'text-gray-900'}>From {p.price}</span>
              </p>
              <p class="text-gray-400 text-xs mb-7">per person</p>
              <a href={p.href}
                class={`block w-full py-3.5 rounded-2xl text-sm font-bold transition-colors ${p.popular ? 'bg-[#00BCD4] text-white hover:bg-[#0097A7]' : 'bg-gray-100 text-gray-700 hover:bg-[#00BCD4]/10 hover:text-[#00BCD4]'}`}>
                More Details â†’
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Trust strip -->
      <div class="flex flex-wrap justify-center gap-8 mt-14 text-center">
        {[
          { icon: 'ðŸ„', label: 'Certified Instructors' },
          { icon: 'ðŸŽ¯', label: 'All Levels Welcome' },
          { icon: 'ðŸ”„', label: 'Flexible Rescheduling' },
          { icon: 'ðŸ“¸', label: 'Photos Included' },
        ].map(t => (
          <div class="flex items-center gap-2 text-gray-500 text-sm font-medium">
            <span class="text-xl">{t.icon}</span>
            {t.label}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <Testimonials items={[
    { name: 'William Bowman', role: 'Surfer',   text: 'Amazing experience! The instructor was patient, knowledgeable, and made me feel safe in the water the whole time. I caught my first wave on day one!' },
    { name: 'Stephanie Smith', role: 'Designer', text: 'Best decision of our Costa Rica trip. The small group made it personal and the instructor truly cared about our progress. Will definitely come back!' },
  ]} bg="gray"/>

  <!-- ── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-5 gap-12 items-start">

        <!-- Left sticky card -->
        <div class="md:col-span-2">
          <div class="bg-gray-50 rounded-3xl p-8 border border-gray-100 shadow-sm sticky top-28">
            <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-3 py-1 rounded-full mb-5 tracking-wider uppercase">FAQ</span>
            <h2 class="text-3xl font-extrabold text-gray-900 mb-4 leading-snug">
              Surf Lessons FAQ — Everything You Need to Know
            </h2>
            <p class="text-gray-500 text-sm leading-relaxed mb-7">
              These are the most common questions from students planning their first lesson. Can't find your answer? We reply fast on WhatsApp.
            </p>
            <a href="/surf-school-near-me-tamarindo"
              class="inline-flex items-center gap-2 px-5 py-3 border-2 border-gray-200 text-gray-700 font-semibold rounded-2xl hover:border-[#00BCD4] hover:text-[#00BCD4] transition-colors text-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Contact Us on WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: FAQ items -->
        <div class="md:col-span-3">
          <FAQ items={faqs}/>
        </div>

      </div>
    </div>
  </section>

  <!-- ── NEED HELP ──────────────────────────────────────────────────────────── -->
  <NeedHelp/>

</BaseLayout>
