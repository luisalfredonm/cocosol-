---
import { Image } from 'astro:assets'
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData } from '../lib/seo'
import type { ImageMetadata } from 'astro'

import imgSurf    from '../assets/images/surf-school-cocoa-beach-surf-instructor-student.webp'
import imgBeginner from '../assets/images/surf-school-cocoa-beach-beginner-lesson.webp'
import imgStudents from '../assets/images/surf-school-cocoa-beach-students.webp'

const seo = seoData.blog

const categories = ['All', 'Destination', 'Beginner Info']

interface Post {
  slug: string
  category: string
  title: string
  excerpt: string
  date: string
  readTime: string
  image: ImageMetadata
  imageAlt: string
  featured: boolean
}

const posts: Post[] = [
  {
    slug: '/blog/is-cocoa-beach-good-for-surfing',
    category: 'Destination',
    title: 'Is Cocoa Beach Good for Surfing? A Local Guide',
    excerpt: 'The honest breakdown on Cocoa Beach surf conditions, best times of year, beginner spots and what local instructors say about Florida\'s most surf-friendly coast.',
    date: 'May 27, 2026',
    readTime: '7 min read',
    image: imgSurf,
    imageAlt: 'Surf instructor and student at Cocoa Beach Florida',
    featured: true,
  },
  {
    slug: '/blog/beginners-guide-to-surfing',
    category: 'Beginner Info',
    title: "The Complete Beginner's Guide to Surfing",
    excerpt: 'Everything you need to know before you get in the water — the pop-up, gear, the 5 mistakes beginners make, and why a lesson beats trying it alone every time.',
    date: 'May 27, 2026',
    readTime: '8 min read',
    image: imgBeginner,
    imageAlt: 'Beginner surf lesson at Cocoa Beach with certified instructor',
    featured: false,
  },
  {
    slug: '/blog/surfing-near-orlando',
    category: 'Destination',
    title: 'Surfing Near Orlando — Best Spots & How to Get There',
    excerpt: 'Cocoa Beach is just 60 minutes from Orlando. Here\'s how to add a surf lesson to your Central Florida trip — without losing a full day to travel.',
    date: 'May 27, 2026',
    readTime: '6 min read',
    image: imgStudents,
    imageAlt: 'Surfers at Cocoa Beach Florida near Orlando',
    featured: false,
  },
]

const featured = posts.find(p => p.featured)
const rest = posts.filter(p => !p.featured)

const categoryColors: Record<string, string> = {
  'Destination':   'bg-amber-100 text-amber-700',
  'Beginner Info': 'bg-green-100 text-green-700',
}
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Surf Blog',href:'/blog'}]} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <section class="bg-gray-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: url('/images/surf-school-cocoa-beach-surf-instructor-student.webp'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/80 to-gray-900/95"></div>
    <div class="relative z-10 container mx-auto px-4 text-center">
      <span class="inline-block bg-[#00BCD4]/20 text-[#4DD0E1] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase border border-[#00BCD4]/30">
        Surf School Blog
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
        Surf Tips & Cocoa Beach Guides
      </h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto leading-relaxed">
        Learn how to surf faster, plan your Cocoa Beach trip, and get insider tips from our certified instructors at Cocosol Surf Lessons.
      </p>
    </div>
  </section>

  <!-- ── FEATURED POST ─────────────────────────────────────────────────────── -->
  {featured && (
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <p class="text-xs font-bold text-[#00BCD4] uppercase tracking-widest mb-6">Featured Article</p>
        <a href={featured.slug}
          class="group grid md:grid-cols-2 gap-10 items-center bg-gray-50 rounded-3xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/30 hover:shadow-xl transition-all duration-300">
          <div class="overflow-hidden" style="height: 360px;">
            <Image
              src={featured.image}
              alt={featured.imageAlt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[400, 700, 1000]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="p-8 md:p-10">
            <span class={`inline-block text-xs font-bold px-3 py-1 rounded-full mb-4 ${categoryColors[featured.category]}`}>
              {featured.category}
            </span>
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-4 leading-snug group-hover:text-[#00BCD4] transition-colors">
              {featured.title}
            </h2>
            <p class="text-gray-600 leading-relaxed mb-6">{featured.excerpt}</p>
            <div class="flex items-center gap-4 text-sm text-gray-400">
              <span>{featured.date}</span>
              <span>·</span>
              <span>{featured.readTime}</span>
            </div>
            <div class="mt-6 inline-flex items-center gap-2 text-[#00BCD4] font-semibold text-sm group-hover:gap-3 transition-all">
              Read Article
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ── ALL POSTS ─────────────────────────────────────────────────────────── -->
  <section class="pb-20 bg-white">
    <div class="container mx-auto px-4">

      <!-- Category filter -->
      <div id="filter-bar" class="flex flex-wrap gap-2 mb-10">
        {categories.map((cat, i) => (
          <button
            data-filter={cat}
            class={`filter-btn px-4 py-2 rounded-full text-sm font-semibold border transition-colors ${
              i === 0
                ? 'bg-[#00BCD4] text-white border-[#00BCD4]'
                : 'bg-white text-gray-600 border-gray-200 hover:border-[#00BCD4] hover:text-[#00BCD4]'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div id="posts-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {rest.map(post => (
          <a href={post.slug}
            data-category={post.category}
            class="post-card group flex flex-col bg-white rounded-3xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/30 hover:shadow-xl transition-all duration-300">
            <div class="overflow-hidden" style="height: 220px;">
              <Image
                src={post.image}
                alt={post.imageAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                widths={[300, 600, 900]}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-col flex-1 p-6">
              <span class={`inline-block self-start text-xs font-bold px-3 py-1 rounded-full mb-3 ${categoryColors[post.category]}`}>
                {post.category}
              </span>
              <h2 class="text-lg font-extrabold text-gray-900 mb-3 leading-snug group-hover:text-[#00BCD4] transition-colors flex-1">
                {post.title}
              </h2>
              <p class="text-gray-500 text-sm leading-relaxed mb-5 line-clamp-3">{post.excerpt}</p>
              <div class="flex items-center justify-between text-xs text-gray-400 mt-auto pt-4 border-t border-gray-100">
                <span>{post.date}</span>
                <span>{post.readTime}</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="py-16 bg-[#00BCD4]">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-extrabold text-white mb-4">Ready to Catch Your First Wave?</h2>
      <p class="text-white/80 max-w-xl mx-auto mb-8 leading-relaxed">
        Stop reading and start surfing. Book a lesson with our certified instructors in Cocoa Beach — all gear included, beginner-friendly waves, open 7 days.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/book-now" class="px-8 py-3.5 bg-white text-[#00BCD4] font-bold rounded-2xl hover:bg-gray-50 transition-colors shadow-lg">
          Book a Surf Lesson
        </a>
        <a href="/surf-packages-cocoa-beach" class="px-8 py-3.5 bg-white/15 text-white font-semibold rounded-2xl border border-white/30 hover:bg-white/25 transition-colors">
          View All Lessons
        </a>
      </div>
    </div>
  </section>

  <NeedHelp />

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn')
    const cards = document.querySelectorAll<HTMLElement>('.post-card')

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'All'

        buttons.forEach(b => {
          b.classList.remove('bg-[#00BCD4]', 'text-white', 'border-[#00BCD4]')
          b.classList.add('bg-white', 'text-gray-600', 'border-gray-200')
        })
        btn.classList.remove('bg-white', 'text-gray-600', 'border-gray-200')
        btn.classList.add('bg-[#00BCD4]', 'text-white', 'border-[#00BCD4]')

        cards.forEach(card => {
          const match = filter === 'All' || card.dataset.category === filter
          card.style.display = match ? '' : 'none'
        })
      })
    })
  </script>

</BaseLayout>
