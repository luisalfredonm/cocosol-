---
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import Sidebar from '../components/ui/Sidebar.astro'
import VideoSection from '../components/sections/VideoSection.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BookingWizard from '../components/booking/BookingWizard'
import { seoData } from '../lib/seo'

import heroImg  from '../assets/images/semi-private-surf-tamarindo-wave-riding.webp'
import gallery1 from '../assets/images/semi-private-surf-instructor-tamarindo.webp'
import gallery2 from '../assets/images/couple-surf-lessons-tamarindo-instructor.webp'
import gallery3 from '../assets/images/small-group-surf-lessons-tamarindo-2-3.webp'
import gallery4 from '../assets/images/semi-private-surf-costa-rica-beginner-board.webp'
import videoBg  from '../assets/images/semi-private-surf-tamarindo-2-person.webp'

const seo = seoData.semiPrivateLessons

const [heroW640, heroW1280, heroW1920] = await Promise.all([
  getImage({ src: heroImg, format: 'avif', width: 640 }),
  getImage({ src: heroImg, format: 'avif', width: 1280 }),
  getImage({ src: heroImg, format: 'avif', width: 1920 }),
])
const heroPreloadSrcSet = `${heroW640.src} 640w, ${heroW1280.src} 1280w, ${heroW1920.src} 1920w`

const faqs = [
  { question: 'What does a semi-private surf lesson include?', answer: 'Semi-private lessons include a certified instructor, surfboard, foam guard, safety briefing, and 90 minutes of instruction for 2-3 people.' },
  { question: 'Are semi-private surf lessons suitable for beginners?', answer: 'Absolutely! Semi-private lessons are perfect for beginners who want to share the experience with a partner or a friend while still getting personalized attention.' },
  { question: 'How long is a semi-private surf lesson?', answer: 'Each session is 90 minutes, including land training and time in the water.' },
  { question: 'Do you offer discounts for multiple semi-private lessons?', answer: 'Yes! Ask us about our Pura Vida Surf Packages which offer multiple lessons at a better rate than single sessions.' },
]

const cols = [
  { h: 'Who Can Take Surf Lessons?', items: ['Beginners', 'Kids', 'Intermediate Surfers', 'Families'] },
  { h: "What's Included",            items: ['90-minute surf lesson', 'Professional certified instructor', 'Foam guard', 'Safety briefing', 'Surfboard included', 'Photos on request'] },
  { h: 'Perfect For:',               items: ['Couples', 'Friends traveling together', 'Anyone who wants semi-private attention', 'People looking to learn and earn surf technique'] },
]

const gallery = [
  { img: gallery1, alt: 'Small group surf coaching Tamarindo board technique correction' },
  { img: gallery2, alt: 'Couple surf lessons Tamarindo with certified instructor in water' },
  { img: gallery3, alt: 'Small group surf lessons Tamarindo 2-3 students on beach' },
  { img: gallery4, alt: 'Semi-private surf lessons Costa Rica beginners on foam board' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <link slot="head" rel="preload" as="image" imagesrcset={heroPreloadSrcSet} imagesizes="100vw" fetchpriority="high" />
  <FAQSchema slot="head" items={faqs} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Semi-Private Surf Lessons Tamarindo — Small Group Surfing Experience"
    image={heroImg}
    imageAlt="Semi-private surf class Tamarindo couple riding wave together"
    objectPosition="center center"
    breadcrumb={{ label: 'Surf Lessons', href: '/tamarindo-surf-lessons' }}
    cta={{ label: 'Check Availability', href: '#book' }}
    height="large"
  />

  <!-- ── MAIN CONTENT ───────────────────────────────────────────────────────── -->
  <section class="py-20 container mx-auto px-4">
    <div class="grid lg:grid-cols-3 gap-12">

      <!-- Left col -->
      <div class="lg:col-span-2">

        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase">Up to 3 Students</span>
        <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Semi-Private Surf Lessons Tamarindo — Learn Together</h2>
        <p class="text-gray-700 leading-relaxed mb-4">Our <strong>semi-private surf lessons in Tamarindo</strong> are the perfect option for couples, friends, or small groups of 2-3 people who want to share the experience while still receiving personalized attention from a certified instructor. You get the social energy of learning with someone you know, plus the focused coaching that helps you progress faster.</p>
        <p class="text-gray-700 leading-relaxed mb-4">These small-group sessions are a great value — you share the cost with your group while still benefiting from a professional, certified surf instructor who adapts the session to your levels and goals.</p>
        <p class="text-gray-700 leading-relaxed mb-8">Whether you are a couple looking for a shared adventure, friends visiting Tamarindo for a week, or a family with kids, this format gives you real coaching without the higher cost of one-on-one instruction. Most students in our small-group sessions stand up on the board within the first 30 minutes on the water.</p>

        <!-- Comparison note -->
        <div class="bg-[#00BCD4]/5 border border-[#00BCD4]/20 rounded-2xl px-6 py-4 mb-8">
          <p class="text-gray-700 text-sm leading-relaxed"><strong>Semi-private vs. group lessons:</strong> Group lessons fit up to 6 students and are the most affordable entry point. Semi-private keeps it to 2-3 people maximum — your instructor spends far more time with each surfer, giving corrections after every wave. If you are traveling with a partner or a small group of friends and want faster results without paying for a private session, semi-private is the smartest choice.</p>
        </div>

        <!-- What to Expect -->
        <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 mb-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">What to Expect on the Day of Your Lesson</h3>
          <p class="text-gray-700 leading-relaxed text-sm">Your instructor will meet you on Tamarindo Beach for a 15-minute land warm-up covering ocean safety, paddling technique, and how to pop up correctly on the board. After the briefing, you move into the water for the rest of your 90-minute session. Expect real, hands-on coaching with corrections after every wave — not just a quick demonstration and then watching from the shore. All skill levels are welcome, and the instructor will adjust the coaching pace for each person in your group so nobody feels left behind. You do not need any prior experience. Just bring reef-safe sunscreen, a positive attitude, and a willingness to get in the water.</p>
        </div>

        <!-- 3-col cards -->
        <div class="grid md:grid-cols-3 gap-4 mb-8">
          {cols.map(col => (
            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-4 text-sm uppercase tracking-wide">{col.h}</h3>
              <ul class="space-y-2">
                {col.items.map(i => (
                  <li class="flex items-center gap-2.5 text-sm text-gray-600">
                    <span class="w-4 h-4 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0">
                      <svg class="w-2.5 h-2.5 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    {i}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Gallery -->
        <div class="grid grid-cols-2 gap-3 mb-10">
          {gallery.map(({ img, alt }, i) => (
            <div class={`overflow-hidden rounded-2xl shadow-sm h-40 ${i % 2 === 1 ? 'mt-4' : ''}`}>
              <Image
                src={img}
                alt={alt}
                class="w-full h-full block object-cover object-[center_20%] hover:scale-105 transition-transform duration-500"
                widths={[200, 400]}
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          ))}
        </div>

        <!-- FAQ -->
        <div class="border-t border-gray-100 pt-10">
          <FAQ items={faqs} title="Frequently Asked Questions" columns={1}/>
        </div>

      </div>

      <!-- Right col: Sidebar -->
      <div>
        <Sidebar
          price="$50"
          priceLabel="/ Per Person"
          includes={['90-minute surf lesson', 'Professional certified instructor', 'Surfboard included', 'Foam guard', 'Safety briefing', 'Photos on request']}
          ctaLabel="Check Availability"
          ctaHref="#book"
        />
      </div>

    </div>
  </section>

  <!-- ── VIDEO SECTION ──────────────────────────────────────────────────────── -->
  <VideoSection
    title="See What a Small-Group Surf Session Looks Like in Tamarindo"
    subtitle="Watch what a semi-private lesson looks like — personalized coaching for 2-3 people on Tamarindo Beach."
    bgImage={videoBg}
    bgImageAlt="2-person surf lesson Tamarindo with personalized instructor attention"
    cta={{ label: 'Check Availability', href: '#book' }}
  />

  <!-- ── BOOKING WIZARD ─────────────────────────────────────────────────────── -->
  <section id="book" class="py-16 bg-white min-h-[800px]" style="scroll-margin-top: 96px;">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Ready to Ride?</span>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Book Your Semi-Private Lesson</h2>
        <p class="text-gray-500 max-w-md mx-auto">Select your date and time below. Your semi-private lesson is pre-selected — just pick when you want to surf.</p>
      </div>
      <div class="max-w-4xl mx-auto">
        <BookingWizard preselectedType="semi-private" client:idle />
      </div>
      <p class="text-center mt-4 text-sm text-gray-400">Secure payments · Trusted instructors · Flexible rescheduling</p>
    </div>
  </section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <Testimonials items={[
    { name: 'Carlos & Maria',      role: 'Couple travelers', text: 'We did semi-private lessons as a couple and it was perfect. The instructor gave us individual feedback while we had fun together. Definitely recommend!' },
    { name: 'The Johnson Family',  role: 'Family',           text: 'Booked semi-private for our family of 3 and it was the highlight of our Costa Rica trip. Patient instructor, great waves, unforgettable experience.' },
  ]}/>

  <!-- ── NEED HELP ──────────────────────────────────────────────────────────── -->
  <NeedHelp/>

  <!-- ── SEO INTERNAL LINKS ─────────────────────────────────────────────────── -->
  <section class="py-10 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <h2 class="text-sm font-bold text-gray-500 mb-4 uppercase tracking-widest">Also Available at Pura Vida Surf School</h2>
      <div class="flex flex-wrap gap-2">
        {[
          { l: 'Private Surf Lessons Tamarindo', h: '/private-surf-lessons-tamarindo' },
          { l: 'Group Surf Lessons Tamarindo',   h: '/group-surf-lessons-tamarindo' },
          { l: 'Surf Camp Tamarindo',             h: '/surf-camp-tamarindo' },
          { l: 'Surf Packages',                   h: '/tamarindo-surf-packages' },
        ].map(x => (
          <a href={x.h} data-astro-prefetch="viewport"
            class="px-4 py-2 bg-white hover:bg-[#00BCD4]/8 border border-gray-200 hover:border-[#00BCD4]/40 hover:text-[#00BCD4] rounded-full text-sm text-gray-600 transition-colors font-medium">
            {x.l}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
