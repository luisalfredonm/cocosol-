    label: 'Email',
    value: 'info@puravidasurfschool.com',
    href: 'mailto:info@puravidasurfschool.com',
    highlight: false,
  },
]

const socials = [
  { label: 'Facebook',  href: 'https://www.facebook.com/profile.php?id=61578013897729',  icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { label: 'YouTube',   href: 'https://www.youtube.com/@puravidasurfschool',  icon: 'M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z' },
  { label: 'Instagram', href: 'https://www.instagram.com/pura_vidasurfschool', icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <HeroPreload slot="head" src={heroImg} />
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Contact Us',href:'/surf-school-near-me-tamarindo'}]} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Surf School Near Me in Tamarindo — Contact Us"
    image={heroImg}
    imageAlt="Surf school near me Tamarindo"
    breadcrumb={{ label: 'Contact' }}
    height="medium"
  />

  <!-- ── QUICK CONTACT STRIP ────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-gray-100 shadow-sm">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-100">
        {contactItems.map(c => (
          <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class={`flex items-center gap-4 py-5 px-6 transition-colors group ${c.highlight ? 'hover:bg-[#00BCD4]/5' : 'hover:bg-gray-50'}`}>
            <div class={`w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 ${c.highlight ? 'bg-[#00BCD4]/10' : 'bg-gray-100 group-hover:bg-[#00BCD4]/10'} transition-colors`}>
              <svg class={`w-5 h-5 ${c.highlight ? 'text-[#00BCD4]' : 'text-gray-500 group-hover:text-[#00BCD4]'} transition-colors`} fill="currentColor" viewBox="0 0 24 24">
                <path d={c.icon}/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-gray-400 uppercase tracking-wide">{c.label}</p>
              <p class={`text-sm font-semibold ${c.highlight ? 'text-[#00BCD4]' : 'text-gray-800 group-hover:text-[#00BCD4]'} transition-colors`}>{c.value}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── MAIN: TEXT + FORM ──────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-14 items-start">

        <!-- Left: text + CTA + social -->
        <div>
          <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase">We reply within the hour</span>
          <h2 class="text-4xl font-extrabold text-gray-900 leading-tight mb-5">Get in touch with us</h2>
          <p class="text-gray-600 leading-relaxed mb-4">If you're searching for a <strong>surf school near me Tamarindo</strong>, you've just found the perfect place. At Pura Vida Surf School, we make it easy to get in touch, ask questions, check availability, or book your surf lessons and surf camp packages in just a few minutes.</p>
          <p class="text-gray-600 leading-relaxed mb-6">Whether you're a beginner catching your first wave, an intermediate surfer looking to level up, or a traveler comparing options for the <strong>best surf school in Tamarindo</strong>, our team is here to guide you with fast responses, friendly support, and the pura vida spirit.</p>

          <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 mb-6">
            <h3 class="text-lg font-bold text-gray-900 mb-3">What to Expect After You Reach Out</h3>
            <p class="text-gray-700 leading-relaxed text-sm mb-3">Our team is available seven days a week and typically responds within the hour. When you contact us, share your preferred dates, the number of people in your group, and which experience you are interested in — private lessons, group sessions, packages, or a full surf camp. We will confirm availability and send you a complete breakdown of pricing with no hidden fees before you commit to anything.</p>
            <p class="text-gray-700 leading-relaxed text-sm mb-3">All lessons take place in the morning to make the most of the best wave conditions. Each session lasts approximately 90 minutes and includes all equipment, a safety briefing, and personalized coaching from a certified instructor. If you have special requests — a specific instructor, a particular location on the beach, or a session planned around a specific tide window — let us know and we will do our best to make it happen.</p>
            <p class="text-gray-700 leading-relaxed text-sm mb-3">We are located directly on Tamarindo Beach and welcome all visitors regardless of where they are staying. Whether your accommodation is a hostel in the center of town, a hotel right on the water, or a villa a short drive away, our team will be at the beach at the agreed time. No long commutes, no logistics headaches — just arrive at the beach and we handle everything from there.</p>
            <p class="text-gray-700 leading-relaxed text-sm">Peak season in Tamarindo runs from December through April, when bookings fill up quickly. Reserving your sessions in advance is strongly recommended during those months. Outside of peak season, we can usually accommodate same-day and next-day requests with no issue. For the fastest response, reach out via WhatsApp — our team replies within minutes during operating hours.</p>
          </div>

          <div class="space-y-2 mb-8">
            <details class="group border border-gray-100 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 list-none text-sm">
                How quickly do you respond to messages?
                <svg class="w-5 h-5 text-[#00BCD4] shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              </summary>
              <div class="px-5 pb-4 text-gray-600 text-sm">We aim to reply within the hour during business hours. WhatsApp is the fastest option if you need an immediate response. For email messages, please allow up to a few hours depending on the volume of inquiries we receive on that day.</div>
            </details>
            <details class="group border border-gray-100 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 list-none text-sm">
                Can I book same-day surf lessons in Tamarindo?
                <svg class="w-5 h-5 text-[#00BCD4] shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              </summary>
              <div class="px-5 pb-4 text-gray-600 text-sm">Same-day bookings are possible when space is available, especially outside of peak season. During high season from December to April, we recommend booking at least two to three days in advance to secure your preferred time and instructor.</div>
            </details>
            <details class="group border border-gray-100 rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-semibold text-gray-900 hover:bg-gray-50 list-none text-sm">
                Do you offer discounts for groups?
                <svg class="w-5 h-5 text-[#00BCD4] shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              </summary>
              <div class="px-5 pb-4 text-gray-600 text-sm">Yes. Groups of four or more receive preferential rates on lessons and packages. Contact us via WhatsApp or email with the number of people in your group and your preferred dates, and we will send you a custom quote with no obligation.</div>
            </details>
          </div>

          <!-- WhatsApp CTA -->
          <a href="https://wa.me/50661987851" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-[#00BCD4] hover:bg-[#0097A7] text-white font-bold px-7 py-4 rounded-2xl transition-colors shadow-lg shadow-[#00BCD4]/25 mb-8">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Chat with us on WhatsApp
          </a>

          <!-- Social icons -->
          <div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Follow us</p>
            <div class="flex gap-3">
              {socials.map(s => (
                <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
                  class="w-10 h-10 bg-gray-100 hover:bg-[#00BCD4]/10 border border-gray-200 hover:border-[#00BCD4]/30 rounded-2xl flex items-center justify-center transition-colors group">
                  <svg class="w-4 h-4 text-gray-500 group-hover:text-[#00BCD4] transition-colors" fill="currentColor" viewBox="0 0 24 24">
                    <path d={s.icon}/>
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm">
          <h3 class="text-xl font-bold text-gray-900 mb-6">Send us a message</h3>
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5">Name</label>
                <input type="text" name="name" placeholder="Full Name" required
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#00BCD4] focus:ring-2 focus:ring-[#00BCD4]/10 transition-all"/>
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5">Email</label>
                <input type="email" name="email" placeholder="Email Address" required
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#00BCD4] focus:ring-2 focus:ring-[#00BCD4]/10 transition-all"/>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5">Phone</label>
                <input type="tel" name="phone" placeholder="Phone Number"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#00BCD4] focus:ring-2 focus:ring-[#00BCD4]/10 transition-all"/>
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5">Subject</label>
                <input type="text" name="subject" placeholder="Subject"
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#00BCD4] focus:ring-2 focus:ring-[#00BCD4]/10 transition-all"/>
              </div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1.5">Message</label>
              <textarea name="message" rows="4" placeholder="Additional Message"
                class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-[#00BCD4] focus:ring-2 focus:ring-[#00BCD4]/10 transition-all resize-none"></textarea>
            </div>
            <button type="submit"
              class="w-full bg-[#00BCD4] hover:bg-[#0097A7] text-white font-bold py-3.5 rounded-2xl transition-colors shadow-sm shadow-[#00BCD4]/20">
              Send My Message
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- ── MAP + CONTACT INFO ─────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Find Us</span>
        <h2 class="text-3xl font-extrabold text-gray-900">Reach us here</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8 items-stretch max-w-4xl mx-auto">

        <!-- Map -->
        <div class="overflow-hidden rounded-3xl shadow-md h-80">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15722.56!2d-85.8415!3d10.2994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f9e4a4a4a4a4a4a%3A0x0!2sTamarindo%2C+Costa+Rica!5e0!3m2!1sen!2sus!4v1"
            class="w-full h-full border-0"
            loading="lazy"
            title="Pura Vida Surf School location Tamarindo"
            allowfullscreen
          ></iframe>
        </div>

        <!-- Info card -->
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm flex flex-col justify-between">
          <div class="space-y-5">
            {[
              { label: 'Location',     value: 'Tamarindo Beach, Costa Rica',        href: undefined,                              icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z' },
              { label: 'Email',        value: 'info@puravidasurfschool.com',         href: 'mailto:info@puravidasurfschool.com',    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
              { label: 'Phone',        value: '+506 6198-7851',                      href: 'tel:+50661987851',                      icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' },
              { label: 'WhatsApp',     value: 'Chat with us on WhatsApp',           href: 'https://wa.me/50661987851',             icon: 'M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .103 5.36.1 11.945c0 2.105.549 4.16 1.595 5.973L0 24l6.335-1.652a11.97 11.97 0 005.71 1.447h.006c6.585 0 11.946-5.361 11.948-11.947a11.9 11.9 0 00-3.478-8.399' },
            ].map(item => (
              <div class="flex items-start gap-4">
                <div class="w-9 h-9 bg-[#00BCD4]/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-[#00BCD4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold text-gray-400 uppercase tracking-wide">{item.label}</p>
                  {item.href
                    ? <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="text-sm font-semibold text-[#00BCD4] hover:underline">{item.value}</a>
                    : <p class="text-sm font-semibold text-gray-800">{item.value}</p>
                  }
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <NeedHelp/>

</BaseLayout>
