import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import HeroPreload from '../components/ui/HeroPreload.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData } from '../lib/seo'

import heroImg from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'

const seo = seoData.contact

const contactItems = [
