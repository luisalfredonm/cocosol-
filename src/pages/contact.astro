      grid-template-columns: 1fr 1fr;
    }
    .ct-wa-card, .ct-hours, .ct-social { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .ct-sidebar { grid-template-columns: 1fr; }
    .ct-wa-card, .ct-hours, .ct-social { grid-column: auto; }
    .ct-form-row { grid-template-columns: 1fr; }
    .ct-form-card { padding: 28px 22px; }
    .ct-map-wrap { aspect-ratio: 1/1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-reveal { opacity: 1; transform: none; transition: none; }
    .ct-spinner { animation: none; }
  }
</style>

<script>
  /* Reveal on scroll */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) }
      }),
      { threshold: 0.1 }
    )
    document.querySelectorAll('.ct-reveal').forEach(el => io.observe(el))
  } else {
    document.querySelectorAll('.ct-reveal').forEach(el => el.classList.add('in'))
  }

  /* Form submission */
  const form       = document.getElementById('contactForm') as HTMLFormElement
  const submitBtn  = document.getElementById('submitBtn')   as HTMLButtonElement
  const btnLabel   = document.getElementById('btnLabel')    as HTMLElement
  const btnArrow   = document.getElementById('btnArrow')    as HTMLElement
  const btnSpinner = document.getElementById('btnSpinner')  as HTMLElement
  const errBox     = document.getElementById('formError')   as HTMLElement
  const okBox      = document.getElementById('formSuccess') as HTMLElement
  const tokenField = document.getElementById('formToken')   as HTMLInputElement

  /* Anti-spam token. Fetched on load so the server can also measure how long
     the form took to fill, a submission under 3 seconds is not a human. */
  async function loadFormToken() {
    try {
      const res = await fetch('/api/contact-token', { cache: 'no-store' })
      const data = await res.json()
      tokenField.value = data.token ?? ''
    } catch {
      tokenField.value = ''
    }
  }
  loadFormToken()

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (!form.checkValidity()) { form.reportValidity(); return }

    submitBtn.disabled = true
    btnLabel.textContent = 'Sending…'
    btnArrow.classList.add('hidden')
    btnSpinner.classList.remove('hidden')
    errBox.hidden = true
    okBox.hidden  = true

    try {
      let res  = await fetch('/api/contact', { method: 'POST', body: new FormData(form) })
      let data = await res.json()

      // Token aged out (tab left open for hours). Refresh it and resend once,
      // so a real message is never lost to an expired token. The pause is not
      // optional: a token issued a moment ago would trip the server's 3-second
      // "filled in too fast" check and the message would be dropped silently.
      if (data.retry) {
        await loadFormToken()
        await new Promise(resolve => setTimeout(resolve, 3400))
        res  = await fetch('/api/contact', { method: 'POST', body: new FormData(form) })
        data = await res.json()
      }

      if (data.ok) {
        okBox.hidden = false
        form.reset()
        loadFormToken()   // reset() clears the token; issue a fresh one
      } else {
        errBox.hidden = false
      }
    } catch {
      errBox.hidden = false
    } finally {
      submitBtn.disabled = false
      btnLabel.textContent = 'Send Message'
      btnArrow.classList.remove('hidden')
      btnSpinner.classList.add('hidden')
    }
  })
</script>
