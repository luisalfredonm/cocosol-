  .ct-reveal.in { opacity: 1; transform: none; }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 960px) {
    .ct-grid, .ct-loc-grid { grid-template-columns: 1fr; gap: 28px; }
