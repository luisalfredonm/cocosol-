---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NeedHelp from '../../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro'
import BlogPostingSchema from '../../components/seo/BlogPostingSchema.astro'
import FAQSchema from '../../components/seo/FAQSchema.astro'
import { seoData } from '../../lib/seo'

const seo = seoData.whatIsSurfCamp

const included = [
  { icon: 'ðŸŒŠ', item: 'Daily surf lessons', detail: 'Usually 1â€“2 sessions per day with certified instructors. Morning sessions for best conditions.' },
  { icon: 'ðŸ›ï¸', item: 'Accommodation', detail: 'Shared or private rooms near the beach. Quality varies by camp â€” always check reviews.' },
  { icon: 'ðŸ½ï¸', item: 'Meals', detail: 'Breakfast and dinner included in most camps. Some include all meals. Check what\'s covered.' },
  { icon: 'ðŸ„', item: 'Surfboard and equipment', detail: 'All boards, leashes, and rash guards provided. No gear needed.' },
  { icon: 'ðŸ“¸', item: 'Surf photography/video', detail: 'Many camps include photo and video of your sessions â€” invaluable for analyzing your technique.' },
  { icon: 'ðŸŽ‰', item: 'Community and social events', detail: 'Surf movie nights, beach bonfires, group dinners. The social component is a major draw.' },
]

const types = [
  {
    name: 'Beginner Surf Camp',
    who: 'Complete newcomers',
    focus: 'Learning to stand up, ocean safety, wave reading',
    duration: '5â€“7 days',
    example: 'Our 5-day and 7-day surf camps at Pura Vida Surf School',
  },
  {
    name: 'Intermediate Progression Camp',
    who: 'Surfers who can stand up and ride waves',
    focus: 'Turning, positioning, reading the lineup, wave selection',
    duration: '5â€“10 days',
    example: 'Usually includes video analysis and technique drills',
  },
  {
    name: 'Surf & Yoga Retreat',
    who: 'Surfers seeking balance and flexibility training',
    focus: 'Morning yoga, afternoon surf. Recovery and mindset.',
    duration: '7â€“14 days',
    example: 'Popular with women\'s groups and couples',
  },
  {
    name: 'Luxury Surf Camp',
    who: 'Surfers who want premium experience',
    focus: 'Private lessons, chef-prepared meals, boutique accommodation',
    duration: 'Flexible',
    example: 'Smaller instructor-to-student ratios. Premium pricing.',
  },
]

const vsLessons = [
  { aspect: 'Duration', lesson: 'Single session (1.5â€“2 hrs)', camp: 'Multi-day immersion (5â€“14 days)' },
  { aspect: 'Progress', lesson: 'Learn the basics in one session', camp: 'Real, lasting progression â€” skills stick' },
  { aspect: 'Community', lesson: 'Solo or small group', camp: 'Full social experience with other surfers' },
  { aspect: 'Flexibility', lesson: 'Book any day, any time', camp: 'Fixed schedule â€” commit to the program' },
  { aspect: 'Cost', lesson: '$50â€“$150 per session', camp: '$500â€“$2,000+ for the full package' },
  { aspect: 'Best for', lesson: 'First-timers or travelers with limited time', camp: 'Those who want to truly learn to surf' },
]

const faqs = [
  { q: 'What is a surf camp?', a: 'A surf camp is a structured multi-day program that combines daily surf lessons with accommodation, meals, and often extra activities. Instead of a single lesson, you immerse yourself in surfing for 5â€“14 days with a consistent instructor who tracks your progress daily.' },
  { q: 'How much does a surf camp cost?', a: 'Surf camp prices range widely â€” from $500 to $3,000+ depending on duration, accommodation quality, and location. At Pura Vida Surf School, our 5-day surf camp starts at $850 and our 7-day camp at $1,200, both including accommodation, meals, and all lessons.' },
  { q: 'Do I need experience to join a surf camp?', a: 'No. Most surf camps have programs designed for complete beginners. You\'ll progress much faster in a camp environment than with occasional solo lessons â€” typically reaching a point in 7 days that would take months of weekend lessons to achieve.' },
  { q: 'How many hours of surfing per day in a surf camp?', a: 'Most camps offer 2 surf sessions per day â€” typically a 2-hour morning session (best conditions) and a shorter afternoon session. Total surf time is usually 3â€“4 hours per day, with coaching, video analysis, and recovery in between.' },
  { q: 'What is the best country for a surf camp?', a: 'Costa Rica is consistently ranked among the top surf camp destinations in the world â€” warm water, consistent waves, beginner-friendly spots, great infrastructure, and incredible nature. Tamarindo specifically is ideal for beginner and intermediate camps.' },
  { q: 'Is a surf camp worth it?', a: 'For most people, yes â€” especially if you\'ve tried a few single lessons without feeling real progress. The immersive format, daily feedback, and muscle memory built over 5â€“7 consecutive days produces dramatic improvement that single lessons cannot replicate.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms} type="article">
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Blog',href:'/blog'},{name:'What Is a Surf Camp',href:seo.slug}]} />
  <BlogPostingSchema slot="head" title={seo.title} description={seo.description} slug={seo.slug} datePublished="2026-05-06" image="/images/surf-school-tamarindo-private-class.webp" authorName="Victor NuÃ±ez" />
  <FAQSchema slot="head" items={faqs.map(f => ({ question: f.q, answer: f.a }))} />

  <!-- HERO -->
  <section class="bg-gray-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25" style="background-image: url('/images/surf-school-tamarindo-private-class.webp'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/70 to-gray-900/95"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-5">
          <a href="/blog" class="text-[#4DD0E1] text-sm font-semibold hover:underline">â† Blog</a>
          <span class="text-white/30">Â·</span>
          <span class="bg-orange-500/20 text-orange-300 text-xs font-bold px-3 py-1 rounded-full border border-orange-500/30">Surf Camp Guide</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
          What Is a Surf Camp? Everything You Need to Know
        </h1>
        <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
          How surf camps work, what's included, who they're for, and why a 7-day camp produces more progress than months of weekend lessons.
        </p>
        <div class="flex items-center gap-4 mt-6 text-sm text-white/50">
          <span>May 6, 2026</span>
          <span>Â·</span>
          <span>8 min read</span>
          <span>Â·</span>
          <span>By Victor NuÃ±ez</span>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <article class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xl text-gray-700 leading-relaxed mb-6">
          A surf camp is exactly what it sounds like â€” a structured, multi-day program where you live, eat, and breathe surfing. Instead of booking a single lesson on vacation and leaving without real skills, a surf camp gives you consecutive days of instruction, coaching, and ocean time that builds muscle memory and genuine ability.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          At <a href="/surf-camp-tamarindo" class="text-[#00BCD4] hover:underline">Pura Vida Surf School</a>, we run <a href="/5-days-surf-camp-tamarindo" class="text-[#00BCD4] hover:underline">5-day</a> and <a href="/7-days-surf-camp-tamarindo" class="text-[#00BCD4] hover:underline">7-day surf camps</a> in Tamarindo for beginners and intermediates. We've seen the transformation hundreds of times: someone arrives having never surfed, leaves catching waves independently and planning their next trip.
        </p>
      </div>
    </div>
  </article>

  <!-- WHAT'S INCLUDED -->
  <section class="pb-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-10 text-center">What's Typically Included in a Surf Camp</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {included.map(i => (
            <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5 flex gap-4">
              <span class="text-2xl shrink-0">{i.icon}</span>
              <div>
                <p class="font-bold text-gray-900 text-sm">{i.item}</p>
                <p class="text-gray-500 text-xs mt-1 leading-relaxed">{i.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TYPES -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-10 text-center">Types of Surf Camps</h2>
        <div class="space-y-4">
          {types.map(t => (
            <div class="bg-white border border-gray-100 rounded-2xl p-6">
              <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                <h3 class="font-extrabold text-gray-900">{t.name}</h3>
                <span class="text-xs font-bold text-[#00BCD4] bg-[#00BCD4]/10 px-3 py-1 rounded-full">{t.duration}</span>
              </div>
              <div class="grid md:grid-cols-3 gap-3">
                <div>
                  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Best for</p>
                  <p class="text-sm text-gray-700">{t.who}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Focus</p>
                  <p class="text-sm text-gray-700">{t.focus}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Example</p>
                  <p class="text-sm text-gray-700">{t.example}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CAMP VS LESSONS -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-10 text-center">Surf Camp vs Individual Lessons</h2>
        <div class="overflow-x-auto rounded-2xl border border-gray-100">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-900 text-white">
                <th class="text-left px-5 py-3 font-semibold">Aspect</th>
                <th class="text-left px-5 py-3 font-semibold">Individual Lesson</th>
                <th class="text-left px-5 py-3 font-semibold text-[#4DD0E1]">Surf Camp</th>
              </tr>
            </thead>
            <tbody>
              {vsLessons.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                  <td class="px-5 py-3 font-semibold text-gray-900">{row.aspect}</td>
                  <td class="px-5 py-3 text-gray-600">{row.lesson}</td>
                  <td class="px-5 py-3 text-gray-900 font-medium">{row.camp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-10 bg-gray-900 rounded-3xl p-6 md:p-8 text-center">
          <h3 class="text-2xl font-extrabold text-white mb-3">Ready to Join a Surf Camp in Tamarindo?</h3>
          <p class="text-white/70 max-w-xl mx-auto mb-6 text-sm leading-relaxed">
            Our <a href="/5-days-surf-camp-tamarindo" class="text-[#4DD0E1] hover:underline">5-day</a> and <a href="/7-days-surf-camp-tamarindo" class="text-[#4DD0E1] hover:underline">7-day surf camps</a> include accommodation, daily lessons, surf trips, equipment, and more. Limited spots per session.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="/surf-camp-tamarindo" class="px-6 py-3 bg-[#00BCD4] text-white font-bold rounded-xl hover:bg-[#00ACC1] transition-colors text-sm">
              View Surf Camp Options
            </a>
            <a href="/book-now" class="px-6 py-3 bg-white/10 text-white font-semibold rounded-xl border border-white/20 hover:bg-white/20 transition-colors text-sm">
              Book Now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map(f => (
            <div class="border border-gray-100 bg-white rounded-2xl p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-sm">{f.q}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-extrabold text-gray-900 mb-8">More from the Blog</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="/blog/is-tamarindo-good-for-beginner-surfers" class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-beginner-lesson.webp" alt="Beginner surfing Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-teal-600 bg-teal-100 px-2 py-0.5 rounded-full">Beginners</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">Is Tamarindo Good for Beginner Surfers?</h3>
            </div>
          </a>
          <a href="/blog/best-time-to-surf-tamarindo" class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-surf-instructor-student.webp" alt="Best time to surf Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-amber-600 bg-amber-100 px-2 py-0.5 rounded-full">Tamarindo Guide</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">Best Time to Surf in Tamarindo, Costa Rica</h3>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
