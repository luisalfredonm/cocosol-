---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NeedHelp from '../../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro'
import BlogPostingSchema from '../../components/seo/BlogPostingSchema.astro'
import { seoData } from '../../lib/seo'

const seo = seoData.bestTimeSurf

const months = [
  {
    name: 'December – April',
    label: 'Dry Season (High Season)',
    rating: 5,
    swell: 'Consistent 2–4 ft NW swells',
    wind: 'Offshore winds in the morning — ideal conditions',
    crowds: 'High (book in advance)',
    verdict: 'Best overall time. Ideal for beginners: clean waves, sunny skies, offshore wind every morning.',
    color: 'teal',
  },
  {
    name: 'May – June',
    label: 'Transition / Early Rainy Season',
    rating: 4,
    swell: 'SW groundswells start building',
    wind: 'Light variable winds, occasional onshore',
    crowds: 'Low (fewer tourists)',
    verdict: 'Great for intermediate surfers. Larger swells arrive. Fewer crowds and lower prices.',
    color: 'blue',
  },
  {
    name: 'July – August',
    label: 'Rainy Season (Papagayo Winds)',
    rating: 3,
    swell: 'Strong SW swells — solid 3–6 ft',
    wind: 'Papagayo offshore winds possible — can be choppy',
    crowds: 'Medium (school holidays)',
    verdict: 'Powerful waves, good for intermediates. Mornings can be excellent. Afternoon showers.',
    color: 'amber',
  },
  {
    name: 'September – November',
    label: 'Rainy Season (Green Season)',
    rating: 3,
    swell: 'SW swells, inconsistent',
    wind: 'Light onshore winds',
    crowds: 'Lowest of the year',
    verdict: 'Best value time to visit. Lush green landscape, empty lineup. Requires patience for good surf days.',
    color: 'green',
  },
]

const tips = [
  {
    icon: '🌅',
    title: 'Surf in the Morning',
    body: 'The best surf in Tamarindo is almost always in the early morning (6:00–10:00 AM). Offshore winds groom the waves and the crowd is minimal.',
  },
  {
    icon: '🌊',
    title: 'Check the Tide',
    body: 'Tamarindo works best on an incoming mid-tide. Low tide exposes rocks; high tide can make the shore break heavy. Our instructors always pick the right window.',
  },
  {
    icon: '🛫',
    title: 'Book in Advance for Peak Season',
    body: 'December through April fills up fast. If you plan to visit between Christmas and Easter, book your lessons at least 2–3 weeks ahead to secure your spot.',
  },
  {
    icon: '💸',
    title: 'Green Season = Best Value',
    body: 'September and October offer the lowest prices on accommodation and lessons. You trade consistency for savings — still plenty of good surf days.',
  },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} type="article">
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Blog',href:'/blog'},{name:'Best Time to Surf Tamarindo',href:seo.slug}]} />
  <BlogPostingSchema slot="head" title={seo.title} description={seo.description} slug={seo.slug} datePublished="2025-04-10" image="/images/surf-school-tamarindo-surf-instructor-student.webp" authorName="Pura Vida Surf School Team" />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <section class="bg-gray-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25" style="background-image: url('/images/surf-school-tamarindo-surf-instructor-student.webp'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/70 to-gray-900/95"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-5">
          <a href="/blog" class="text-[#4DD0E1] text-sm font-semibold hover:underline">← Blog</a>
          <span class="text-white/30">·</span>
          <span class="bg-amber-500/20 text-amber-300 text-xs font-bold px-3 py-1 rounded-full border border-amber-500/30">Tamarindo Guide</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
          Best Time to Surf in Tamarindo, Costa Rica
        </h1>
        <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
          Tamarindo offers surfable waves year-round, but knowing when to visit makes the difference between good and great conditions. Here's our local breakdown by month.
        </p>
        <div class="flex items-center gap-4 mt-6 text-sm text-white/50">
          <span>April 10, 2025</span>
          <span>·</span>
          <span>6 min read</span>
          <span>·</span>
          <span>By Pura Vida Surf School</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── ARTICLE BODY ──────────────────────────────────────────────────────── -->
  <article class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto prose prose-lg prose-gray">

        <p class="lead text-xl text-gray-700 leading-relaxed mb-8">
          One of the most common questions we get at Pura Vida Surf School is: <strong>"When is the best time to surf in Tamarindo?"</strong> The short answer — there's never a bad time. But if you want to plan around the best waves, wind, and weather, here's everything you need to know from locals who surf here every single day.
        </p>

        <h2 class="text-3xl font-extrabold text-gray-900 mt-12 mb-6">Tamarindo's Two Surf Seasons</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Costa Rica has two main seasons: <strong>dry season (December–April)</strong> and <strong>rainy season (May–November)</strong>. Both produce excellent surf, but for completely different reasons.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          During dry season, consistent NW groundswells create clean, manageable 2–4 ft waves — perfect for beginners. The famous offshore Papagayo winds groom the wave faces every morning, making conditions picture-perfect before 10 AM.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Rainy season brings larger SW swells from distant storms in the South Pacific. Waves can reach 6 ft+ and are more powerful — better for intermediate surfers. The plus side: far fewer tourists and unbeatable prices on accommodation.
        </p>

        <h2 class="text-3xl font-extrabold text-gray-900 mt-12 mb-6">Month-by-Month Surf Guide</h2>

      </div>
    </div>
  </article>

  <!-- ── MONTH GRID ────────────────────────────────────────────────────────── -->
  <section class="pb-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-6">
        {months.map((m) => (
          <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between mb-4">
              <div>
                <p class="font-extrabold text-gray-900 text-lg">{m.name}</p>
                <p class="text-xs text-gray-500 font-medium mt-0.5">{m.label}</p>
              </div>
              <div class="flex gap-0.5 mt-1">
                {Array.from({length: 5}).map((_, i) => (
                  <svg class={`w-4 h-4 ${i < m.rating ? 'text-[#00BCD4]' : 'text-gray-200'}`} fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
            </div>
            <ul class="space-y-2 mb-4">
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <span class="text-blue-500 mt-0.5">〰</span>
                <span><strong>Swell:</strong> {m.swell}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <span class="text-teal-500 mt-0.5">💨</span>
                <span><strong>Wind:</strong> {m.wind}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <span class="text-orange-400 mt-0.5">👥</span>
                <span><strong>Crowds:</strong> {m.crowds}</span>
              </li>
            </ul>
            <p class="text-sm text-gray-700 bg-white rounded-xl px-4 py-3 border border-gray-100 leading-relaxed">
              {m.verdict}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TIPS ──────────────────────────────────────────────────────────────── -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8 text-center">Local Tips for Your Surf Trip</h2>
        <div class="grid md:grid-cols-2 gap-5">
          {tips.map(t => (
            <div class="bg-white border border-gray-100 rounded-2xl p-5">
              <div class="text-2xl mb-3">{t.icon}</div>
              <h3 class="font-bold text-gray-900 mb-2">{t.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{t.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONTINUED ARTICLE ─────────────────────────────────────────────────── -->
  <article class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto prose prose-gray">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6">What Level Do I Need to Surf Tamarindo?</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Tamarindo's main beach is a slow-breaking beach break — one of the most forgiving in Central America. If you're a complete beginner, <strong>any time of year is suitable</strong>, as long as you book lessons with a certified instructor who knows how to read the conditions and pick the right spot for your level.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          At Pura Vida Surf School, our instructors monitor surf conditions daily. We never put beginners in waves that are too big. If the main break is overhead and powerful, we take you to an alternative spot — there are several around Tamarindo that are protected and gentle year-round.
        </p>

        <h2 class="text-3xl font-extrabold text-gray-900 mt-12 mb-6">Our Verdict: When to Come</h2>
        <ul class="space-y-3 text-gray-600 leading-relaxed">
          <li><strong>Beginners:</strong> December – April. Clean conditions every morning. Gentle 2–3 ft waves that are easy to read and catch.</li>
          <li><strong>Intermediates:</strong> May – August. Larger, more powerful swells to challenge your technique. Still surfable every day.</li>
          <li><strong>Budget travelers:</strong> September – November. Lowest prices, empty beaches, green jungle. Surf is inconsistent but reward is real.</li>
          <li><strong>Families:</strong> December – March. Warm water, clean waves, calm mornings — the perfect scenario for kids and adults alike.</li>
        </ul>

        <div class="mt-12 bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-3xl p-6 md:p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Ready to Plan Your Surf Trip?</h3>
          <p class="text-gray-600 mb-5 text-sm leading-relaxed">
            Tell us when you're coming and your experience level — we'll help you pick the right lesson, time slot, and conditions for an unforgettable session.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/book-now" class="px-6 py-3 bg-[#00BCD4] text-white font-bold rounded-xl hover:bg-[#00ACC1] transition-colors text-sm">
              Book a Surf Lesson
            </a>
            <a href="https://wa.me/50661987851" target="_blank" rel="noopener" class="px-6 py-3 bg-[#25D366] text-white font-bold rounded-xl hover:bg-[#20BA5A] transition-colors text-sm">
              Ask on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- ── RELATED POSTS ─────────────────────────────────────────────────────── -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-extrabold text-gray-900 mb-8">More from the Blog</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="/blog/what-to-expect-first-surf-lesson-tamarindo"
            class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-beginner-lesson.webp" alt="First surf lesson Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-full">Beginners</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">What to Expect on Your First Surf Lesson in Tamarindo</h3>
            </div>
          </a>
          <a href="/tamarindo-surf-lessons"
            class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-private-class.webp" alt="Surf lessons Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full">Lessons</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">All Surf Lessons at Pura Vida Surf School</h3>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
