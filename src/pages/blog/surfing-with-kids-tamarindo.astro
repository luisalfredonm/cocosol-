---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NeedHelp from '../../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro'
import BlogPostingSchema from '../../components/seo/BlogPostingSchema.astro'
import FAQSchema from '../../components/seo/FAQSchema.astro'
import { seoData } from '../../lib/seo'

const seo = seoData.surfingWithKids

const tips = [
  {
    icon: '👶',
    title: 'Best Age to Start',
    body: 'We successfully teach kids as young as 5 years old. The ideal starting age is 6–8 — at this point children have enough strength to paddle, coordination to pop up, and attention span for a 90-minute lesson. Younger kids (4–5) can try with a parent in the water alongside them.',
  },
  {
    icon: '🏄',
    title: 'Use the Right Board',
    body: 'Kids should always start on a large, soft-top foam board. These are stable, buoyant, and won\'t hurt them if they fall. Never put a child on a hard epoxy board for their first sessions — the extra flotation of a foam board is what allows them to stand up quickly.',
  },
  {
    icon: '🌊',
    title: 'Pick the Right Conditions',
    body: 'Tamarindo\'s gentle beach break is one of the safest in Central America for children. Morning sessions during dry season offer the calmest conditions — small, slow-breaking waves that give kids the time they need to stand up without panic.',
  },
  {
    icon: '⏱️',
    title: 'Keep Sessions Short',
    body: 'Children get tired (and excited) faster than adults. A 60–90 minute lesson is ideal for kids under 10. Going longer usually means the last 30 minutes are spent dealing with a tired, frustrated child. Quality over quantity — leave while they\'re still stoked.',
  },
  {
    icon: '☀️',
    title: 'Sun Protection is Critical',
    body: 'Children\'s skin burns much faster than adult skin. Apply reef-safe SPF 50+ sunscreen 30 minutes before entering the water, and reapply every 2 hours. A UV-protective rash guard is non-negotiable — we provide these in all our family lessons.',
  },
  {
    icon: '🎉',
    title: 'Make it Fun, Not Stressful',
    body: 'The goal of a child\'s first surf lesson is not to surf perfectly — it\'s to love the ocean. Our instructors are trained to keep sessions playful, celebratory, and pressure-free. Kids who have fun on day 1 want to come back on day 2.',
  },
]

const faqs = [
  { q: 'What age can kids start surfing in Tamarindo?', a: 'We teach children as young as 5 years old. The ideal starting age is 6–8, when kids have enough strength, coordination, and attention span for a full lesson. Teenagers learn very fast — they typically progress faster than adults.' },
  { q: 'Is surfing safe for children?', a: 'Yes, when done with certified instructors in appropriate conditions. Tamarindo\'s gentle beach break is one of the safest learning environments for kids in Costa Rica. Our instructors are trained in water safety and child supervision.' },
  { q: 'Do parents need to surf too?', a: 'No. Parents are welcome to watch from the beach while instructors take kids in the water. If parents want to join the lesson, we offer family lessons where adults and kids learn together.' },
  { q: 'What equipment do kids need for a surf lesson?', a: 'Just a swimsuit and reef-safe sunscreen. We provide the surfboard (a large foam board appropriate for their size), leash, and rash guard. No prior equipment purchase needed.' },
  { q: 'Can my child learn to surf if they are nervous about the ocean?', a: 'Absolutely. Our instructors are experienced at working with nervous children. We start very gently — beach games, getting comfortable with the waves, before ever catching a wave. Many of our most enthusiastic students started out afraid of the water.' },
  { q: 'Do you offer surf camps for kids?', a: 'Yes. Our surf camps include daily lessons and are suitable for children aged 8 and up. For younger kids, we recommend booking private or family lessons where they get one-on-one attention from an instructor.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} type="article">
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Blog',href:'/blog'},{name:'Surfing with Kids Tamarindo',href:seo.slug}]} />
  <BlogPostingSchema slot="head" title={seo.title} description={seo.description} slug={seo.slug} datePublished="2026-05-06" image="/images/surf-school-tamarindo-students.webp" authorName="Pura Vida Surf School Team" />
  <FAQSchema slot="head" items={faqs.map(f => ({ question: f.q, answer: f.a }))} />

  <!-- HERO -->
  <section class="bg-gray-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25" style="background-image: url('/images/surf-school-tamarindo-students.webp'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/70 to-gray-900/95"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-5">
          <a href="/blog" class="text-[#4DD0E1] text-sm font-semibold hover:underline">← Blog</a>
          <span class="text-white/30">·</span>
          <span class="bg-pink-500/20 text-pink-300 text-xs font-bold px-3 py-1 rounded-full border border-pink-500/30">Family</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
          Surfing with Kids in Tamarindo
        </h1>
        <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
          What parents need to know before booking surf lessons for their children in Costa Rica — age requirements, safety, tips, and what a great session looks like for kids.
        </p>
        <div class="flex items-center gap-4 mt-6 text-sm text-white/50">
          <span>May 6, 2026</span>
          <span>·</span>
          <span>7 min read</span>
          <span>·</span>
          <span>By Pura Vida Surf School</span>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <article class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xl text-gray-700 leading-relaxed mb-6">
          One of the most rewarding things we do at <a href="/best-surf-school-in-tamarindo" class="text-[#00BCD4] hover:underline">Pura Vida Surf School</a> is watching a child catch their first wave. The scream of joy, the huge smile, the immediate "again, again!" — it never gets old.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          Surfing is one of the few activities the whole family can do together, at all ages and all levels. Tamarindo's gentle beach break and warm water (26–29°C year-round) make it one of the safest and most accessible surf destinations for families in all of Central America.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Here is everything parents ask us before booking — answered honestly by instructors who teach children every single week.
        </p>
      </div>
    </div>
  </article>

  <!-- TIPS GRID -->
  <section class="pb-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-10 text-center">6 Things Parents Need to Know</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {tips.map(t => (
            <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 hover:shadow-md transition-shadow">
              <span class="text-3xl">{t.icon}</span>
              <h3 class="font-extrabold text-gray-900 mt-3 mb-2">{t.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{t.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT A FAMILY LESSON LOOKS LIKE -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6">What a Family Surf Lesson Looks Like</h2>
        <div class="space-y-4">
          {[
            { time: 'Before you arrive', text: 'We ask about your children\'s swimming ability, age, and any fears. This helps us assign the right instructor and plan the right spot on the beach for the session.' },
            { time: 'First 15–20 minutes', text: 'Dry-land session. Kids learn the pop-up technique on the sand — it\'s like a game. We make it fun with cheering and encouragement. Even the parents usually can\'t resist joining.' },
            { time: 'In the water', text: 'Instructor walks the child into the water, positions them on the board, and pushes them into a gentle wave on cue. For younger kids, the instructor is right next to them in the water the entire time.' },
            { time: 'The magic moment', text: 'The first wave they stand up on. Every child\'s reaction is different — some scream, some laugh, some immediately look back for the instructor\'s reaction. All of them want to do it again.' },
            { time: 'After the lesson', text: 'Photos and videos from the session. A debrief on what they did well and what to work on next time. High fives all around.' },
          ].map(item => (
            <div class="bg-white border border-gray-100 rounded-2xl p-5 flex gap-4">
              <div class="shrink-0 w-2 bg-[#00BCD4] rounded-full"></div>
              <div>
                <p class="font-bold text-gray-900 text-sm mb-1">{item.time}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{item.text}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10 grid md:grid-cols-2 gap-4">
          <a href="/family-surf-lessons-tamarindo" class="block bg-[#00BCD4] text-white rounded-2xl p-5 hover:bg-[#00ACC1] transition-colors">
            <p class="font-extrabold text-lg mb-1">Family Surf Lessons</p>
            <p class="text-white/80 text-sm">Parents + kids learning together. All ages welcome.</p>
          </a>
          <a href="/book-now" class="block bg-gray-900 text-white rounded-2xl p-5 hover:bg-gray-800 transition-colors">
            <p class="font-extrabold text-lg mb-1">Book Now</p>
            <p class="text-white/60 text-sm">Reserve your family session online in minutes.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8">Parent FAQs</h2>
        <div class="space-y-4">
          {faqs.map(f => (
            <div class="border border-gray-100 rounded-2xl p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-sm">{f.q}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-extrabold text-gray-900 mb-8">More from the Blog</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="/blog/is-tamarindo-good-for-beginner-surfers" class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-beginner-lesson.webp" alt="Beginner surfing Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-teal-600 bg-teal-100 px-2 py-0.5 rounded-full">Beginners</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">Is Tamarindo Good for Beginner Surfers?</h3>
            </div>
          </a>
          <a href="/blog/what-to-expect-first-surf-lesson-tamarindo" class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-private-class.webp" alt="First surf lesson Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-full">Beginners</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">What to Expect on Your First Surf Lesson</h3>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
