---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NeedHelp from '../../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro'
import BlogPostingSchema from '../../components/seo/BlogPostingSchema.astro'
import { seoData } from '../../lib/seo'

const seo = seoData.firstSurfLesson

const timeline = [
  {
    step: '1',
    time: '30 min before',
    title: 'Arrival & Check-In',
    body: 'Meet your instructor at our surf school on the beach. We\'ll check you in, fit you with the right surfboard and leash, and apply reef-safe sunscreen. No experience needed — just show up.',
  },
  {
    step: '2',
    time: 'First 20 min',
    title: 'Beach Lesson (Dry Land)',
    body: 'Before touching the water, your instructor runs you through the fundamentals: how to read the ocean, the pop-up technique, foot placement, and where to look. This part is crucial — most people can stand up on their first wave after a good dry-land session.',
  },
  {
    step: '3',
    time: 'Next 15 min',
    title: 'Entering the Water',
    body: "Your instructor walks you into the water and teaches you how to paddle through the white water. They'll position you perfectly so you don't waste energy. The first few attempts are about feeling the board.",
  },
  {
    step: '4',
    time: 'The good part',
    title: 'Catching Your First Wave',
    body: "Your instructor will push you into a gentle wave and tell you exactly when to pop up. Most of our students stand up on their first or second attempt. The feeling is indescribable — pure stoke.",
  },
  {
    step: '5',
    time: 'Rest of the session',
    title: 'Surf, Learn, Repeat',
    body: "For the remaining 45–60 minutes, you'll keep catching waves while your instructor gives real-time tips on stance, balance, and wave selection. You'll catch 10–20 waves in a typical lesson.",
  },
  {
    step: '6',
    time: 'After the lesson',
    title: 'Debrief & Photos',
    body: "Back on the beach, your instructor reviews your progress, answers questions, and sends you any photos or videos taken during the session. You'll leave with a huge smile and a plan for next time.",
  },
]

const faqs = [
  { q: "Do I need to know how to swim?", a: "Yes, basic swimming ability is required for safety. You don't need to be a strong swimmer, but you should be comfortable in the water." },
  { q: "What should I wear?", a: "Wear a swimsuit or board shorts. We provide a rash guard to protect against sunburn. Avoid cotton clothes — they get heavy in the water." },
  { q: "Is it dangerous?", a: "Tamarindo's beach break is one of the safest learning environments in Central America. Our certified instructors prioritize safety and always match the conditions to your level." },
  { q: "What if I'm really nervous?", a: "Totally normal! Our instructors are patient, encouraging, and have taught hundreds of first-timers. The nerves disappear the moment you catch your first wave." },
  { q: "What's included in the lesson?", a: "Surfboard, leash, rash guard, reef-safe sunscreen, instructor, and all necessary equipment. Just show up." },
  { q: "How long is the lesson?", a: "Lessons are typically 1.5 to 2 hours including the dry-land session. Group lessons are 90 minutes; private lessons are up to 2 hours." },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} type="article">
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Blog',href:'/blog'},{name:'First Surf Lesson Tamarindo',href:seo.slug}]} />
  <BlogPostingSchema slot="head" title={seo.title} description={seo.description} slug={seo.slug} datePublished="2025-04-18" image="/images/surf-school-tamarindo-beginner-lesson.webp" authorName="Victor Nuñez" />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <section class="bg-gray-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-25" style="background-image: url('/images/surf-school-tamarindo-beginner-lesson.webp'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/70 to-gray-900/95"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-5">
          <a href="/blog" class="text-[#4DD0E1] text-sm font-semibold hover:underline">← Blog</a>
          <span class="text-white/30">·</span>
          <span class="bg-green-500/20 text-green-300 text-xs font-bold px-3 py-1 rounded-full border border-green-500/30">Beginners</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
          What to Expect on Your First Surf Lesson in Tamarindo
        </h1>
        <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
          Nervous about your first surf lesson? Here's exactly what happens from the moment you arrive at the beach to catching your first wave — no experience needed.
        </p>
        <div class="flex items-center gap-4 mt-6 text-sm text-white/50">
          <span>April 18, 2025</span>
          <span>·</span>
          <span>5 min read</span>
          <span>·</span>
          <span>By Victor Nuñez</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INTRO ─────────────────────────────────────────────────────────────── -->
  <article class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xl text-gray-700 leading-relaxed mb-6">
          Every single one of our instructors at Pura Vida Surf School remembers their first wave. The nerves, the wobble, and then — pure joy. If you're about to take your first surf lesson in Tamarindo and you're wondering what happens, this guide is for you.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          The good news: <strong>you don't need any experience, a specific body type, or extraordinary athletic ability</strong>. If you can lie down on a board and stand up, you can surf. We've seen 6-year-olds and 70-year-olds catch their first wave with us.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Here's a step-by-step breakdown of exactly what happens during your first surf lesson at our school in Tamarindo, Costa Rica.
        </p>
      </div>
    </div>
  </article>

  <!-- ── TIMELINE ──────────────────────────────────────────────────────────── -->
  <section class="pb-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-10">Step-by-Step: Your First Surf Lesson</h2>
        <div class="space-y-6">
          {timeline.map((item) => (
            <div class="flex gap-5 group">
              <div class="flex flex-col items-center">
                <div class="w-10 h-10 rounded-full bg-[#00BCD4] text-white font-extrabold text-sm flex items-center justify-center shrink-0 shadow-sm">
                  {item.step}
                </div>
                <div class="w-0.5 bg-gray-100 flex-1 mt-2"></div>
              </div>
              <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5 flex-1 mb-1">
                <p class="text-xs font-bold text-[#00BCD4] uppercase tracking-wider mb-1">{item.time}</p>
                <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHAT TO BRING ─────────────────────────────────────────────────────── -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8">What to Bring to Your First Surf Lesson</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {[
            { icon: '👙', item: 'Swimsuit or board shorts', note: 'Comfortable in the water. No cotton.' },
            { icon: '🕶️', item: 'Sunglasses & sunscreen', note: 'Apply reef-safe SPF before you arrive.' },
            { icon: '💧', item: 'Water bottle', note: 'Surfing is more tiring than it looks!' },
            { icon: '📷', item: 'A camera or phone', note: 'Your instructor will capture your first wave.' },
            { icon: '👟', item: 'No shoes needed', note: 'You surf barefoot. Flip flops are fine to walk over.' },
            { icon: '😎', item: 'Good attitude', note: 'The only thing that actually matters.' },
          ].map(b => (
            <div class="flex items-start gap-3 bg-white border border-gray-100 rounded-xl p-4">
              <span class="text-2xl">{b.icon}</span>
              <div>
                <p class="font-semibold text-gray-900 text-sm">{b.item}</p>
                <p class="text-gray-500 text-xs mt-0.5">{b.note}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-gray-500 bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-xl p-4">
          <strong class="text-gray-700">Everything else is included:</strong> surfboard, leash, rash guard, reef-safe sunscreen, and full instruction. Just show up.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────────── -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8">First-Timer FAQs</h2>
        <div class="space-y-4">
          {faqs.map(f => (
            <div class="border border-gray-100 rounded-2xl p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-sm">{f.q}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────────── -->
  <section class="py-16 bg-[#00BCD4]">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl font-extrabold text-white mb-4">Ready to Catch Your First Wave?</h2>
      <p class="text-white/80 max-w-xl mx-auto mb-8 leading-relaxed">
        Stop reading and start surfing. Book a beginner lesson with our certified instructors in Tamarindo and experience the pura vida life.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/book-now?type=private" class="px-8 py-3.5 bg-white text-[#00BCD4] font-bold rounded-2xl hover:bg-gray-50 transition-colors shadow-lg">
          Book a Private Lesson
        </a>
        <a href="/book-now?type=group" class="px-8 py-3.5 bg-white/15 text-white font-semibold rounded-2xl border border-white/30 hover:bg-white/25 transition-colors">
          Book a Group Lesson
        </a>
      </div>
    </div>
  </section>

  <!-- ── RELATED POSTS ─────────────────────────────────────────────────────── -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-extrabold text-gray-900 mb-8">More from the Blog</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="/blog/best-time-to-surf-tamarindo"
            class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-surf-instructor-student.webp" alt="Best time to surf Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-amber-600 bg-amber-100 px-2 py-0.5 rounded-full">Tamarindo Guide</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">Best Time to Surf in Tamarindo, Costa Rica</h3>
            </div>
          </a>
          <a href="/private-surf-lessons-tamarindo"
            class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-private-class.webp" alt="Private surf lessons Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full">Lessons</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">Private Surf Lessons in Tamarindo</h3>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
