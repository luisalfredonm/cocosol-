        ))}
      </div>
    </div>
  </section>

  <!-- INTERNAL LINKS -->
  <section class="py-12 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 max-w-2xl">
      <h2 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-5">More from Cocosol Surf Lessons</h2>
      <div class="flex flex-wrap gap-3">
        {[
          { l: 'Book a Lesson', h: '/book-now' },
          { l: 'Private Surf Lessons', h: '/private-surf-lessons-cocoa-beach' },
          { l: 'Group Surf Lessons', h: '/group-surf-lessons-cocoa-beach' },
          { l: 'Surf Packages & Pricing', h: '/surf-packages-cocoa-beach' },
          { l: 'Is Cocoa Beach Good for Surfing?', h: '/blog/is-cocoa-beach-good-for-surfing' },
          { l: 'Surfing Near Orlando', h: '/blog/surfing-near-orlando' },
          { l: 'Plan a Cocoa Beach Surf Trip', h: '/blog/plan-a-cocoa-beach-surf-trip' },
          { l: 'Kids Surf Lessons', h: '/kids-surf-lessons-cocoa-beach' },
        ].map(x => (
          <a href={x.h} class="px-4 py-2 bg-gray-50 border border-gray-200 rounded-full text-sm text-gray-600 font-medium hover:border-[#00BCD4]/50 hover:text-[#00838F] transition-colors">{x.l}</a>
        ))}
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>

<style>
  .prose h2 { font-family: var(--font-display); color: var(--c-heading); margin-top: 2.5rem; margin-bottom: 1rem; }
  .prose h3 { color: var(--c-heading); margin-top: 1.75rem; }
