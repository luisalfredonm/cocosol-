---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NeedHelp from '../../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro'
import BlogPostingSchema from '../../components/seo/BlogPostingSchema.astro'
import FAQSchema from '../../components/seo/FAQSchema.astro'
import { seoData } from '../../lib/seo'

const seo = seoData.packingList

const categories = [
  {
    title: 'Surf Gear',
    note: 'Provided by your school — no need to bring',
    emoji: '🏄',
    items: [
      { name: 'Surfboard', note: 'Included in all lessons at Pura Vida Surf School', provided: true },
      { name: 'Leash', note: 'Included', provided: true },
      { name: 'Rash guard (short or long sleeve)', note: 'Included — but bring your own if you prefer a specific fit', provided: false },
      { name: 'Reef-safe sunscreen SPF 50+', note: 'Critical — regular sunscreen destroys coral reefs and is banned on many beaches', provided: false },
      { name: 'Board shorts / bikini', note: 'Quick-dry fabric. Avoid cotton in the water.', provided: false },
      { name: 'Surf wax (if renting your own board)', note: 'Optional if you\'re taking lessons — boards are already waxed', provided: false },
    ],
  },
  {
    title: 'Clothing',
    note: 'Tamarindo is hot and casual — pack light',
    emoji: '👕',
    items: [
      { name: 'Light t-shirts and tanks', note: '4–5 for a week-long trip', provided: false },
      { name: 'Shorts', note: '3–4 pairs. Quick-dry preferred.', provided: false },
      { name: 'Light long-sleeve layer', note: 'For evenings or overnight AC', provided: false },
      { name: 'Flip flops / sandals', note: 'You\'ll live in these', provided: false },
      { name: 'One pair of closed shoes', note: 'For hiking or excursions', provided: false },
      { name: 'Light rain jacket', note: 'Essential in rainy season (May–November)', provided: false },
    ],
  },
  {
    title: 'Health & Safety',
    note: 'Don\'t skip this section',
    emoji: '🏥',
    items: [
      { name: 'Reef-safe sunscreen (SPF 50+)', note: 'You will burn. Reapply every 2 hours in the water.', provided: false },
      { name: 'After-sun lotion or aloe vera', note: 'For the inevitable sunburn on day 1', provided: false },
      { name: 'Insect repellent (DEET-based)', note: 'Mosquitoes are present in rainy season', provided: false },
      { name: 'Basic first aid kit', note: 'Band-aids, antiseptic, ibuprofen', provided: false },
      { name: 'Motion sickness tablets', note: 'If prone — the dirt road into Tamarindo can be bumpy', provided: false },
      { name: 'Prescription medications', note: 'Bring extras — pharmacies exist but stock varies', provided: false },
    ],
  },
  {
    title: 'Tech & Documents',
    note: 'Keep documents in a waterproof bag or hotel safe',
    emoji: '📱',
    items: [
      { name: 'Passport (valid 6+ months)', note: 'Required for entry to Costa Rica', provided: false },
      { name: 'Travel insurance documents', note: 'Medical evac coverage is strongly recommended', provided: false },
      { name: 'Unlocked phone + local SIM or eSIM', note: 'Kolbi and Claro offer good coverage in Tamarindo', provided: false },
      { name: 'Waterproof phone case or dry bag', note: 'Essential for beach days and boat trips', provided: false },
      { name: 'GoPro or action camera', note: 'Your instructor can film your waves — check if your school offers this', provided: false },
      { name: 'Universal travel adapter', note: 'Costa Rica uses US-style plugs (Type A/B) — no adapter needed from the US', provided: false },
      { name: 'Portable charger / power bank', note: 'Beach days drain your battery fast', provided: false },
    ],
  },
  {
    title: 'Beach Essentials',
    note: 'Quality-of-life items you\'ll use every day',
    emoji: '🌊',
    items: [
      { name: 'Quick-dry towel (microfiber)', note: 'Packs small, dries fast — worth it', provided: false },
      { name: 'Reusable water bottle', note: 'Tap water is drinkable in Tamarindo but bring a bottle for the beach', provided: false },
      { name: 'Sunglasses (UV400)', note: 'Polarized lenses help on the water', provided: false },
      { name: 'Rashguard (extra)', note: 'One for surfing, one for casual beach wear', provided: false },
      { name: 'Small day backpack', note: 'For beach trips, market visits, and excursions', provided: false },
    ],
  },
]

const faqs = [
  { q: 'Do I need to bring my own surfboard to Costa Rica?', a: 'No. All surf schools in Tamarindo, including Pura Vida Surf School, provide surfboards as part of the lesson. If you\'re an experienced surfer who wants your own board, airlines allow boards as checked luggage — expect fees of $50–$150 each way.' },
  { q: 'What sunscreen should I use in Costa Rica?', a: 'Always use reef-safe sunscreen — oxybenzone and octinoxate are harmful to coral reefs and banned in some Costa Rican beaches. Choose mineral-based sunscreens with zinc oxide or titanium dioxide. SPF 50+ is recommended.' },
  { q: 'Is tap water safe to drink in Tamarindo?', a: 'Generally yes — Tamarindo\'s tap water is treated and considered safe. However, some travelers with sensitive stomachs prefer bottled water for the first few days. Bottled water is cheap and widely available.' },
  { q: 'What should I wear to a surf lesson?', a: 'Board shorts or a bikini — and that\'s it. Your school provides the rash guard and leash. Wear quick-dry synthetic fabrics, never cotton. Apply reef-safe sunscreen before you arrive.' },
  { q: 'Do I need a visa for Costa Rica?', a: 'Citizens of the US, Canada, EU, UK, and most Western nations don\'t need a visa for stays up to 90 days. You need a valid passport (6+ months remaining) and proof of onward travel. Always verify entry requirements before your trip.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Blog',href:'/blog'},{name:'Surf Trip Packing List',href:seo.slug}]} />
  <BlogPostingSchema slot="head" title={seo.title} description={seo.description} slug={seo.slug} datePublished="2026-05-06" image="/images/surf-school-tamarindo-students.webp" />
  <FAQSchema slot="head" items={faqs.map(f => ({ question: f.q, answer: f.a }))} />

  <!-- HERO -->
  <section class="bg-gray-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: url('/images/surf-school-tamarindo-students.webp'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/70 to-gray-900/95"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-5">
          <a href="/blog" class="text-[#4DD0E1] text-sm font-semibold hover:underline">← Blog</a>
          <span class="text-white/30">·</span>
          <span class="bg-green-500/20 text-green-300 text-xs font-bold px-3 py-1 rounded-full border border-green-500/30">Packing Guide</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
          Surf Trip Packing List: What to Bring to Costa Rica
        </h1>
        <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
          Everything you actually need for a surf trip to Tamarindo — and the things you can leave at home. Practical advice from people who live and surf here year-round.
        </p>
        <div class="flex items-center gap-4 mt-6 text-sm text-white/50">
          <span>May 6, 2026</span>
          <span>·</span>
          <span>8 min read</span>
          <span>·</span>
          <span>By Pura Vida Surf School</span>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <article class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xl text-gray-700 leading-relaxed mb-6">
          Packing for a surf trip is different from packing for a regular beach vacation. You need less than you think — but the right things matter. Get the sunscreen wrong and you'll be peeling by day two. Forget the reef-safe label and you'll damage the ecosystem you came to enjoy.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          This is the list we share with our students at <a href="/best-surf-school-in-tamarindo" class="text-[#00BCD4] hover:underline">Pura Vida Surf School</a> before they arrive in Tamarindo. It covers everything from surf gear (most of which we provide) to documents, tech, and the daily essentials.
        </p>
        <div class="bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-2xl p-5 mb-4">
          <p class="text-sm text-gray-700"><strong>Good news:</strong> If you're booking surf lessons with us, you do NOT need to bring a surfboard, leash, or rash guard. All equipment is included. Pack light.</p>
        </div>
      </div>
    </div>
  </article>

  <!-- PACKING CATEGORIES -->
  <section class="pb-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto space-y-10">
        {categories.map(cat => (
          <div>
            <div class="flex items-center gap-3 mb-5">
              <span class="text-3xl">{cat.emoji}</span>
              <div>
                <h2 class="text-2xl font-extrabold text-gray-900">{cat.title}</h2>
                <p class="text-sm text-gray-500 mt-0.5">{cat.note}</p>
              </div>
            </div>
            <div class="space-y-2">
              {cat.items.map(item => (
                <div class={`flex items-start gap-3 rounded-xl p-4 border ${item.provided ? 'bg-green-50 border-green-100' : 'bg-gray-50 border-gray-100'}`}>
                  <span class={`mt-0.5 font-bold text-sm ${item.provided ? 'text-green-500' : 'text-[#00BCD4]'}`}>{item.provided ? '✓' : '→'}</span>
                  <div>
                    <p class={`font-semibold text-sm ${item.provided ? 'text-green-800' : 'text-gray-900'}`}>{item.name} {item.provided && <span class="text-xs font-normal text-green-600 ml-1">(provided by school)</span>}</p>
                    <p class="text-xs text-gray-500 mt-0.5">{item.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT TO LEAVE -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6">What to Leave at Home</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {[
            { item: 'Full wetsuit', reason: 'Water is 26–29°C year-round. A rash guard is all you need.' },
            { item: 'Surfboard (if taking lessons)', reason: 'All equipment is provided. Adding a board to your flight costs $100–$300 extra.' },
            { item: 'Non-reef-safe sunscreen', reason: 'Illegal on some beaches and harmful to the reef. Buy reef-safe locally if needed.' },
            { item: 'Expensive jewelry', reason: 'Sand, salt, and surf will ruin it. Leave it locked at home.' },
            { item: 'Hair dryer / styling tools', reason: 'Tamarindo is a beach town. Embrace the salt hair look.' },
            { item: 'Heavy clothing', reason: 'Temperature is 28–35°C. One light layer for evenings is enough.' },
          ].map(l => (
            <div class="bg-white border border-gray-100 rounded-xl p-4">
              <p class="font-semibold text-gray-900 text-sm flex items-center gap-2"><span class="text-red-400">✕</span> {l.item}</p>
              <p class="text-gray-500 text-xs mt-1">{l.reason}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-3xl p-6">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Now Pack Your Bags and Book Your Lessons</h3>
          <p class="text-gray-600 mb-5 text-sm leading-relaxed">
            All surf equipment is included in every lesson. Just show up with your swimsuit and sunscreen. We handle the rest.
          </p>
          <a href="/book-now" class="inline-block px-6 py-3 bg-[#00BCD4] text-white font-bold rounded-xl hover:bg-[#00ACC1] transition-colors text-sm">
            Book a Surf Lesson in Tamarindo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map(f => (
            <div class="border border-gray-100 rounded-2xl p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-sm">{f.q}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-extrabold text-gray-900 mb-8">More from the Blog</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <a href="/blog/what-to-expect-first-surf-lesson-tamarindo" class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-beginner-lesson.webp" alt="First surf lesson Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-full">Beginners</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">What to Expect on Your First Surf Lesson</h3>
            </div>
          </a>
          <a href="/blog/best-time-to-surf-tamarindo" class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-44">
              <img src="/images/surf-school-tamarindo-surf-instructor-student.webp" alt="Best time to surf Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="176"/>
            </div>
            <div class="p-5">
              <span class="text-xs font-bold text-amber-600 bg-amber-100 px-2 py-0.5 rounded-full">Tamarindo Guide</span>
              <h3 class="font-bold text-gray-900 mt-2 group-hover:text-[#00BCD4] transition-colors text-sm leading-snug">Best Time to Surf in Tamarindo, Costa Rica</h3>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
