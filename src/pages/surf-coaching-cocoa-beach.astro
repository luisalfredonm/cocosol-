---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import Sidebar from '../components/ui/Sidebar.astro'
import VideoSection from '../components/sections/VideoSection.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BookingWizard from '../components/booking/BookingWizard'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import ProductSchema from '../components/seo/ProductSchema.astro'
import { seoData } from '../lib/seo'

import heroImg  from '../assets/images/semi-private-surf-tamarindo-wave-riding.webp'
import gallery1 from '../assets/images/semi-private-surf-instructor-tamarindo.webp'
import gallery2 from '../assets/images/couple-surf-lessons-tamarindo-instructor.webp'
import gallery3 from '../assets/images/small-group-surf-lessons-tamarindo-2-3.webp'
import gallery4 from '../assets/images/semi-private-surf-costa-rica-beginner-board.webp'
import videoBg  from '../assets/images/semi-private-surf-tamarindo-2-person.webp'

const seo = seoData.semiPrivateLessons


const faqs = [
  { question: 'What does surf coaching include?', answer: 'Surf coaching includes a certified instructor, surfboard, foam guard, safety briefing, and 90 minutes of focused instruction for 2-3 people.' },
  { question: 'Is surf coaching suitable for beginners?', answer: 'Absolutely! Small-group surf coaching is perfect for beginners who want to share the experience with a partner or a friend while still getting personalized attention.' },
  { question: 'How long is a surf coaching session?', answer: 'Each session is 90 minutes, including land training and time in the water.' },
  { question: 'Do you offer discounts for multiple coaching sessions?', answer: 'Yes! Ask us about multi-lesson options if you want more time in the water and a better rate than single sessions.' },
]

const cols = [
  { h: 'Who Can Take Surf Lessons?', items: ['Beginners', 'Kids', 'Intermediate Surfers', 'Families'] },
  { h: "What's Included",            items: ['90-minute surf lesson', 'Professional certified instructor', 'Foam guard', 'Safety briefing', 'Surfboard included', 'Photos on request'] },
  { h: 'Perfect For:',               items: ['Couples', 'Friends traveling together', 'Anyone who wants focused attention', 'People looking to learn and improve surf technique'] },
]

const gallery = [
  { img: gallery1, alt: 'Small group surf coaching Cocoa Beach board technique correction' },
  { img: gallery2, alt: 'Couple surf lessons Cocoa Beach with certified instructor in water' },
  { img: gallery3, alt: 'Small group surf lessons Cocoa Beach 2-3 students on beach' },
  { img: gallery4, alt: 'Surf coaching Cocoa Beach beginners on foam board' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Surf Lessons',href:'/tamarindo-surf-lessons'},{name:'Surf Coaching',href:'/surf-coaching-cocoa-beach'}]} />
  <ProductSchema slot="head" name="Surf Coaching Cocoa Beach" description="Small-group surf coaching for 2-3 people in Cocoa Beach, Florida. Great for couples, friends, and siblings at an affordable price." price="60" url="/surf-coaching-cocoa-beach" image="/images/semi-private-surf-tamarindo-wave-riding.webp" />
  <FAQSchema slot="head" items={faqs} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Surf Coaching Cocoa Beach - Small Group Surfing Experience"
    image={heroImg}
    imageAlt="Surf coaching Cocoa Beach couple riding wave together"
    objectPosition="center center"
    breadcrumb={{ label: 'Surf Lessons', href: '/tamarindo-surf-lessons' }}
    cta={{ label: 'Check Availability', href: '#book' }}
    height="large"
  />

  <!-- ── MAIN CONTENT ───────────────────────────────────────────────────────── -->
  <section class="py-20 container mx-auto px-4">
    <div class="grid lg:grid-cols-3 gap-12">

      <!-- Left col -->
      <div class="lg:col-span-2">

        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase">Up to 3 Students</span>
        <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Surf Coaching Cocoa Beach - Learn Together</h2>
        <p class="text-gray-700 leading-relaxed mb-4">Our <strong>surf coaching in Cocoa Beach</strong> is the perfect option for couples, friends, or small groups of 2-3 people who want to share the experience while still receiving personalized attention from a certified instructor. You get the social energy of learning with someone you know, plus the focused coaching that helps you progress faster.</p>
        <p class="text-gray-700 leading-relaxed mb-4">These small-group sessions are a great value — you share the cost with your group while still benefiting from a professional, certified surf instructor who adapts the session to your levels and goals.</p>
        <p class="text-gray-700 leading-relaxed mb-8">Whether you are a couple looking for a shared adventure, friends visiting Cocoa Beach for a week, or a family with kids, this format gives you real coaching without the higher cost of one-on-one instruction. Most students in our small-group sessions stand up on the board within the first 30 minutes on the water.</p>

        <!-- Comparison note -->
        <div class="bg-[#00BCD4]/5 border border-[#00BCD4]/20 rounded-2xl px-6 py-4 mb-8">
          <p class="text-gray-700 text-sm leading-relaxed"><strong>Surf coaching vs. group lessons:</strong> Group lessons fit up to 4 students and are the most affordable entry point. Surf coaching keeps it to 2-3 people maximum, so your instructor spends far more time with each surfer, giving corrections after every wave. If you are traveling with a partner or a small group of friends and want faster results without paying for a private session, surf coaching is the smartest choice.</p>
        </div>

        <!-- What to Expect -->
        <div class="bg-gray-50 border border-gray-100 rounded-3xl p-6 mb-8">
          <h3 class="text-lg font-bold text-gray-900 mb-3">What to Expect on the Day of Your Lesson</h3>
          <p class="text-gray-700 leading-relaxed text-sm">Your instructor will meet you on Cocoa Beach for a 15-minute land warm-up covering ocean safety, paddling technique, and how to pop up correctly on the board. After the briefing, you move into the water for the rest of your 90-minute session. Expect real, hands-on coaching with corrections after every wave - not just a quick demonstration and then watching from the shore. All skill levels are welcome, and the instructor will adjust the coaching pace for each person in your group so nobody feels left behind. You do not need any prior experience. Just bring reef-safe sunscreen, a positive attitude, and a willingness to get in the water.</p>
        </div>

        <!-- 3-col cards -->
        <div class="grid md:grid-cols-3 gap-4 mb-8">
          {cols.map(col => (
            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-4 text-sm uppercase tracking-wide">{col.h}</h3>
              <ul class="space-y-2">
                {col.items.map(i => (
                  <li class="flex items-center gap-2.5 text-sm text-gray-600">
                    <span class="w-4 h-4 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0">
                      <svg class="w-2.5 h-2.5 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    {i}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Gallery -->
        <div class="grid grid-cols-2 gap-3 mb-10">
          {gallery.map(({ img, alt }, i) => (
            <div class={`overflow-hidden rounded-2xl shadow-sm h-56 ${i % 2 === 1 ? 'mt-4' : ''}`}>
              <Image
                src={img}
                alt={alt}
                class="w-full h-full block object-cover object-center hover:scale-105 transition-transform duration-500"
                widths={[200, 400]}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          ))}
        </div>

        <!-- FAQ -->
        <div class="border-t border-gray-100 pt-10">
          <FAQ items={faqs} title="Frequently Asked Questions" columns={1}/>
        </div>

      </div>

      <!-- Right col: Sidebar -->
      <div>
        <Sidebar
          price="$60"
          priceLabel="/ Per Person"
          includes={['90-minute surf lesson', 'Professional certified instructor', 'Surfboard included', 'Foam guard', 'Safety briefing', 'Photos on request']}
          ctaLabel="Check Availability"
          ctaHref="#book"
        />
      </div>

    </div>
  </section>

  <!-- ── VIDEO SECTION ──────────────────────────────────────────────────────── -->
  <VideoSection
    title="See What a Small-Group Surf Coaching Session Looks Like in Cocoa Beach"
    subtitle="Watch what surf coaching looks like - personalized instruction for 2-3 people on Cocoa Beach."
    bgImage={videoBg}
    bgImageAlt="2-person surf coaching Cocoa Beach with personalized instructor attention"
    cta={{ label: 'Check Availability', href: '#book' }}
  />

  <!-- ── BOOKING WIZARD ─────────────────────────────────────────────────────── -->
  <section id="book" class="py-16 bg-white min-h-[800px]" style="scroll-margin-top: 96px;">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Ready to Ride?</span>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Book Your Surf Coaching Session</h2>
        <p class="text-gray-500 max-w-md mx-auto">Select your date and time below. Your surf coaching session is pre-selected - just pick when you want to surf.</p>
      </div>
      <div class="max-w-4xl mx-auto">
        <BookingWizard preselectedType="semi-private" client:idle />
      </div>
      <p class="text-center mt-4 text-sm text-gray-400">Secure payments · Trusted instructors · Flexible rescheduling</p>
    </div>
  </section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <Testimonials items={[
    { name: 'Carlos & Maria',      role: 'Couple travelers', text: 'We booked surf coaching as a couple and it was perfect. The instructor gave us individual feedback while we had fun together. Definitely recommend!' },
    { name: 'The Johnson Family',  role: 'Family',           text: 'Booked surf coaching for our family of 3 and it was the highlight of our Florida trip. Patient instructor, great waves, unforgettable experience.' },
  ]}/>

  <!-- ── NEED HELP ──────────────────────────────────────────────────────────── -->
  <NeedHelp/>

  <!-- ── SEO INTERNAL LINKS ─────────────────────────────────────────────────── -->
  <section class="py-10 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <h2 class="text-sm font-bold text-gray-500 mb-4 uppercase tracking-widest">Also Available at Pura Vida Surf School</h2>
      <div class="flex flex-wrap gap-2">
        {[
          { l: 'Private Surf Lessons Cocoa Beach', h: '/private-surf-lessons-cocoa-beach' },
          { l: 'Group Surf Lessons Cocoa Beach', h: '/group-surf-lessons-cocoa-beach' },
          { l: 'Surf Camp Cocoa Beach',           h: '/surf-camp-cocoa-beach' },
          { l: 'Surf Packages',                   h: '/tamarindo-surf-packages' },
        ].map(x => (
          <a href={x.h} data-astro-prefetch="viewport"
            class="px-4 py-2 bg-white hover:bg-[#00BCD4]/8 border border-gray-200 hover:border-[#00BCD4]/40 hover:text-[#00BCD4] rounded-full text-sm text-gray-600 transition-colors font-medium">
            {x.l}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
