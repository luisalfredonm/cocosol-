---
import BaseLayout from '../layouts/BaseLayout.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import { seoData } from '../lib/seo'

const seo = seoData.tideChart

// Monthly tide pattern data for Tamarindo (typical averages — semidiurnal mixed tides)
const months = [
  { name: 'January',   highAvg: '9.2 ft',  lowAvg: '0.4 ft', range: 'Large', surfRating: 5, note: 'Best dry season tides. Offshore winds every morning. Clean 2–4 ft waves on mid-incoming tide.' },
  { name: 'February',  highAvg: '9.5 ft',  lowAvg: '0.2 ft', range: 'Large', surfRating: 5, note: 'Peak season. Consistent NW swells, very clean conditions. Book lessons in advance.' },
  { name: 'March',     highAvg: '9.8 ft',  lowAvg: '0.1 ft', range: 'Large', surfRating: 5, note: 'Largest tidal range of the year. Mornings are glass. Excellent for beginners and intermediates.' },
  { name: 'April',     highAvg: '9.6 ft',  lowAvg: '0.3 ft', range: 'Large', surfRating: 4, note: 'Dry season tail end. Slight increase in SW swell. Afternoons can get choppy.' },
  { name: 'May',       highAvg: '8.9 ft',  lowAvg: '0.7 ft', range: 'Medium', surfRating: 4, note: 'Transition season. SW swells building. Fewer crowds, great value. Mid-tide best for beginners.' },
  { name: 'June',      highAvg: '8.4 ft',  lowAvg: '1.1 ft', range: 'Medium', surfRating: 3, note: 'Rainy season starts. Larger, more powerful waves arriving. Better for intermediate surfers.' },
  { name: 'July',      highAvg: '8.0 ft',  lowAvg: '1.4 ft', range: 'Medium', surfRating: 3, note: 'Papagayo winds can create morning glassy conditions. Solid 3–5 ft swells.' },
  { name: 'August',    highAvg: '7.9 ft',  lowAvg: '1.6 ft', range: 'Medium', surfRating: 3, note: 'Strong SW swells. Mornings still excellent. Afternoons affected by onshore winds.' },
  { name: 'September', highAvg: '8.1 ft',  lowAvg: '1.3 ft', range: 'Medium', surfRating: 2, note: 'Least consistent month. Lowest prices. For experienced surfers who can read conditions.' },
  { name: 'October',   highAvg: '8.3 ft',  lowAvg: '1.0 ft', range: 'Medium', surfRating: 2, note: 'Inconsistent swells. Heavy rain periods. Great for budget travelers willing to wait for surf.' },
  { name: 'November',  highAvg: '8.7 ft',  lowAvg: '0.6 ft', range: 'Medium', surfRating: 3, note: 'Conditions improving. Early NW swells arriving. Transition back toward dry season.' },
  { name: 'December',  highAvg: '9.0 ft',  lowAvg: '0.4 ft', range: 'Large', surfRating: 5, note: 'Dry season returns. Clean morning conditions. Busy holiday period — book lessons early.' },
]

// How tides affect each surf spot
const spots = [
  {
    name: 'Tamarindo Beach (Main Break)',
    type: 'Beach Break',
    best: 'Mid to High Incoming',
    avoid: 'Very Low Tide',
    note: 'The main Tamarindo beach break works best on an incoming mid-tide. At low tide, shallow sections expose sand bars and make the waves close out quickly. High tide softens the break and suits beginners perfectly.',
    level: 'All levels',
  },
  {
    name: 'Pico Pequeño',
    type: 'Beach Break',
    best: 'Mid Tide',
    avoid: 'High Tide (closes out)',
    note: 'Located at the south end of Tamarindo beach. Mid-tide creates the best barrel sections. Often less crowded than the main peak.',
    level: 'Intermediate',
  },
  {
    name: 'Playa Grande',
    type: 'Beach Break',
    best: 'Mid to Low Tide',
    avoid: 'Very High Tide',
    note: 'Just north of Tamarindo (10 min by boat or 30 min drive). A longer, more powerful beach break that handles lower tides better. Consistent waves with fewer crowds.',
    level: 'Intermediate to Advanced',
  },
  {
    name: 'Playa Avellanas',
    type: 'Beach Break / Reef',
    best: 'Low to Mid Tide',
    avoid: 'High Tide',
    note: '30 minutes south of Tamarindo. Famous "Little Hawaii" section works best at lower tides when the reef is exposed enough to shape the wave. Not suitable for beginners.',
    level: 'Advanced',
  },
]

const faqs = [
  { q: 'What type of tides does Tamarindo have?', a: 'Tamarindo has mixed semidiurnal tides — typically two high tides and two low tides per day, with unequal heights between the two cycles. The tidal range averages 7–10 feet (2–3 meters) depending on the lunar cycle, with the largest ranges in March.' },
  { q: 'What tide is best for surfing in Tamarindo?', a: 'For beginners, an incoming mid-tide is ideal at Tamarindo\'s main beach break. This gives waves enough shape to ride while keeping the water deep enough to avoid the sand. The best window is typically 2 hours before high tide. For intermediate surfers, low to mid-tide on an outgoing cycle can produce hollower, more powerful waves.' },
  { q: 'How often do tides change in Tamarindo?', a: 'There are approximately 4 tide changes per day — two high tides and two low tides roughly every 12.5 hours. Each tide takes about 6 hours to go from high to low (or low to high). The best surf window is typically a 2-hour block around the mid-tide point.' },
  { q: 'Does tide affect surf lessons in Tamarindo?', a: 'Yes. Our instructors at Pura Vida Surf School plan every lesson around the optimal tide window. We never put students in the water at an unfavorable tide — if the main break is not ideal, we move to an alternative spot that works better for the conditions that day.' },
  { q: 'What is the best time of day to surf in Tamarindo?', a: 'The best time to surf in Tamarindo is early morning — from sunrise until about 10:00 AM. This is when offshore winds groom the wave faces and the tide is typically in a favorable range. Afternoon sessions are possible but often affected by onshore winds that make conditions choppy.' },
  { q: 'Where can I find the exact Tamarindo tide times for today?', a: 'For precise daily tide times, we recommend checking Windguru, Surf-Forecast.com, or Surfline — all of which show real-time tide predictions for Tamarindo. Our instructors also monitor conditions daily and always schedule lessons at the optimal tide window.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Tamarindo Tide Chart',href:seo.slug}]} />
  <FAQSchema slot="head" items={faqs.map(f => ({ question: f.q, answer: f.a }))} />

  <!-- HERO -->
  <section class="bg-gray-900 py-20 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20" style="background-image: url('/images/surf-school-tamarindo-surf-instructor-student.webp'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900/70 to-gray-900/95"></div>
    <div class="relative z-10 container mx-auto px-4">
      <div class="max-w-3xl">
        <span class="inline-block bg-[#00BCD4]/20 text-[#4DD0E1] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase border border-[#00BCD4]/30">
          Surf Guide
        </span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5 leading-tight">
          Tamarindo Tide Chart 2026
        </h1>
        <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
          Monthly tide patterns, best surf tides by spot, and everything you need to plan the perfect session in Tamarindo, Costa Rica.
        </p>
        <div class="flex flex-wrap gap-4 mt-8">
          <a href="#live-tides" class="px-5 py-2.5 bg-[#00BCD4] text-white font-bold rounded-xl text-sm hover:bg-[#00ACC1] transition-colors">
            See Live Tides ↓
          </a>
          <a href="/book-now" class="px-5 py-2.5 bg-white/10 text-white font-semibold rounded-xl text-sm border border-white/20 hover:bg-white/20 transition-colors">
            Book a Surf Lesson
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK GUIDE -->
  <section class="py-14 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Understanding Tamarindo Tides</h2>
        <p class="text-gray-600 leading-relaxed mb-8 max-w-2xl">
          Tamarindo has <strong>mixed semidiurnal tides</strong> — two high and two low tides per day with unequal heights. The tidal range averages 7–10 feet depending on the lunar cycle, with the largest swings occurring in March. Here's what that means for surfing.
        </p>
        <div class="grid md:grid-cols-3 gap-5 mb-10">
          <div class="bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-2xl p-5 text-center">
            <p class="text-3xl font-extrabold text-[#00BCD4] mb-1">2×</p>
            <p class="font-bold text-gray-900 text-sm mb-1">High & Low Tides/Day</p>
            <p class="text-gray-500 text-xs leading-relaxed">Roughly every 12.5 hours — plan your session around the best window</p>
          </div>
          <div class="bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-2xl p-5 text-center">
            <p class="text-3xl font-extrabold text-[#00BCD4] mb-1">7–10 ft</p>
            <p class="font-bold text-gray-900 text-sm mb-1">Average Tidal Range</p>
            <p class="text-gray-500 text-xs leading-relaxed">Largest in March (spring tides), smallest in June–August</p>
          </div>
          <div class="bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-2xl p-5 text-center">
            <p class="text-3xl font-extrabold text-[#00BCD4] mb-1">6 hrs</p>
            <p class="font-bold text-gray-900 text-sm mb-1">Low to High Cycle</p>
            <p class="text-gray-500 text-xs leading-relaxed">Best surf window: 2 hours around mid-incoming tide</p>
          </div>
        </div>

        <!-- Best vs Worst -->
        <div class="grid md:grid-cols-2 gap-5">
          <div class="bg-green-50 border border-green-100 rounded-2xl p-6">
            <h3 class="font-extrabold text-green-800 mb-4 flex items-center gap-2">
              <span class="text-green-500">✓</span> Best Tide for Beginners
            </h3>
            <ul class="space-y-2 text-sm text-green-800">
              <li class="flex items-start gap-2"><span class="text-green-500 mt-0.5">→</span> Mid-incoming tide (2 hrs before high)</li>
              <li class="flex items-start gap-2"><span class="text-green-500 mt-0.5">→</span> High tide (soft, slow waves — very forgiving)</li>
              <li class="flex items-start gap-2"><span class="text-green-500 mt-0.5">→</span> Neap tides (smaller range — gentler conditions)</li>
            </ul>
          </div>
          <div class="bg-red-50 border border-red-100 rounded-2xl p-6">
            <h3 class="font-extrabold text-red-800 mb-4 flex items-center gap-2">
              <span class="text-red-400">✕</span> Avoid for Beginners
            </h3>
            <ul class="space-y-2 text-sm text-red-800">
              <li class="flex items-start gap-2"><span class="text-red-400 mt-0.5">→</span> Very low tide (exposed sand bars, close-out waves)</li>
              <li class="flex items-start gap-2"><span class="text-red-400 mt-0.5">→</span> Spring tide lows (extreme low — very shallow)</li>
              <li class="flex items-start gap-2"><span class="text-red-400 mt-0.5">→</span> Outgoing tide (can pull you toward the river mouth)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LIVE TIDE WIDGET -->
  <section id="live-tides" class="py-14 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between flex-wrap gap-4 mb-6">
          <div>
            <h2 class="text-3xl font-extrabold text-gray-900">Live Tide Times — Tamarindo</h2>
            <p class="text-gray-500 text-sm mt-1">Real-time tide predictions updated daily</p>
          </div>
          <span class="inline-flex items-center gap-2 text-xs font-bold text-green-600 bg-green-100 px-3 py-1.5 rounded-full border border-green-200">
            <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
            Live Data
          </span>
        </div>
        <div class="bg-white rounded-3xl border border-gray-100 overflow-hidden shadow-sm">
          <iframe
            src="https://www.surf-forecast.com/breaks/Tamarindo/tides/latest"
            title="Tamarindo Tide Chart — Live Tide Times"
            width="100%"
            height="500"
            loading="lazy"
            class="w-full border-0"
            style="min-height:480px;"
          ></iframe>
          <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs text-gray-400">Tide predictions via surf-forecast.com. Times in local Costa Rica time (CST, UTC-6).</p>
            <a href="https://www.surf-forecast.com/breaks/Tamarindo/tides/latest" target="_blank" rel="noopener" class="text-xs text-[#00BCD4] font-semibold hover:underline">
              Open full tide chart →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MONTHLY PATTERNS -->
  <section class="py-14 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-3">Monthly Tide Patterns — Tamarindo 2026</h2>
        <p class="text-gray-500 text-sm mb-8">Average high/low tide heights and typical surf conditions by month. For precise daily times, use the live chart above.</p>
        <div class="overflow-x-auto rounded-2xl border border-gray-100">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-900 text-white">
                <th class="text-left px-5 py-3 font-semibold">Month</th>
                <th class="text-left px-5 py-3 font-semibold">High Tide Avg</th>
                <th class="text-left px-5 py-3 font-semibold">Low Tide Avg</th>
                <th class="text-left px-5 py-3 font-semibold hidden md:table-cell">Surf Rating</th>
                <th class="text-left px-5 py-3 font-semibold hidden lg:table-cell">Notes</th>
              </tr>
            </thead>
            <tbody>
              {months.map((m, i) => (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                  <td class="px-5 py-3 font-bold text-gray-900">{m.name}</td>
                  <td class="px-5 py-3 text-gray-700">{m.highAvg}</td>
                  <td class="px-5 py-3 text-gray-700">{m.lowAvg}</td>
                  <td class="px-5 py-3 hidden md:table-cell">
                    <div class="flex gap-0.5">
                      {Array.from({length: 5}).map((_, j) => (
                        <svg class={`w-3.5 h-3.5 ${j < m.surfRating ? 'text-[#00BCD4]' : 'text-gray-200'}`} fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      ))}
                    </div>
                  </td>
                  <td class="px-5 py-3 text-gray-500 text-xs hidden lg:table-cell max-w-xs">{m.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-xs text-gray-400 mt-3">Heights are typical averages based on historical tidal patterns. Actual heights vary with lunar cycles. Spring tides (full/new moon) produce the largest range; neap tides (quarter moons) produce the smallest.</p>
      </div>
    </div>
  </section>

  <!-- TIDE BY SPOT -->
  <section class="py-14 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-3">Best Tides by Surf Spot Near Tamarindo</h2>
        <p class="text-gray-500 text-sm mb-8">Each break responds differently to tidal changes. Here's what our instructors know from surfing these spots every day.</p>
        <div class="space-y-4">
          {spots.map(spot => (
            <div class="bg-white border border-gray-100 rounded-2xl p-6">
              <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                <div>
                  <h3 class="font-extrabold text-gray-900">{spot.name}</h3>
                  <p class="text-xs text-gray-400 mt-0.5">{spot.type} · {spot.level}</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  <span class="inline-flex items-center gap-1 text-xs font-bold text-green-700 bg-green-100 px-3 py-1 rounded-full">
                    ✓ Best: {spot.best}
                  </span>
                  <span class="inline-flex items-center gap-1 text-xs font-bold text-red-600 bg-red-50 px-3 py-1 rounded-full">
                    ✕ Avoid: {spot.avoid}
                  </span>
                </div>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">{spot.note}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO READ -->
  <section class="py-14 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6">How to Read a Tide Chart for Surfing</h2>
        <div class="space-y-5">
          {[
            {
              step: '1',
              title: 'Find the high and low tide times',
              body: 'A tide chart shows the predicted height of the water at any given hour. The peaks are high tides, the valleys are low tides. In Tamarindo, you\'ll typically see two of each per day.',
            },
            {
              step: '2',
              title: 'Identify the mid-tide window',
              body: 'For beginners, the sweet spot is the 2 hours leading into high tide — the mid-incoming window. Water is rising, waves have shape, and depth is increasing. This is usually the safest and most enjoyable time to surf.',
            },
            {
              step: '3',
              title: 'Check the tidal range',
              body: 'The difference between high and low tide (the "range") tells you how powerful the tidal flow will be. A large range (8–10 ft) means stronger currents and more dramatic changes in wave character. A small range (4–6 ft, neap tides) means more mellow conditions.',
            },
            {
              step: '4',
              title: 'Combine with swell and wind',
              body: 'Tides are just one piece of the puzzle. The best sessions happen when a favorable tide, clean offshore winds, and consistent swell align. Our instructors monitor all three daily — it\'s why we schedule lessons in the early morning.',
            },
            {
              step: '5',
              title: 'Check the moon phase',
              body: 'Spring tides (largest range) happen at full and new moon. Neap tides (smallest range) happen at quarter moon. In March–April, spring tides in Tamarindo can reach 10+ feet — very powerful. In green season, neap tides produce gentler conditions ideal for learning.',
            },
          ].map(item => (
            <div class="flex gap-5">
              <div class="shrink-0 w-9 h-9 rounded-full bg-[#00BCD4] text-white font-extrabold text-sm flex items-center justify-center">
                {item.step}
              </div>
              <div class="bg-gray-50 border border-gray-100 rounded-2xl p-5 flex-1">
                <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-10 bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-3xl p-6">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Let Us Handle the Tide Planning</h3>
          <p class="text-gray-600 mb-5 text-sm leading-relaxed">
            Our instructors at <a href="/best-surf-school-in-tamarindo" class="text-[#00BCD4] hover:underline">Pura Vida Surf School</a> monitor tides, swell, and wind every single morning. Every lesson is scheduled at the optimal window — you just show up and surf. No guessing required.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/book-now" class="px-6 py-3 bg-[#00BCD4] text-white font-bold rounded-xl hover:bg-[#00ACC1] transition-colors text-sm">
              Book a Surf Lesson
            </a>
            <a href="/tamarindo-surf-lessons" class="px-6 py-3 bg-white border border-gray-200 text-gray-700 font-semibold rounded-xl hover:border-[#00BCD4] hover:text-[#00BCD4] transition-colors text-sm">
              View All Lessons
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8">Tamarindo Tides — FAQ</h2>
        <div class="space-y-4">
          {faqs.map(f => (
            <div class="bg-white border border-gray-100 rounded-2xl p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-sm">{f.q}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="py-14 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-extrabold text-gray-900 mb-8">Related Guides</h2>
        <div class="grid md:grid-cols-3 gap-5">
          <a href="/blog/best-time-to-surf-tamarindo" class="group flex flex-col bg-gray-50 rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-36">
              <img src="/images/surf-school-tamarindo-surf-instructor-student.webp" alt="Best time to surf Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="144"/>
            </div>
            <div class="p-4">
              <p class="font-bold text-gray-900 text-sm group-hover:text-[#00BCD4] transition-colors leading-snug">Best Time to Surf Tamarindo</p>
            </div>
          </a>
          <a href="/blog/is-tamarindo-good-for-beginner-surfers" class="group flex flex-col bg-gray-50 rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-36">
              <img src="/images/surf-school-tamarindo-beginner-lesson.webp" alt="Beginner surfing Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="144"/>
            </div>
            <div class="p-4">
              <p class="font-bold text-gray-900 text-sm group-hover:text-[#00BCD4] transition-colors leading-snug">Is Tamarindo Good for Beginners?</p>
            </div>
          </a>
          <a href="/tamarindo-surf-lessons" class="group flex flex-col bg-gray-50 rounded-2xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/40 hover:shadow-lg transition-all">
            <div class="overflow-hidden h-36">
              <img src="/images/surf-school-tamarindo-private-class.webp" alt="Surf lessons Tamarindo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="400" height="144"/>
            </div>
            <div class="p-4">
              <p class="font-bold text-gray-900 text-sm group-hover:text-[#00BCD4] transition-colors leading-snug">Surf Lessons in Tamarindo</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
