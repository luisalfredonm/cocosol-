---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import HeroPreload from '../components/ui/HeroPreload.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import ProductSchema from '../components/seo/ProductSchema.astro'
import { seoData } from '../lib/seo'

import heroImg from '../assets/images/group-surf-lessons-tamarindo-students-beach.webp'

const seo = seoData.familySurfLessons

const whyFamilies = [
  {
    icon: '👶',
    title: 'Kids from 6 Years Old',
    body: "Our instructors are patient and experienced with children. We've taught hundreds of kids their first wave in a safe, fun environment.",
  },
  {
    icon: '🏄',
    title: 'All Levels, All Ages',
    body: 'Whether it\'s dad who surfs or grandma who has never seen a surfboard, we adapt every lesson to each person\'s ability and comfort level.',
  },
  {
    icon: '🛡️',
    title: 'Safety First',
    body: "Tamarindo's beach break is one of the gentlest in Costa Rica. Small, forgiving waves and certified instructors ensure everyone has a safe experience.",
  },
  {
    icon: '📸',
    title: 'Memories That Last Forever',
    body: 'Your instructor will capture photos and videos of the whole family surfing. These become some of the best travel memories from any Costa Rica trip.',
  },
  {
    icon: '🎽',
    title: 'All Equipment Included',
    body: 'Surfboards sized for every age, leashes, rash guards, and reef-safe sunscreen — everything is included. Just show up.',
  },
  {
    icon: '⏰',
    title: 'Flexible Scheduling',
    body: 'We offer morning and afternoon sessions. Book the whole family together or split into groups by skill level — whatever works best for you.',
  },
]

const options = [
  {
    name: 'Family Group Lesson',
    price: '$50',
    priceNote: 'per person',
    description: 'Perfect for families of 4+ who want to learn together. Fun, social, and budget-friendly.',
    included: ['1.5–2 hour session', 'Certified group instructor', 'Surfboard & leash', 'Rash guard included', 'Beginner-friendly white water'],
    cta: '/book-now?type=group',
    ctaLabel: 'Book Group Lesson',
    highlight: false,
  },
  {
    name: 'Family Semi-Private Lesson',
    price: '$50',
    priceNote: 'per person (2–3 people)',
    description: 'Ideal for couples with 1–2 kids. More personal attention than a group lesson.',
    included: ['1.5–2 hour session', '1 instructor for 2–3 people', 'Surfboard & leash', 'Rash guard included', 'Great for mixed skill levels'],
    cta: '/book-now?type=semi-private',
    ctaLabel: 'Book Semi-Private',
    highlight: true,
  },
  {
    name: 'Private Family Lessons',
    price: '$90',
    priceNote: 'per person',
    description: 'One dedicated instructor per person or per pair. Maximum progress, maximum fun.',
    included: ['2-hour session', '1 instructor per person or pair', 'Surfboard & leash', 'Rash guard included', 'Best for fast learners & performance'],
    cta: '/book-now?type=private',
    ctaLabel: 'Book Private Lesson',
    highlight: false,
  },
]

const faqItems = [
  { question: 'How old do children need to be to surf?', answer: 'We accept children from 6 years old. Younger children can be accommodated on a case-by-case basis — contact us and we\'ll advise based on your child\'s confidence in water.' },
  { question: 'Do my kids need to know how to swim?', answer: 'Yes, basic swimming ability is required for safety. Children should be comfortable in the water. The waves we use for beginners are small and gentle, but swimming ability is a must.' },
  { question: 'Can parents and kids take the lesson together?', answer: 'Absolutely! A semi-private lesson for a parent and one or two children is one of our most popular options. You\'ll share an instructor who adapts the pace for everyone.' },
  { question: 'What if my child is nervous or scared?', answer: "Our instructors are experienced with nervous first-timers of all ages. They always start in the white water close to shore, explain everything step by step, and go at your child's pace. Most kids are smiling within 10 minutes." },
  { question: 'Is Tamarindo safe for family surfing?', answer: 'Tamarindo has one of the safest beach breaks in Costa Rica for beginners and families. The waves break over sand (no reef), and the shore break is gentle. Our instructors know the beach inside out.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <HeroPreload slot="head" src={heroImg} />
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Surf Lessons',href:'/tamarindo-surf-lessons'},{name:'Family Surf Lessons',href:'/family-surf-lessons-tamarindo'}]} />
  <ProductSchema slot="head" name="Family Surf Lessons Tamarindo" description="Fun and safe family surf lessons in Tamarindo, Costa Rica. Certified instructors for kids and adults of all levels at Pura Vida Surf School." price="50" url="/family-surf-lessons-tamarindo" image="/images/family-surf-lessons-tamarindo.webp" />
  <FAQSchema slot="head" items={faqItems} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Family Surf Lessons in Tamarindo, Costa Rica"
    subtitle="Fun, safe, and unforgettable. Our certified instructors teach kids and adults of all ages to catch their first wave together."
    image={heroImg}
    imageAlt="Family surf lessons Tamarindo Costa Rica"
    breadcrumb={{ label: 'Family Surf Lessons' }}
    cta={{ label: 'Book a Family Lesson', href: '/book-now?type=group' }}
    ctaSecondary={{ label: 'View All Lessons', href: '/tamarindo-surf-lessons' }}
    height="large"
  />

  <!-- ── INTRO ─────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <span class="section-label mb-3 block">Surf Together</span>
        <h2 class="text-4xl font-extrabold text-gray-900 mb-5 leading-tight">
          The Best Family Activity in Tamarindo
        </h2>
        <p class="text-gray-600 leading-relaxed mb-4 text-lg">
          Forget the resort pool. The most memorable thing your family can do in Tamarindo is learn to surf together. At Pura Vida Surf School, we've helped thousands of families — from 6-year-old first-timers to grandparents — catch their first wave in Costa Rica's warm, crystal-clear water.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Our beach is gentle, our instructors are patient, and the smiles at the end of every lesson tell us everything we need to know.
        </p>
      </div>
    </div>
  </section>

  <!-- ── WHY FAMILIES LOVE US ──────────────────────────────────────────────── -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="section-label mb-2 block">Why Families Choose Us</span>
        <h2 class="text-3xl font-extrabold text-gray-900">Everything You Need for a Perfect Family Surf Day</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {whyFamilies.map(w => (
          <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:shadow-md transition-shadow">
            <div class="text-3xl mb-4">{w.icon}</div>
            <h3 class="font-bold text-gray-900 mb-2">{w.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PHOTO ─────────────────────────────────────────────────────────────── -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto overflow-hidden rounded-3xl shadow-xl">
        <img
          src="/images/family-surf-lessons-tamarindo.webp"
          alt="Family taking surf lessons together on Tamarindo beach"
          class="w-full h-72 md:h-96 object-cover"
          width="900"
          height="384"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── OPTIONS ──────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="section-label mb-2 block">Lesson Options</span>
        <h2 class="text-3xl font-extrabold text-gray-900">Choose the Right Lesson for Your Family</h2>
        <p class="text-gray-500 mt-3 max-w-xl mx-auto">Whether you're a group of 2 or 8, we have a format that fits your family size and budget.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {options.map(opt => (
          <div class={`flex flex-col rounded-3xl border-2 overflow-hidden transition-shadow hover:shadow-xl ${opt.highlight ? 'border-[#00BCD4] shadow-lg shadow-[#00BCD4]/10' : 'border-gray-100 bg-white'}`}>
            {opt.highlight && (
              <div class="bg-[#00BCD4] text-white text-xs font-bold text-center py-2 tracking-wider uppercase">Most Popular</div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <h3 class="font-extrabold text-gray-900 text-lg mb-1">{opt.name}</h3>
              <p class="text-gray-500 text-sm mb-4 leading-relaxed">{opt.description}</p>
              <div class="mb-5">
                <span class="text-3xl font-extrabold text-[#00BCD4]">{opt.price}</span>
                <span class="text-gray-400 text-sm ml-1">{opt.priceNote}</span>
              </div>
              <ul class="space-y-2 mb-6 flex-1">
                {opt.included.map(item => (
                  <li class="flex items-center gap-2 text-sm text-gray-600">
                    <svg class="w-4 h-4 text-[#00BCD4] shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
              <a href={opt.cta} class={`block text-center font-bold px-5 py-3 rounded-xl transition-colors text-sm ${opt.highlight ? 'bg-[#00BCD4] text-white hover:bg-[#00ACC1]' : 'border-2 border-[#00BCD4] text-[#00BCD4] hover:bg-[#00BCD4]/8'}`}>
                {opt.ctaLabel}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS ──────────────────────────────────────────────────────── -->
  <Testimonials bg="white" items={[
    { name: 'Ana P.',       role: 'Traveler',       country: 'Brazil',  text: 'Brought my whole family here — from my 8-year-old to my mom. Everyone learned, everyone had fun. That says it all about how good these guys are.' },
    { name: 'Jessica L.',   role: 'Solo Traveler',  country: 'USA',     text: 'I was nervous about surfing for the first time but they made it so easy. Patient, professional, and so much fun. Best experience in Costa Rica!' },
    { name: 'Marcus R.',    role: 'Family Traveler', country: 'Canada', text: 'Booked a family session for 4 of us — my wife, our two kids (7 and 10), and myself. Our instructor was amazing with the kids. All four of us stood up on the first day. Absolutely worth it.' },
    { name: 'Sofia H.',     role: 'Traveler',       country: 'Sweden',  text: 'Our kids are still talking about catching waves in Tamarindo. Best day of our entire trip to Costa Rica. The instructor was patient and encouraging with everyone.' },
  ]} title="What Families Say About Us" />

  <!-- ── FAQ ──────────────────────────────────────────────────────────────── -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8">Family Surf Lessons FAQ</h2>
        <FAQ items={faqItems} />
      </div>
    </div>
  </section>

  <!-- ── INTERNAL LINKS ────────────────────────────────────────────────────── -->
  <section class="py-12 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <p class="text-center text-sm font-semibold text-gray-400 mb-8 uppercase tracking-widest">Explore More</p>
        <div class="grid md:grid-cols-3 gap-4">
          {[
            { label: 'Group Surf Lessons', href: '/group-surf-lessons-tamarindo', desc: 'Best for larger families (4+ people)' },
            { label: 'Semi-Private Lessons', href: '/semi-private-surf-lessons-tamarindo', desc: 'Perfect for couples and parent + child' },
            { label: 'Surf Packages', href: '/tamarindo-surf-packages', desc: 'Multi-day lessons for dedicated learners' },
          ].map(link => (
            <a href={link.href} class="block bg-white border border-gray-100 rounded-2xl p-5 hover:border-[#00BCD4]/40 hover:shadow-md transition-all">
              <p class="font-bold text-gray-900 text-sm mb-1">{link.label}</p>
              <p class="text-gray-500 text-xs">{link.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <NeedHelp />
</BaseLayout>
