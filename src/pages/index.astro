---
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import WhyChooseUs from '../components/sections/WhyChooseUs.astro'
import VideoSection from '../components/sections/VideoSection.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import { seoData } from '../lib/seo'

import heroImg from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'
import gallery1 from '../assets/images/family-surf-lessons-tamarindo.webp'
import gallery2 from '../assets/images/surf-school-tamarindo-students.webp'
import gallery3 from '../assets/images/surf-school-tamarindo-private-class.webp'
import gallery4 from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import privateCard from '../assets/images/surf-school-tamarindo-private-class.webp'
import semiPrivateCard from '../assets/images/surf-school-tamarindo-students.webp'
import groupCard from '../assets/images/family-surf-lessons-tamarindo.webp'
import camp7 from '../assets/images/student-from-our-surf-school-in-Tamarindo.webp'
import camp5 from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import videoBg from '../assets/images/student-from-our-surf-school-in-Tamarindo.webp'

const seo = seoData.home

const preloadHero = await getImage({ src: heroImg, format: 'webp', width: 1920 })

const gallery = [
  { img: gallery1, alt: 'Surf school Tamarindo — family surf lesson on the beach' },
  { img: gallery2, alt: 'Group surf lessons Tamarindo Costa Rica' },
  { img: gallery3, alt: 'Surf school Tamarindo — instructor guiding student on a wave' },
  { img: gallery4, alt: 'Surf school Tamarindo — students catching their first waves' },
]

const services = [
  { href: '/private-surf-lessons-tamarindo', title: 'Private Surf Lessons', img: privateCard },
  { href: '/semi-private-surf-lessons-tamarindo', title: 'Semi-Private Surf Lessons', img: semiPrivateCard },
  { href: '/group-surf-lessons-tamarindo', title: 'Group Surf Lessons', img: groupCard },
]

const camps = [
  { href: '/7-days-surf-camp-tamarindo', title: '7-Day Surf Camp', detail: '6 surf lessons + surf trip from $1,399', img: camp7 },
  { href: '/5-days-surf-camp-tamarindo', title: '5-Day Surf Camp', detail: '4 surf lessons + surf trip from $1,049', img: camp5 },
]
---
<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <link slot="head" rel="preload" as="image" href={preloadHero.src} type="image/webp" fetchpriority="high"/>
  <Hero
    title="Surf School in Tamarindo, Costa Rica — Pura Vida Surf School"
    subtitle="Learn to surf with certified instructors in one of Costa Rica's best surf towns."
    image={heroImg}
    imageAlt="Student riding a wave during surf school Tamarindo class"
    cta={{ label: 'Book Now', href: '/book-now' }}
    ctaSecondary={{ label: 'View Surf Lessons', href: '/tamarindo-surf-lessons' }}
    height="full"
  />

  <!-- Intro 2-col -->
  <section class="py-20 container mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="grid grid-cols-2 gap-3">
        {gallery.map(({ img, alt }, i) => (
          <Image
            src={img}
            alt={alt}
            class={`rounded-xl w-full h-48 object-cover ${i%2===1 ? 'mt-6' : ''}`}
            widths={[200, 400, 800]}
            formats={['avif', 'webp']}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding={i === 0 ? 'sync' : 'async'}
            sizes="(min-width: 768px) 25vw, 50vw"
          />
        ))}
      </div>
      <div>
        <span class="section-label mb-2 block">Welcome to Pura Vida Surf School</span>
        <h2 class="text-4xl font-bold text-gray-900">Surf School In Tamarindo — Learn to Surf at Costa Rica's #1 Surf Town</h2>
        <p class="mt-4 text-gray-600 leading-relaxed">Pura Vida Surf School is the surf school Tamarindo visitors trust most. Located steps from the beach in one of <a href="https://www.visitcostarica.com/en/costa-rica/where-to-go/beaches/tamarindo" target="_blank" rel="noopener noreferrer" class="text-teal-600 underline hover:text-teal-800">Costa Rica's top surf destinations</a>, we combine certified instruction, warm water, and small groups to help you improve technique, build confidence, and fall in love with the ocean — whether it's your very first wave or you're pushing to the next level.</p>
        <ul class="mt-4 space-y-2">
          {['Certified surf instructors','Small groups and personalized coaching','Surfboards and equipment included'].map(i => (
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-teal-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              {i}
            </li>
          ))}
        </ul>
        <a href="/tamarindo-surf-lessons" class="mt-6 inline-block btn-primary">View Surf Lessons Options</a>
        <div class="mt-5 inline-flex items-center gap-3 bg-teal-50 border border-teal-100 rounded-xl px-4 py-3 ml-4">
          <span class="text-3xl font-bold text-teal-600">25+</span>
          <span class="text-gray-600 text-sm">Countries represented<br/>by our students</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services banner -->
  <section class="py-16 bg-teal-600">
    <div class="container mx-auto px-4">
      <span class="section-label text-white/80 block text-center mb-2">Best Surf School in Tamarindo</span>
      <h2 class="text-3xl font-bold text-white text-center mb-10">Surf School in Tamarindo for Every Level</h2>
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {services.map(c => (
          <a href={c.href} data-astro-prefetch class="group relative rounded-2xl overflow-hidden h-64 block">
            <Image
              src={c.img}
              alt={c.title + ' Tamarindo'}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              widths={[300, 600]}
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 768px) 33vw, 100vw"
            />
            <div class="absolute inset-0 bg-black/40 flex items-end p-6">
              <h3 class="text-2xl font-bold text-white">{c.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <WhyChooseUs/>

  <VideoSection
    title="Experience Surfing in Tamarindo"
    subtitle="Watch our students go from nervous beginners to confident surfers in just one session."
    bgImage={videoBg}
    cta={{ label: 'Choose Your Surf Lesson', href: '/tamarindo-surf-lessons' }}
  />

  <!-- Surf camp -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <span class="section-label mb-2 block">Our Surf Camp in Tamarindo</span>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Tamarindo Surf Camp</h2>
      <p class="text-gray-600 max-w-2xl mb-10">If you're planning a surf getaway, check our all-inclusive surf camps. Professional instruction, equipment, surf trips, and pura vida vibes included.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {camps.map(c => (
          <a href={c.href} data-astro-prefetch class="group relative rounded-2xl overflow-hidden h-56 block">
            <Image
              src={c.img}
              alt={c.title + ' Tamarindo'}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              widths={[400, 800]}
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 768px) 50vw, 100vw"
            />
            <div class="absolute inset-0 bg-black/50 flex flex-col justify-end p-6">
              <h3 class="text-xl font-bold text-white">{c.title}</h3>
              <p class="text-white/80 text-sm mt-1">{c.detail}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 container mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Surf School FAQs — Everything You Need to Know</h2>
        <p class="text-gray-600 mb-6">These are the most common questions we get from students planning their first visit to our surf school in Tamarindo. Can't find your answer? We reply fast on WhatsApp.</p>
        <a href="/surf-school-near-me-tamarindo" class="btn-outline">Contact Us on WhatsApp</a>
      </div>
      <FAQ items={[
        { question: 'Do I need to know how to swim to surf?', answer: 'Basic swimming ability is recommended for safety. Our instructors will assess your comfort level before entering the water.' },
        { question: 'What is the best option to learn surf?', answer: 'For first-timers, we recommend either a private lesson for maximum personal attention, or a group lesson for a fun social experience at a lower price.' },
        { question: 'What can I expect on a regular day at the school?', answer: 'Your instructor will meet you at the beach, provide all equipment, run a 15-minute safety briefing, then guide you in the water for your session.' },
        { question: 'What sets your surf camp apart from others?', answer: 'We are a locally-owned school with certified instructors who know Tamarindo inside and out. We keep groups small and focus on real progress, not just fun.' },
        { question: 'Can kids take lessons?', answer: 'Absolutely! We welcome kids from age 6. Our instructors are trained to work with young surfers and ensure a safe, fun experience.' },
      ]}/>
    </div>
  </section>

  <!-- Latest News -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <span class="section-label mb-2 block">Insight</span>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Latest News & Articles</h2>
      <p class="text-gray-600 mb-6">Read our blog to keep yourself sharp. Stay informed with our latest updates.</p>
      <a href="/blog" class="btn-outline">All Articles</a>
    </div>
  </section>

  <!-- SEO internal links -->
  <section class="py-12 container mx-auto px-4">
    <h2 class="text-lg font-bold text-gray-900 mb-4">Our Surf Lessons & Packages in Tamarindo</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Private Surf Lessons', href: '/private-surf-lessons-tamarindo' },
        { label: 'Semi-Private Surf Lessons', href: '/semi-private-surf-lessons-tamarindo' },
        { label: 'Group Surf Lessons', href: '/group-surf-lessons-tamarindo' },
        { label: 'Surf Packages Tamarindo', href: '/surf-packages' },
        { label: '3 Days Surf Package', href: '/3-days-pura-vida-surf-package' },
        { label: '5 Days Surf Package', href: '/5-days-pura-vida-surf-package' },
        { label: 'Surf Camp Tamarindo', href: '/surf-camp-tamarindo' },
        { label: '7 Days Surf Camp', href: '/7-days-surf-camp-tamarindo' },
        { label: '5 Days Surf Camp', href: '/5-days-surf-camp-tamarindo' },
      ].map(l => (
        <a href={l.href} data-astro-prefetch="viewport" class="px-4 py-2 bg-gray-100 hover:bg-teal-50 hover:text-teal-700 border border-gray-200 hover:border-teal-300 rounded-full text-sm text-gray-700 transition-colors">{l.label}</a>
      ))}
    </div>
  </section>
</BaseLayout>
