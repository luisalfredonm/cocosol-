---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import WhyChooseUs from '../components/sections/WhyChooseUs.astro'
import LessonsGrid from '../components/sections/LessonsGrid.astro'
import PricingPackages from '../components/sections/PricingPackages.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import { seoData, CONTACT } from '../lib/seo'

import heroImg from '../assets/images/surf-lessons-cocoa-beach-instructor-coaching.webp'
import gallery1 from '../assets/images/surf-lessons-cocoa-beach-beginner-student.webp'
import gallery2 from '../assets/images/surf-lessons-cocoa-beach-kids-class.webp'
import gallery3 from '../assets/images/surf-school-cocoa-beach-private-class.webp'
import gallery4 from '../assets/images/surf-school-cocoa-beach-beginner-lesson.webp'
import blogLessonImg from '../assets/images/surf-school-cocoa-beach-beginner-lesson.webp'
import blogSeasonImg from '../assets/images/surf-school-cocoa-beach-surf-instructor-student.webp'

const seo = seoData.home


const gallery = [
  { img: gallery1, alt: 'Beginner student taking surf lessons in Cocoa Beach with Cocosol Surf Lessons' },
  { img: gallery2, alt: 'Kids surf lessons Cocoa Beach class learning ocean safety and surfing basics' },
  { img: gallery3, alt: 'Surf instructor guiding student on a wave at Cocoa Beach' },
  { img: gallery4, alt: 'Students catching their first waves at Cocosol Surf Lessons' },
]


// Every figure here is a claim the site already makes elsewhere (the 25 years
// in WhyChooseUs, the 3:1 ratio in the same component, the Google rating in
// Testimonials). The previous set carried a "100% ISA Certified" that is not a
// measurable quantity, and used "25+" twice with two different meanings
// (countries and years), which made both numbers read as invented.
const stats = [
  { value: '500+', label: 'Surfers taught' },
  { value: '25+',  label: 'Years in Cocoa Beach' },
  { value: '4.9★', label: 'Google rating' },
  { value: '3:1',  label: 'Max group ratio' },
]

// FAQ de la home = intención comercial (precio, logística, política).
// Las preguntas informativas de "condiciones de surf" viven en el blog y las
// específicas de cada servicio en su propia página - no duplicar aquí.
const faqs = [
  { question: 'How much do surf lessons cost in Cocoa Beach?', answer: 'Cocoa Beach surf lessons are $60 per person for a group lesson and $75 for a private lesson, both one hour with all equipment included. Multi-session packages start at $260 for four lessons, and the kids surf camp starts at $350 for the week.' },
  { question: 'Do I need to know how to swim to surf?', answer: 'Basic swimming ability is recommended for safety. Our instructors will assess your comfort level before entering the water.' },
  { question: 'What is the best option to learn surf?', answer: 'Cocoa Beach surf lessons come in two beginner formats: a private lesson, for maximum personal attention and the fastest progression, or a group lesson, for a fun social experience at a lower price. Both start from zero experience.' },
  { question: 'Do you provide the surfboard and all the gear?', answer: 'Yes. Boards and all necessary equipment are included in every lesson and package price, with no rental add-ons. You only need to bring a swimsuit, a towel, sunscreen and water.' },
  { question: 'Where do your Cocoa Beach surf lessons take place?', answer: 'We run lessons at beach access points between Cape Canaveral and South Cocoa Beach, choosing the spot each day based on wave size and wind direction for your level. We confirm the exact meeting point when you book.' },
  { question: 'What can I expect on a regular day at the school?', answer: 'All Cocoa Beach surf lessons follow the same structure: your instructor meets you at the beach with the boards and all equipment, runs a 15-minute safety briefing on the sand, then guides you in the water for the rest of the session.' },
  { question: 'Am I too old to learn to surf?', answer: 'Surfing has no upper age limit. What matters is comfort in the water and reasonable mobility, not age. Our instructors adjust board size, wave selection and session pace to each person, and a private lesson is usually the best fit for adults who prefer to go at their own speed.' },
  { question: 'Can kids take lessons?', answer: 'Absolutely! We welcome kids from age 6. Our instructors are trained to work with young surfers and ensure a safe, fun experience.' },
  { question: 'Do your instructors speak Spanish?', answer: 'Yes. Our coaching team is bilingual in English and Spanish, so you can take your lesson in whichever language you are most comfortable with. That matters most during the ocean safety briefing.' },
  { question: 'What is your cancellation and rescheduling policy?', answer: 'Cancel or reschedule at least 24 hours before your session and there is no charge: full refund or a free reschedule. Inside 24 hours, rescheduling depends on availability and may carry a fee. If we cancel for unsafe ocean or weather conditions, you always get a full refund or a free reschedule.' },
  { question: 'What sets your surf school apart from others?', answer: 'We are a locally-owned school with certified instructors who know Cocoa Beach inside and out. We keep groups small and focus on real progress, not just fun.' },
]

const blogPosts = [
  {
    href: '/blog/is-cocoa-beach-good-for-surfing',
    category: 'Destination',
    title: 'Is Cocoa Beach Good for Surfing? A Local Guide',
    excerpt: 'Wave conditions, best times of year, beginner spots and what to expect, answered by instructors who surf here every day.',
    date: 'May 27, 2026',
    image: blogSeasonImg,
  },
  {
    href: '/blog/beginners-guide-to-surfing',
    category: 'Beginner Info',
    title: "The Complete Beginner's Guide to Surfing",
    excerpt: 'Everything you need before your first surf lesson: the pop-up, the gear, and the five mistakes first-timers make.',
    date: 'May 27, 2026',
    image: blogLessonImg,
  },
]

const serviceLinks = [
  { label: 'Private Surf Lessons', href: '/private-surf-lessons-cocoa-beach' },
  { label: 'Surf Coaching', href: '/surf-coaching-cocoa-beach' },
  { label: 'Group Surf Lessons', href: '/group-surf-lessons-cocoa-beach' },
  { label: 'Surf Packages', href: '/surf-packages-cocoa-beach' },
  { label: 'Kids Surf Lessons', href: '/kids-surf-lessons-cocoa-beach' },
  { label: 'Surf Camp Cocoa Beach', href: '/surf-camp-cocoa-beach' },
  { label: 'Surf Lessons Near Orlando', href: '/surf-lessons-near-orlando' },
  { label: 'Surf School in Cocoa Beach', href: '/best-surf-school-cocoa-beach' },
  { label: 'Weekly Surf Training Schedule', href: '/surf-training-schedule-cocoa-beach' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <FAQSchema slot="head" items={faqs} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Surf Lessons in Cocoa Beach, Florida with Certified Local Instructors"
    subtitle="Florida's original surf town, taught by certified local instructors. Most beginners stand up on their very first lesson."
    image={heroImg}
    imageAlt="Surf lessons Cocoa Beach instructor coaching a student in the ocean"
    cta={{ label: 'Book Now', href: '/book-now' }}
    ctaSecondary={{ label: 'View Surf Lessons', href: '/surf-packages-cocoa-beach' }}
    height="full"
  />

  <!-- ── STATS BAR ──────────────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-gray-100" aria-label="Surf school at a glance">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100">
        {stats.map(s => (
          <div class="py-7 px-4 text-center">
            <p class="font-display text-3xl font-bold mb-0.5" style="color:var(--accent-ink-strong)">{s.value}</p>
            <p class="text-xs text-gray-500 font-medium">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── INTRO 2-COL ───────────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-14 items-center">

        <!-- Staggered gallery -->
        <div class="grid grid-cols-2 gap-3 relative">
          {gallery.map(({ img, alt }, i) => (
            <div class={`overflow-hidden rounded-2xl h-48 ${i % 2 === 1 ? 'mt-8' : ''}`}>
              <Image
                src={img}
                alt={alt}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                widths={[320, 480, 640, 800]}
                quality={88}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 1280px) 300px, (min-width: 768px) calc((100vw - 7.5rem) / 4), calc(50vw - 1rem)"
              />
            </div>
          ))}
          <!-- Floating accent -->
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-[#00BCD4]/10 rounded-full -z-10 blur-xl"/>
        </div>

        <!-- Text -->
        <div>
          <h2 class="font-display text-4xl font-bold text-gray-900 leading-tight mb-5">
            Learn to Surf in Cocoa Beach with Certified, Bilingual Instructors
          </h2>
          <p class="text-gray-600 leading-relaxed mb-5">
            Cocosol Surf Lessons is a local surf school in Cocoa Beach, Florida. We teach first-timers, families, and experienced surfers who want to level up, and we adapt every session to the real ocean conditions that day and to where you are in your learning.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'Bilingual and local: clear instruction whether you are from across the country or across the Atlantic.',
              'Safety-first method: every lesson is built around keeping you confident and in control.',
              'You bring yourself. We bring everything else.',
            ].map(i => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background:var(--accent-tint)">
                  <Icon name="ph:check-bold" class="w-3 h-3" style="color:var(--accent)" aria-hidden="true"/>
                </span>
                {i}
              </li>
            ))}
          </ul>

          <a href="/surf-packages-cocoa-beach" class="btn-primary">View Surf Lessons</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── LESSONS GRID ──────────────────────────────────────────────────────── -->
  <LessonsGrid />

  <!-- ── WHY CHOOSE US ──────────────────────────────────────────────────────── -->
  <WhyChooseUs subtitle="Cocoa Beach is Florida's original surf town and one of the best places on the U.S. East Coast to learn to surf. Gentle, consistent Atlantic waves break over a soft, sandy bottom, giving first-timers the perfect environment to stand up fast and build real confidence. At Cocosol Surf Lessons, we go beyond the basics. Every session is built around safety, technique, and the progression that keeps you coming back for more." />

  <!-- ── PRICING & SURF CAMP ───────────────────────────────────────────────── -->
  <PricingPackages />

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <!-- Quotes trimmed to roughly three lines each. The full reviews live on the
       Google profile; a landing-page quote is a snippet, not the whole review. -->
  <Testimonials bg="white" items={[
    { name: 'Stephanie Smith', role: 'Google Review · First-time surfer', text: 'Best experience on our whole vacation. My instructor was kind and patient, and prepared us fully on land. When we hit the ocean, everyone stood up.' },
    { name: 'Danielle Hodge', role: 'Local Guide · Group booking', text: 'Our non-profit planned a lesson for youth and adults, most of whom had never surfed. They brought boards, set up tents, and gave our group an unforgettable experience.' },
    { name: 'Sheindy Reisz', role: 'Google Review · Surf coaching', text: 'I appreciated the focus on ocean awareness and reading conditions, not just catching waves. He helps you improve while teaching you to become an independent surfer.' },
    { name: 'Ashton Cooke', role: 'Google Review · Parent', text: 'Our daughter has been with CocoSol for a little over a year and has learned so much from Victor and Josh. Victor is a very experienced lifeguard and the comfort level I have is unmatched.' },
  ]}/>

  <!-- ── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50 defer-section">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-5 gap-12 items-start">

        <!-- Left: header -->
        <div class="md:col-span-2">
          <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm lg:sticky lg:top-24">
            <h2 class="font-display text-3xl font-bold text-gray-900 mb-4 leading-snug">
              Everything You Need to Know Before Your First Lesson
            </h2>
            <p class="text-gray-500 text-sm leading-relaxed mb-7">
              These are the most common questions we get from students planning their first surf lesson in Cocoa Beach. Can't find your answer? We reply fast on WhatsApp.
            </p>
            <a href={CONTACT.WHATSAPP_URL}
              class="inline-flex items-center gap-2 px-5 py-3 border-2 border-gray-200 text-gray-700 font-semibold rounded-full hover:border-[var(--accent)] hover:text-[var(--accent-ink)] transition-colors text-sm">
              <Icon name="ph:whatsapp-logo-fill" class="w-4 h-4" aria-hidden="true"/>
              Contact Us on WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: FAQ items -->
        <div class="md:col-span-3">
          <FAQ items={faqs}/>
        </div>

      </div>
    </div>
  </section>

  <!-- ── LATEST BLOG POSTS ────────────────────────────────────────────────────── -->
  <section class="py-16 bg-white border-t border-gray-100 defer-section">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <h2 class="font-display text-3xl font-bold text-gray-900">Surf Tips & Cocoa Beach Guides</h2>
        <a href="/blog" class="shrink-0 inline-flex items-center gap-2 font-semibold text-sm hover:gap-3 transition-all" style="color:var(--accent-ink)">
          All Articles
          <Icon name="ph:caret-right-bold" class="w-4 h-4" aria-hidden="true"/>
        </a>
      </div>
      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {blogPosts.map(post => (
          <a href={post.href} class="group flex flex-col bg-white rounded-3xl overflow-hidden border border-gray-100 hover:border-[#00BCD4]/30 md:hover:shadow-xl transition-all duration-300">
            <div class="overflow-hidden h-48">
              <Image
                src={post.image}
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                widths={[320, 480, 640]}
                quality={72}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 768px) 320px, calc(100vw - 2rem)"
              />
            </div>
            <div class="flex flex-col flex-1 p-6">
              <span
                class="inline-block self-start text-xs font-semibold px-3 py-1 rounded-full mb-3"
                style="background:var(--accent-tint); color:var(--accent-ink-strong)"
              >{post.category}</span>
              <h3 class="font-display text-base font-bold text-gray-900 mb-2 leading-snug group-hover:text-[var(--accent-ink)] transition-colors flex-1">{post.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed mb-4 line-clamp-2">{post.excerpt}</p>
              <p class="text-xs text-gray-600 mt-auto">{post.date}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SEO INTERNAL LINKS ─────────────────────────────────────────────────── -->
  <section class="py-10 bg-gray-50 border-t border-gray-100 defer-section">
    <div class="container mx-auto px-4">
      <h2 class="font-display text-lg font-bold text-gray-900 mb-4">Our Surf Lessons & Packages in Cocoa Beach</h2>
      <div class="flex flex-wrap gap-2 md:gap-2 gap-y-3">
        {serviceLinks.map(l => (
          <a href={l.href}
            class="px-4 py-2 bg-white hover:bg-[#00BCD4]/8 border border-gray-200 hover:border-[#00BCD4]/40 hover:text-[var(--accent-ink)] rounded-full text-sm text-gray-600 transition-colors font-medium">
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
