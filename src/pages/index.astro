---
import { Image, getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import WhyChooseUs from '../components/sections/WhyChooseUs.astro'
import VideoSection from '../components/sections/VideoSection.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import { seoData } from '../lib/seo'

import heroImg from '../assets/images/surf-school-tamarindo-surf-instructor-student.webp'
import gallery1 from '../assets/images/family-surf-lessons-tamarindo.webp'
import gallery2 from '../assets/images/surf-school-tamarindo-students.webp'
import gallery3 from '../assets/images/surf-school-tamarindo-private-class.webp'
import gallery4 from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import privateCard from '../assets/images/surf-school-tamarindo-private-class.webp'
import semiPrivateCard from '../assets/images/surf-school-tamarindo-students.webp'
import groupCard from '../assets/images/family-surf-lessons-tamarindo.webp'
import camp7 from '../assets/images/student-from-our-surf-school-in-Tamarindo.webp'
import camp5 from '../assets/images/surf-school-tamarindo-beginner-lesson.webp'
import videoBg from '../assets/images/student-from-our-surf-school-in-Tamarindo.webp'

const seo = seoData.home

const preloadHero = await getImage({ src: heroImg, format: 'webp', width: 1920 })

const gallery = [
  { img: gallery1, alt: 'Surf school Tamarindo — family surf lesson on the beach' },
  { img: gallery2, alt: 'Group surf lessons Tamarindo Costa Rica' },
  { img: gallery3, alt: 'Surf school Tamarindo — instructor guiding student on a wave' },
  { img: gallery4, alt: 'Surf school Tamarindo — students catching their first waves' },
]

const services = [
  { href: '/private-surf-lessons-tamarindo', title: 'Private Surf Lessons', badge: '1-on-1 coaching', img: privateCard },
  { href: '/semi-private-surf-lessons-tamarindo', title: 'Semi-Private Surf Lessons', badge: 'Up to 3 students', img: semiPrivateCard },
  { href: '/group-surf-lessons-tamarindo', title: 'Group Surf Lessons', badge: 'Up to 6 students', img: groupCard },
]

const camps = [
  { href: '/7-days-surf-camp-tamarindo', title: '7-Day Surf Camp', detail: '6 surf lessons + surf trip from $1,399', img: camp7 },
  { href: '/5-days-surf-camp-tamarindo', title: '5-Day Surf Camp', detail: '4 surf lessons + surf trip from $1,049', img: camp5 },
]

const stats = [
  { value: '500+', label: 'Surfers Trained' },
  { value: '25+', label: 'Countries Represented' },
  { value: '4.9★', label: 'Average Rating' },
  { value: '100%', label: 'ISA Certified' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus}>
  <link slot="head" rel="preload" as="image" href={preloadHero.src} type="image/webp" fetchpriority="high"/>

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <Hero
    title="Surf School in Tamarindo, Costa Rica — Pura Vida Surf School"
    subtitle="Learn to surf with certified instructors in one of Costa Rica's best surf towns."
    image={heroImg}
    imageAlt="Student riding a wave during surf school Tamarindo class"
    cta={{ label: 'Book Now', href: '/book-now' }}
    ctaSecondary={{ label: 'View Surf Lessons', href: '/tamarindo-surf-lessons' }}
    height="full"
  />

  <!-- ── STATS BAR ──────────────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-gray-100 shadow-sm">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100">
        {stats.map(s => (
          <div class="py-7 px-4 text-center">
            <p class="text-3xl font-extrabold text-[#00BCD4] mb-0.5">{s.value}</p>
            <p class="text-xs text-gray-500 font-medium uppercase tracking-wide">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── INTRO 2-COL ───────────────────────────────────────────────────────── -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-14 items-center">

        <!-- Staggered gallery -->
        <div class="grid grid-cols-2 gap-3 relative">
          {gallery.map(({ img, alt }, i) => (
            <div class={`overflow-hidden rounded-2xl shadow-md ${i % 2 === 1 ? 'mt-8' : ''}`}>
              <Image
                src={img}
                alt={alt}
                class="w-full h-48 object-cover hover:scale-105 transition-transform duration-500"
                widths={[200, 400, 800]}
                formats={['avif', 'webp']}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding={i === 0 ? 'sync' : 'async'}
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          ))}
          <!-- Floating accent -->
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-[#00BCD4]/10 rounded-full -z-10 blur-xl"/>
        </div>

        <!-- Text -->
        <div>
          <span class="section-label mb-3 block">Welcome to Pura Vida Surf School</span>
          <h2 class="text-4xl font-extrabold text-gray-900 leading-tight mb-5">
            Surf School In Tamarindo — Learn to Surf at Costa Rica's #1 Surf Town
          </h2>
          <p class="text-gray-600 leading-relaxed mb-5">
            Pura Vida Surf School is the surf school Tamarindo visitors trust most. Located steps from the beach in one of <a href="https://www.visitcostarica.com/en/costa-rica/where-to-go/beaches/tamarindo" target="_blank" rel="noopener noreferrer" class="text-teal-600 underline hover:text-teal-800">Costa Rica's top surf destinations</a>, we combine certified instruction, warm water, and small groups to help you improve technique, build confidence, and fall in love with the ocean — whether it's your very first wave or you're pushing to the next level.
          </p>
          <ul class="space-y-3 mb-8">
            {['Certified surf instructors', 'Small groups and personalized coaching', 'Surfboards and equipment included'].map(i => (
              <li class="flex items-center gap-3 text-gray-700">
                <span class="w-5 h-5 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </span>
                {i}
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap items-center gap-4">
            <a href="/tamarindo-surf-lessons" class="btn-primary">View Surf Lessons Options</a>
            <div class="inline-flex items-center gap-3 bg-[#00BCD4]/8 border border-[#00BCD4]/20 rounded-2xl px-5 py-3">
              <span class="text-3xl font-extrabold text-[#00BCD4]">25+</span>
              <span class="text-gray-600 text-sm leading-snug">Countries represented<br/>by our students</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── SERVICES BANNER ───────────────────────────────────────────────────── -->
  <section class="py-20 bg-[#00BCD4]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <span class="inline-block bg-white/15 text-white text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">
          Best Surf School in Tamarindo
        </span>
        <h2 class="text-4xl font-extrabold text-white">Surf School in Tamarindo for Every Level</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {services.map(c => (
          <a href={c.href} data-astro-prefetch
            class="group relative rounded-3xl overflow-hidden block shadow-lg shadow-black/20 hover:shadow-2xl hover:shadow-black/30 transition-all duration-300 hover:-translate-y-1"
            style="height: 300px;">
            <Image
              src={c.img}
              alt={c.title + ' Tamarindo'}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[300, 600]}
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 768px) 33vw, 100vw"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"/>

            <!-- Badge top -->
            <div class="absolute top-4 left-4">
              <span class="bg-white/20 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1 rounded-full border border-white/30">
                {c.badge}
              </span>
            </div>

            <!-- Content bottom -->
            <div class="absolute bottom-0 inset-x-0 p-6 flex items-end justify-between">
              <h3 class="text-xl font-bold text-white leading-snug">{c.title}</h3>
              <span class="w-9 h-9 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center border border-white/30 group-hover:bg-white group-hover:text-[#00BCD4] transition-colors shrink-0">
                <svg class="w-4 h-4 text-white group-hover:text-[#00BCD4] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHY CHOOSE US ──────────────────────────────────────────────────────── -->
  <WhyChooseUs/>

  <!-- ── VIDEO ─────────────────────────────────────────────────────────────── -->
  <VideoSection
    title="Experience Surfing in Tamarindo"
    subtitle="Watch our students go from nervous beginners to confident surfers in just one session."
    bgImage={videoBg}
    cta={{ label: 'Choose Your Surf Lesson', href: '/tamarindo-surf-lessons' }}
  />

  <!-- ── SURF CAMP ──────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <div>
          <span class="section-label mb-2 block">Our Surf Camp in Tamarindo</span>
          <h2 class="text-3xl font-extrabold text-gray-900">Tamarindo Surf Camp</h2>
          <p class="text-gray-500 mt-2 max-w-xl">
            If you're planning a surf getaway, check our all-inclusive surf camps. Professional instruction, equipment, surf trips, and pura vida vibes included.
          </p>
        </div>
        <a href="/surf-camp-tamarindo"
          class="shrink-0 px-5 py-2.5 border-2 border-gray-300 text-gray-700 font-semibold rounded-2xl hover:border-[#00BCD4] hover:text-[#00BCD4] transition-colors text-sm whitespace-nowrap">
          View All Camps →
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {camps.map(c => (
          <a href={c.href} data-astro-prefetch
            class="group relative rounded-3xl overflow-hidden block shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5"
            style="height: 280px;">
            <Image
              src={c.img}
              alt={c.title + ' Tamarindo'}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[400, 800]}
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
              sizes="(min-width: 768px) 50vw, 100vw"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/85 via-slate-900/20 to-transparent"/>
            <div class="absolute bottom-0 inset-x-0 p-7 flex items-end justify-between">
              <div>
                <h3 class="text-2xl font-extrabold text-white mb-1">{c.title}</h3>
                <p class="text-white/70 text-sm">{c.detail}</p>
              </div>
              <span class="shrink-0 px-4 py-2 bg-white/15 backdrop-blur-sm border border-white/25 text-white text-sm font-bold rounded-2xl group-hover:bg-[#00BCD4] group-hover:border-[#00BCD4] transition-colors whitespace-nowrap">
                Book Now →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <Testimonials bg="white" items={[
    { name: 'Sarah K.', role: 'Traveler', country: 'USA', text: 'The 5-day package was incredible. I went from never surfing to catching green waves by day 4. The surf trip was the highlight of my entire Costa Rica trip!' },
    { name: 'Marco B.', role: 'Surfer', country: 'Italy', text: 'Best investment of my vacation. The instructor was patient, knowledgeable, and pushed me just the right amount. Came back the following year for the 7-day camp!' },
    { name: 'Emily R.', role: 'Traveler', country: 'Canada', text: 'The 7-day package was life-changing. I arrived never having surfed before and left catching green waves on my own. Incredible experience — worth every penny!' },
    { name: 'Alex M.', role: 'Solo Traveler', country: 'Germany', text: 'Came alone and left with new friends and the ability to surf! The group lesson was the best decision I made on my Costa Rica trip. Highly recommend.' },
  ]}/>

  <!-- ── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-5 gap-12 items-start">

        <!-- Left: header -->
        <div class="md:col-span-2">
          <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm sticky top-28">
            <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-3 py-1 rounded-full mb-5 tracking-wider uppercase">FAQ</span>
            <h2 class="text-3xl font-extrabold text-gray-900 mb-4 leading-snug">
              Surf School FAQs — Everything You Need to Know
            </h2>
            <p class="text-gray-500 text-sm leading-relaxed mb-7">
              These are the most common questions we get from students planning their first visit to our surf school in Tamarindo. Can't find your answer? We reply fast on WhatsApp.
            </p>
            <a href="/surf-school-near-me-tamarindo"
              class="inline-flex items-center gap-2 px-5 py-3 border-2 border-gray-200 text-gray-700 font-semibold rounded-2xl hover:border-[#00BCD4] hover:text-[#00BCD4] transition-colors text-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Contact Us on WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: FAQ items -->
        <div class="md:col-span-3">
          <FAQ items={[
            { question: 'Do I need to know how to swim to surf?', answer: 'Basic swimming ability is recommended for safety. Our instructors will assess your comfort level before entering the water.' },
            { question: 'What is the best option to learn surf?', answer: 'For first-timers, we recommend either a private lesson for maximum personal attention, or a group lesson for a fun social experience at a lower price.' },
            { question: 'What can I expect on a regular day at the school?', answer: 'Your instructor will meet you at the beach, provide all equipment, run a 15-minute safety briefing, then guide you in the water for your session.' },
            { question: 'What sets your surf camp apart from others?', answer: 'We are a locally-owned school with certified instructors who know Tamarindo inside and out. We keep groups small and focus on real progress, not just fun.' },
            { question: 'Can kids take lessons?', answer: 'Absolutely! We welcome kids from age 6. Our instructors are trained to work with young surfers and ensure a safe, fun experience.' },
          ]}/>
        </div>

      </div>
    </div>
  </section>

  <!-- ── LATEST NEWS ────────────────────────────────────────────────────────── -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="section-label mb-2 block">Insight</span>
          <h2 class="text-3xl font-extrabold text-gray-900 mb-2">Latest News & Articles</h2>
          <p class="text-gray-500 max-w-lg">Read our blog to keep yourself sharp. Stay informed with our latest updates.</p>
        </div>
        <a href="/blog"
          class="shrink-0 inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-200 text-gray-700 font-semibold rounded-2xl hover:border-[#00BCD4] hover:text-[#00BCD4] transition-colors text-sm">
          All Articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── SEO INTERNAL LINKS ─────────────────────────────────────────────────── -->
  <section class="py-10 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <h2 class="text-sm font-bold text-gray-500 mb-4 uppercase tracking-widest">Our Surf Lessons & Packages in Tamarindo</h2>
      <div class="flex flex-wrap gap-2">
        {[
          { label: 'Private Surf Lessons', href: '/private-surf-lessons-tamarindo' },
          { label: 'Semi-Private Surf Lessons', href: '/semi-private-surf-lessons-tamarindo' },
          { label: 'Group Surf Lessons', href: '/group-surf-lessons-tamarindo' },
          { label: 'Surf Packages Tamarindo', href: '/tamarindo-surf-packages' },
          { label: '3 Days Surf Package', href: '/3-days-pura-vida-surf-package' },
          { label: '5 Days Surf Package', href: '/5-days-pura-vida-surf-package' },
          { label: 'Surf Camp Tamarindo', href: '/surf-camp-tamarindo' },
          { label: '7 Days Surf Camp', href: '/7-days-surf-camp-tamarindo' },
          { label: '5 Days Surf Camp', href: '/5-days-surf-camp-tamarindo' },
        ].map(l => (
          <a href={l.href} data-astro-prefetch="viewport"
            class="px-4 py-2 bg-white hover:bg-[#00BCD4]/8 border border-gray-200 hover:border-[#00BCD4]/40 hover:text-[#00BCD4] rounded-full text-sm text-gray-600 transition-colors font-medium">
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
