---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData } from '../lib/seo'

const seo = seoData.aboutUs
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <BreadcrumbSchema slot="head" items={[
    { name: 'Home', href: '/' },
    { name: 'About Cocosol', href: '/best-surf-school-cocoa-beach' },
  ]} />

  <!-- HERO -->
  <section class="ab-hero">
    <div class="ab-sun" aria-hidden="true"></div>
    <div class="ab-hero-inner">
      <span class="ab-eyebrow">Our Story</span>
      <h1>More than a <em>surf school</em></h1>
      <p class="ab-lede">A family-run surf school in Cocoa Beach, founded by a lifelong Costa Rican surfer and lifeguard — built on real safety, real progression, and a love for the ocean.</p>
    </div>
    <div class="ab-waves" aria-hidden="true">
      <svg viewBox="0 0 1440 90" preserveAspectRatio="none"><path fill="#FBF5EB" d="M0 50c200 36 380-8 600-12 240-4 420 36 640 30 80-2 160-14 200-22v66H0z"/></svg>
    </div>
  </section>

  <!-- FOUNDER STORY -->
  <section class="ab-section ab-story-section">
    <div class="ab-wrap ab-story-grid">

      <div class="ab-portrait ab-reveal" aria-hidden="true">
        <span class="ab-pflag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
          Costa Rica · Cocoa Beach
        </span>
        <div class="ab-pcaption">
          <div class="ab-pname">Victor Nuñez</div>
          <div class="ab-prole">Founder & Head Instructor</div>
        </div>
      </div>

      <div class="ab-story-text ab-reveal">
        <span class="ab-eyebrow">Meet the founder</span>
        <h2>From a boy with a board in Costa Rica to founding Cocosol Surf Lessons</h2>
        <p class="ab-lead-p">Cocosol Surf Lessons was founded by Victor Nuñez — a lifelong surfer and trained lifeguard whose passion for the ocean started on the beaches of Costa Rica.</p>
        <p>Victor's journey began at fifteen, when he started lifeguarding and surfing on Costa Rica's Pacific coast. Over 25+ years in the water, he built up the one thing you can't shortcut in this sport: a deep, instinctive read of the ocean and a relentless focus on safety.</p>
        <p>In 2022 he brought that experience to Florida's Space Coast and founded Cocosol Surf Lessons — a school built around two simple ideas: nobody should ever feel unsafe in the water, and everybody, from a three-year-old to a grandparent, deserves the chance to feel the joy of standing up on their first wave.</p>
        <p>Today Victor and his team teach kids and adults of all levels at the beach breaks of Cocoa Beach and Cape Canaveral.</p>
        <div class="ab-signature">Pura vida, from Cocoa Beach.</div>
        <div class="ab-story-stats">
          <div><div class="ab-sst">25+</div><div class="ab-sstl">Years in the water</div></div>
          <div><div class="ab-sst">2022</div><div class="ab-sstl">School founded</div></div>
          <div><div class="ab-sst">Age 3+</div><div class="ab-sstl">Kids welcome from</div></div>
        </div>
      </div>

    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="ab-section ab-philosophy">
    <div class="ab-phil-inner ab-reveal">
      <span class="ab-phil-mark" aria-hidden="true">"</span>
      <h2>We're more than a surf school — we're <em>stewards of the ocean</em> and champions for our Cocoa Beach community.</h2>
      <p>That's not a slogan. It's why we cap our groups, train our instructors as lifeguards, and treat every first wave like it matters — because it does.</p>
    </div>
  </section>

  <!-- SAFETY -->
  <section class="ab-section ab-safety-section">
    <div class="ab-wrap">
      <div class="ab-section-head ab-center ab-reveal">
        <span class="ab-eyebrow">Safety First, Always</span>
        <h2>How we keep the water safe</h2>
        <p>Safety isn't a checklist for us — it's how the school was built. Here's what that looks like in practice.</p>
      </div>
      <div class="ab-safety-grid">

        <div class="ab-sf ab-reveal">
          <span class="ab-num">01</span>
          <div class="ab-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12c4 0 4-3 8-3s4 3 8 3 4-3 4-3M2 17c4 0 4-3 8-3s4 3 8 3 4-3 4-3"/></svg>
          </div>
          <h3>Ocean awareness</h3>
          <p>Every lesson starts with the basics that experienced surfers take for granted: how to read rip currents, wave patterns, and the day's specific conditions before you ever paddle out.</p>
        </div>

        <div class="ab-sf ab-reveal">
          <span class="ab-num">02</span>
          <div class="ab-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2L4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/></svg>
          </div>
          <h3>Lifeguard-trained instructors</h3>
          <p>Our instructors are certified in lifeguard training, water rescue, CPR, and first aid. They're not just surfers — they're the people you'd want next to you if anything went wrong.</p>
        </div>

        <div class="ab-sf ab-reveal">
          <span class="ab-num">03</span>
          <div class="ab-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <h3>Professional equipment</h3>
          <p>Every board, leash, and rash guard we use is selected for safety first and maintained constantly. Beginners get the right board for their size and level — not whatever's free.</p>
        </div>

        <div class="ab-sf ab-reveal">
          <span class="ab-num">04</span>
          <div class="ab-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2l9 4v6c0 5-4 9-9 10-5-1-9-5-9-10V6l9-4z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3>Emergency procedures</h3>
          <p>Clear communication protocols, direct lines to local emergency services, and a team that has rehearsed exactly what to do if a situation calls for it. We hope to never use them. We're ready if we do.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- INSTRUCTORS -->
  <section class="ab-section ab-inst-section">
    <div class="ab-wrap">
      <div class="ab-section-head ab-center ab-reveal">
        <span class="ab-eyebrow">The Experts</span>
        <h2>Meet your instructors</h2>
        <p>The team behind every lesson — local, trained, and genuinely good at teaching people who've never touched a board.</p>
      </div>
      <div class="ab-inst-grid">

        <article class="ab-inst ab-inst--lead ab-reveal">
          <div class="ab-avatar ab-av">VN</div>
          <h3>Victor Nuñez</h3>
          <div class="ab-role">Founder & Head Instructor</div>
          <p>Costa Rican by birth, lifeguard since fifteen, surf instructor for over two decades. The one who started it all.</p>
        </article>

        <article class="ab-inst ab-reveal">
          <div class="ab-avatar ab-an">ND</div>
          <h3>Noah Doving</h3>
          <div class="ab-role">Surf Instructor</div>
          <p>Cocoa Beach local, patient with beginners, sharp coach for surfers ready to level up.</p>
        </article>

        <article class="ab-inst ab-reveal">
          <div class="ab-avatar ab-ak">KK</div>
          <h3>Kyler Krueger</h3>
          <div class="ab-role">Surf Instructor</div>
          <p>Known for getting first-time surfers to stand up in their very first session.</p>
        </article>

        <article class="ab-inst ab-reveal">
          <div class="ab-avatar ab-at">TC</div>
          <h3>Tyden Cheatham</h3>
          <div class="ab-role">Surf Instructor</div>
          <p>Great with kids and family groups — calm, encouraging, safety-focused.</p>
        </article>

        <article class="ab-inst ab-reveal">
          <div class="ab-avatar ab-aa">AP</div>
          <h3>Ahnika Patten</h3>
          <div class="ab-role">Surf Instructor</div>
          <p>Brings a focused, technical eye to coaching and intermediate progression.</p>
        </article>

        <article class="ab-inst ab-reveal">
          <div class="ab-avatar ab-atw">TW</div>
          <h3>Trey Wical</h3>
          <div class="ab-role">Surf Instructor</div>
          <p>Strong on wave reading and positioning — a favorite for surfers chasing the next level.</p>
        </article>

      </div>
    </div>
  </section>

  <!-- COSTA RICA -->
  <section class="ab-section ab-cr">
    <div class="ab-wrap ab-cr-grid">

      <div class="ab-reveal">
        <span class="ab-eyebrow ab-eyebrow--gold">A Bonus for Adventurers</span>
        <h2 class="ab-cr-h2">Surf Costa Rica with Victor — <em>private trips</em> to his home country</h2>
        <p>For students who want something deeper than a single lesson on Cocoa Beach, Victor opens his home country to a small number of guests each year.</p>
        <p>You'll surf the breaks he learned on, eat where the locals eat, and get the kind of insider experience you can't book online. It's the trip he'd take with friends — because that's what you become.</p>
        <a class="ab-btn ab-btn-primary" href="https://wa.me/13213869993">
          Ask About a Costa Rica Trip
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="ab-cr-card ab-reveal">
        <h3>What's included</h3>
        <ul class="ab-cr-feat">
          {[
            'Hand-picked surf spots for your level',
            'Local insights you won\'t find on TripAdvisor',
            'Small-group, fully personalized itinerary',
            'Coaching every step of the way from Victor',
            'A real, immersive Costa Rica experience',
          ].map(item => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="ab-section ab-final">
    <div class="ab-wrap ab-reveal" style="text-align:center">
      <span class="ab-eyebrow ab-eyebrow--gold">Ready to Get in the Water?</span>
      <h2 class="ab-final-h2">Start your journey with us</h2>
      <p class="ab-final-lede">Pick a lesson, a package, or a summer camp — and we'll meet you on the beach with everything ready.</p>
      <div class="ab-final-cta">
        <a class="ab-btn ab-btn-primary" href="/surf-packages-cocoa-beach">
          Explore Our Lessons
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="ab-btn ab-btn-ghost" href="/book-now">Book a Lesson</a>
      </div>
      <div class="ab-nap">
        <a href="tel:+13213869993">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          +1 (321) 386-9993
        </a>
        <a href="mailto:info@cocosolsurf.com">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 6l10 7L22 6"/></svg>
          info@cocosolsurf.com
        </a>
        <span>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          Open 7 days · 9 AM–5 PM
        </span>
        <span>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4.5 8-11a8 8 0 1 0-16 0c0 6.5 8 11 8 11z"/><circle cx="12" cy="11" r="3"/></svg>
          Cocoa Beach & Cape Canaveral, FL
        </span>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Tokens ────────────────────────────────────────────── */
  :root {
    --ab-deep:   #082F3C;
    --ab-ocean:  #0E6374;
    --ab-mid:    #14808F;
    --ab-light:  #5FB6C4;
    --ab-sand:   #FBF5EB;
    --ab-soft:   #F4EADA;
    --ab-line:   #E7D9C4;
    --ab-coral:  #E2553A;
    --ab-dark:   #C7462C;
    --ab-gold:   #E9A53F;
    --ab-ink:    #13313B;
    --ab-muted:  #566970;
    --ab-shadow: 0 18px 50px -18px rgba(8,47,60,.28);
    --ab-radius: 18px;
    --ab-maxw:   1180px;
  }

  /* ── Base ──────────────────────────────────────────────── */
  .ab-section { padding: clamp(56px,8vw,100px) 0; }
  .ab-wrap    { max-width: var(--ab-maxw); margin: 0 auto; padding: 0 24px; }
  .ab-center  { text-align: center; }

  .ab-eyebrow {
    font-weight: 700;
    font-size: .78rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ab-mid);
    display: inline-block;
    margin-bottom: 14px;
  }
  .ab-eyebrow--gold { color: #ffd9a0; }

  .ab-section-head { max-width: 680px; margin-bottom: 42px; }
  .ab-section-head.ab-center { margin-inline: auto; }
  .ab-section-head p { font-size: 1.07rem; margin-top: 14px; color: var(--ab-muted); }

  h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -.01em;
    color: var(--ab-ink);
    margin-bottom: 16px;
  }
  h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ab-ink);
    margin-bottom: 10px;
  }

  /* ── Buttons ───────────────────────────────────────────── */
  .ab-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    padding: 15px 28px;
    border-radius: 999px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: transform .2s, box-shadow .2s, background .2s;
    min-height: 48px;
    text-decoration: none;
    line-height: 1;
  }
  .ab-btn-primary {
    background: var(--ab-coral);
    color: #fff;
    box-shadow: 0 10px 24px -8px rgba(226,85,58,.55);
  }
  .ab-btn-primary:hover { background: var(--ab-dark); transform: translateY(-2px); }
  .ab-btn-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255,255,255,.55);
  }
  .ab-btn-ghost:hover { background: rgba(255,255,255,.12); transform: translateY(-2px); }

  /* ── Hero ──────────────────────────────────────────────── */
  .ab-hero {
    position: relative;
    background: radial-gradient(120% 90% at 70% 8%, #1a8597 0%, var(--ab-ocean) 32%, var(--ab-deep) 78%);
    color: #fff;
    text-align: center;
    overflow: hidden;
    padding: clamp(80px,11vw,130px) 24px clamp(90px,12vw,150px);
  }
  .ab-sun {
    position: absolute;
    top: -90px;
    right: 8%;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(233,165,63,.5), rgba(233,165,63,0) 62%);
    pointer-events: none;
  }
  .ab-hero-inner {
    position: relative;
    z-index: 3;
    max-width: 780px;
    margin: 0 auto;
  }
  .ab-hero-inner h1 {
    color: #fff;
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2.3rem, 5.4vw, 3.9rem);
    font-weight: 600;
    letter-spacing: -.02em;
    margin-bottom: 22px;
  }
  .ab-hero-inner h1 em { font-style: italic; color: #ffd9a0; font-weight: 500; }
  .ab-hero-inner .ab-eyebrow { color: #ffd9a0; }
  .ab-lede {
    font-size: clamp(1.05rem,2vw,1.22rem);
    color: rgba(255,255,255,.92);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.65;
  }
  .ab-waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    line-height: 0;
    z-index: 2;
  }
  .ab-waves svg { width: 100%; height: auto; display: block; }

  /* ── Founder Story ─────────────────────────────────────── */
  .ab-story-section { background: var(--ab-sand); }
  .ab-story-grid {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: 60px;
    align-items: center;
  }
  .ab-portrait {
    position: relative;
    border-radius: 26px;
    overflow: hidden;
    aspect-ratio: 4/5;
    background: linear-gradient(165deg, #1a8597 0%, var(--ab-ocean) 40%, var(--ab-deep) 100%);
    display: flex;
    align-items: flex-end;
    padding: 34px;
    color: #fff;
    box-shadow: var(--ab-shadow);
  }
  .ab-portrait::before {
    content: "";
    position: absolute;
    top: 0;
    right: -30px;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(233,165,63,.65), rgba(233,165,63,0) 60%);
    pointer-events: none;
  }
  .ab-portrait::after {
    content: "VN";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -58%);
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 7rem;
    color: rgba(255,255,255,.14);
    letter-spacing: -.05em;
    z-index: 1;
  }
  .ab-pcaption { position: relative; z-index: 2; }
  .ab-pname {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 4px;
  }
  .ab-prole {
    font-size: .85rem;
    color: #ffd9a0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .ab-pflag {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: .78rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: .06em;
    text-transform: uppercase;
    background: rgba(0,0,0,.22);
    backdrop-filter: blur(8px);
    padding: 7px 12px;
    border-radius: 999px;
  }
  .ab-pflag svg { color: #ffd9a0; flex-shrink: 0; }

  .ab-story-text p {
    font-size: 1.06rem;
    margin-bottom: 18px;
    color: var(--ab-ink);
    line-height: 1.7;
  }
  .ab-story-text .ab-lead-p {
    font-size: 1.18rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .ab-signature {
    margin-top: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    color: var(--ab-mid);
    font-size: 1.08rem;
  }
  .ab-signature::before {
    content: "";
    width: 32px;
    height: 1px;
    background: var(--ab-light);
    flex-shrink: 0;
  }
  .ab-story-stats {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 18px;
    margin-top: 34px;
    padding-top: 30px;
    border-top: 1px solid var(--ab-line);
  }
  .ab-sst {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 2rem;
    color: var(--ab-deep);
    line-height: 1;
  }
  .ab-sstl {
    font-size: .85rem;
    color: var(--ab-muted);
    font-weight: 600;
    margin-top: 6px;
    letter-spacing: .02em;
  }

  /* ── Philosophy ────────────────────────────────────────── */
  .ab-philosophy {
    background: var(--ab-deep);
    color: #fff;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .ab-philosophy::before, .ab-philosophy::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(95,182,196,.18), rgba(95,182,196,0) 60%);
    pointer-events: none;
  }
  .ab-philosophy::before { left: -100px; transform: translateY(-50%); }
  .ab-philosophy::after  { right: -100px; transform: translateY(-50%); }
  .ab-phil-inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ab-phil-mark {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 5rem;
    color: #ffd9a0;
    line-height: .6;
    display: block;
    margin-bottom: 18px;
  }
  .ab-philosophy h2 {
    color: #fff;
    font-style: italic;
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 500;
