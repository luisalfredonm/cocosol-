---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/ui/Hero.astro'
import HeroPreload from '../components/ui/HeroPreload.astro'
import Sidebar from '../components/ui/Sidebar.astro'
import VideoSection from '../components/sections/VideoSection.astro'
import Testimonials from '../components/sections/Testimonials.astro'
import NeedHelp from '../components/sections/NeedHelp.astro'
import FAQ from '../components/ui/FAQ.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import WhyChooseUs from '../components/sections/WhyChooseUs.astro'
import BookingWizard from '../components/booking/BookingWizard'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import ProductSchema from '../components/seo/ProductSchema.astro'
import { seoData } from '../lib/seo'

import heroImg  from '../assets/images/group-surf-lessons-tamarindo-students-beach.webp'
import gallery1 from '../assets/images/surf-group-lessons-tamarindo-warm-water.webp'
import gallery2 from '../assets/images/group-surf-classes-tamarindo-beginners.webp'
import gallery3 from '../assets/images/surf-lessons-for-groups-tamarindo-morning.webp'
import gallery4 from '../assets/images/beginner-group-surf-lessons-tamarindo-wave.webp'
import videoBg  from '../assets/images/beginner-surf-lessons-tamarindo-group-session.webp'

const seo = seoData.groupLessons

const faqs = [
  { question: 'How big are the group surf lessons?', answer: 'We keep groups small â€” maximum 6 students per certified instructor â€” to ensure everyone gets proper attention and feedback.' },
  { question: 'Are group lessons good for beginners?', answer: 'Yes! Group lessons are designed for beginners. The shared experience is motivating and the friendly competition helps everyone progress faster.' },
  { question: 'Can my family all join the same group lesson?', answer: 'Absolutely! Families are welcome. We can accommodate mixed skill levels and age groups in the same session.' },
  { question: "What if I'm more advanced than the rest of the group?", answer: "If you're looking for more intensive coaching, we'd recommend our semi-private or private lessons for a more personalized experience." },
]

const cols = [
  { h: 'Who Can Take?',  items: ['Solo travelers', 'Couples', 'Friends groups', 'Beginners', 'Kids & families', 'Anyone wanting to learn'] },
  { h: "What's Included", items: ['90-minute surf lesson', 'Professional certified instructor', 'Foam guard', 'Safety briefing', 'Surfboard included', 'Photos on request'] },
  { h: 'Perfect For:',   items: ['First-time surfers', 'Budget-conscious travelers', 'Social experience seekers', 'Groups of 4â€“6 people'] },
]

const gallery = [
  { img: gallery1, alt: 'Surf group lessons Tamarindo in warm clear Costa Rica water' },
  { img: gallery2, alt: 'Group surf classes Tamarindo beginners learning pop-up technique' },
  { img: gallery3, alt: 'Surf lessons for groups Tamarindo â€” morning session on beach' },
  { img: gallery4, alt: 'Beginner group surf lessons Tamarindo catching first waves' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms}>
  <HeroPreload slot="head" src={heroImg} />
  <BreadcrumbSchema slot="head" items={[{name:'Home',href:'/'},{name:'Surf Lessons',href:'/tamarindo-surf-lessons'},{name:'Group Surf Lessons',href:'/group-surf-lessons-tamarindo'}]} />
  <ProductSchema slot="head" name="Group Surf Lesson Tamarindo" description="Group surf lesson in Tamarindo, Costa Rica. Fun, social, and affordable surf classes for beginners led by certified instructors." price="50" url="/group-surf-lessons-tamarindo" image="/images/group-surf-lessons-tamarindo-students-beach.webp" />
  <FAQSchema slot="head" items={faqs} />

  <!-- â”€â”€ HERO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <Hero
    title="Group Surf Lessons in Tamarindo | Learn to Surf Together"
    subtitle="Fun, affordable, and social. Our group surf lessons are perfect for friends, families, and solo travelers who want to share the stoke."
    image={heroImg}
    imageAlt="Group surf lessons Tamarindo â€” students lining up with boards"
    breadcrumb={{ label: 'Surf Lessons', href: '/tamarindo-surf-lessons' }}
    cta={{ label: 'Check Availability', href: '#book' }}
    height="large"
  />

  <!-- â”€â”€ MAIN CONTENT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <section class="py-20 container mx-auto px-4">
    <div class="grid lg:grid-cols-3 gap-12">

      <!-- Left col -->
      <div class="lg:col-span-2">

        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-5 tracking-wider uppercase">Up to 4 Students</span>
        <h2 class="text-3xl font-extrabold text-gray-900 mb-4">Group Surf Lessons in Tamarindo â€” Learn to Surf Together</h2>
        <p class="text-gray-700 leading-relaxed mb-4">Our <strong>group surf lessons in Tamarindo</strong> are the most popular and affordable way to learn to surf. With small groups of 4 students per certified instructor, you'll receive quality coaching while enjoying the energy of learning alongside other surfers. Taught in small groups to guarantee personalized attention, fast learning, and maximum safety.</p>
        <p class="text-gray-700 leading-relaxed mb-8">Whether you're a solo traveler looking for new friends, a couple, a family, or a group of friends, this shared format creates a fun, supportive environment where everyone encourages each other and catches their first wave.</p>

        <!-- Why group lessons work -->
        <div class="bg-[#00BCD4]/5 border border-[#00BCD4]/20 rounded-2xl px-6 py-4 mb-8">
          <p class="text-gray-700 text-sm leading-relaxed"><strong>Why group lessons work:</strong> Learning alongside others has a unique advantage â€” you get to watch fellow students make and correct the same mistakes you face, which helps you understand surfing mechanics faster. The friendly energy in the group keeps motivation high and makes the whole session more enjoyable. Our instructors are experienced at managing 4 students simultaneously, giving each person corrections after every wave. Sessions are scheduled around the best morning tide windows, so you always surf in the cleanest and safest conditions available on the beach.</p>
        </div>

        <!-- 3-col cards -->
        <div class="grid md:grid-cols-3 gap-4 mb-8">
          {cols.map(col => (
            <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100">
              <h3 class="font-bold text-gray-900 mb-4 text-sm uppercase tracking-wide">{col.h}</h3>
              <ul class="space-y-2">
                {col.items.map(i => (
                  <li class="flex items-center gap-2.5 text-sm text-gray-600">
                    <span class="w-4 h-4 rounded-full bg-[#00BCD4]/15 flex items-center justify-center shrink-0">
                      <svg class="w-2.5 h-2.5 text-[#00BCD4]" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    {i}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Gallery -->
        <div class="grid grid-cols-2 gap-3 mb-10">
          {gallery.map(({ img, alt }, i) => (
            <div class={`overflow-hidden rounded-2xl shadow-sm h-56 ${i % 2 === 1 ? 'mt-4' : ''}`}>
              <Image
                src={img}
                alt={alt}
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
                widths={[200, 400]}
                formats={['avif', 'webp']}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 768px) 25vw, 50vw"
              />
            </div>
          ))}
        </div>

        <!-- FAQ -->
        <div class="border-t border-gray-100 pt-10">
          <FAQ items={faqs} columns={1}/>
        </div>

      </div>

      <!-- Right col: Sidebar -->
      <div>
        <Sidebar
          price="$50"
          priceLabel="/ Per Person"
          includes={['90-minute surf lesson', 'Professional certified instructor', 'Surfboard included', 'Foam guard', 'Safety briefing', 'Photos on request']}
          ctaLabel="Check Availability"
          ctaHref="#book"
        />
      </div>

    </div>
  </section>

  <!-- â”€â”€ WHY CHOOSE US â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <WhyChooseUs bg="gray" title="Why Pura Vida Surf School Is Tamarindo's First Choice"/>

  <!-- â”€â”€ VIDEO SECTION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <VideoSection
    title="Watch a Shared Surf Session at Tamarindo Beach"
    subtitle="Our group lessons are fun, energetic, and led by certified instructors who make sure every person in the group catches waves."
    bgImage={videoBg}
    bgImageAlt="Beginner surf lessons Tamarindo group session with instructor"
    cta={{ label: 'Book Your Group Lesson', href: '#book' }}
  />

  <!-- â”€â”€ BOOKING WIZARD â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <section id="book" class="py-16 bg-white min-h-[800px]" style="scroll-margin-top: 96px;">
    <div class="container mx-auto px-4">
      <div class="text-center mb-10">
        <span class="inline-block bg-[#00BCD4]/10 text-[#00BCD4] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-wider uppercase">Ready to Ride?</span>
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Book Your Group Lesson</h2>
        <p class="text-gray-500 max-w-md mx-auto">Select your date and time below. Your group lesson is pre-selected â€” just pick when you want to surf.</p>
      </div>
      <div class="max-w-4xl mx-auto">
        <BookingWizard preselectedType="group" client:idle />
      </div>
      <p class="text-center mt-4 text-sm text-gray-400">Secure payments Â· Trusted instructors Â· Flexible rescheduling</p>
    </div>
  </section>

  <!-- â”€â”€ TESTIMONIALS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <Testimonials items={[
    { name: 'Alex Martinez',       role: 'Solo Traveler', text: 'Came alone, left with new friends and the ability to surf! The group lesson was the best decision I made on my Costa Rica trip. Highly recommend.' },
    { name: 'The Thompson Family', role: 'Family of 4',   text: 'All four of us did the group lesson together â€” from 10-year-old to dad. The instructor made it work for everyone. We all stood up on the board!' },
  ]} title="What Students Say About Learning to Surf Together"/>

  <!-- â”€â”€ NEED HELP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <NeedHelp/>

  <!-- â”€â”€ SEO INTERNAL LINKS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
  <section class="py-10 bg-gray-50 border-t border-gray-100">
    <div class="container mx-auto px-4">
      <h2 class="text-sm font-bold text-gray-500 mb-4 uppercase tracking-widest">Also Available at Pura Vida Surf School</h2>
      <div class="flex flex-wrap gap-2">
        {[
          { l: 'Private Surf Lessons Tamarindo',      h: '/private-surf-lessons-tamarindo' },
          { l: 'Semi-Private Surf Lessons Tamarindo', h: '/semi-private-surf-lessons-tamarindo' },
          { l: 'Surf Packages Tamarindo',             h: '/tamarindo-surf-packages' },
          { l: 'Surf Camp Tamarindo',                 h: '/surf-camp-tamarindo' },
        ].map(x => (
          <a href={x.h} data-astro-prefetch="viewport"
            class="px-4 py-2 bg-white hover:bg-[#00BCD4]/8 border border-gray-200 hover:border-[#00BCD4]/40 hover:text-[#00BCD4] rounded-full text-sm text-gray-600 transition-colors font-medium">
            {x.l}
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
