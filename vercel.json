{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/:path((?!contact-token).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api|_astro|images|admin).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/about",
      "destination": "/best-surf-school-cocoa-beach",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/best-surf-school-cocoa-beach",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/surf-lessons",
      "destination": "/surf-packages-cocoa-beach",
      "permanent": true
    },
    {
      "source": "/surf-camp",
      "destination": "/surf-camp-cocoa-beach",
      "permanent": true
    },
    {
      "source": "/packages",
      "destination": "/surf-packages-cocoa-beach",
      "permanent": true
    },
    {
      "source": "/private-surf-lessons",
      "destination": "/private-surf-lessons-cocoa-beach",
      "permanent": true
    },
    {
      "source": "/group-surf-lessons",
      "destination": "/group-surf-lessons-cocoa-beach",
      "permanent": true
    }
  ]
}
