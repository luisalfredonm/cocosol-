# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Métodos de pago: on-site (pago en persona), paypal, credomatic (pendiente API)
# PayPal y Credomatic se configuran en el panel admin (/admin) vía Supabase

# Resend (email) — https://resend.com/api-keys
RESEND_API_KEY=re_...
# FROM must be on a domain VERIFIED in Resend (no real mailbox needed to send).
# A Gmail does NOT work here — Resend rejects unverified senders.
FROM_EMAIL=reservaciones@cocosolsurf.com
# Where customer replies land (optional; defaults to ADMIN_EMAIL). A Gmail is fine.
REPLY_TO_EMAIL=reservacioncocosol@gmail.com
EMAIL_SUMMARY_ENABLED=true
EMAIL_ADMIN_SUMMARY_ENABLED=true
EMAIL_INDIVIDUAL_ENABLED=false

# Admin panel — booking alerts land here (a Gmail is fine; it's only a recipient)
ADMIN_EMAIL=reservacioncocosol@gmail.com
ADMIN_PASSWORD=change-this-password
